;;;1756       }
;;;1757       if (w == 0 || h == 0)
;;;1758       {
;;;1759           return DCI_ERROR_INVALID_PARAM;
;;;1760       }
;;;1761   
;;;1762       /* spec 2.6: the captured pclk count must be a multiple of 4, which is what
;;;1763        * keeps a line a whole number of words (4 pclk = 1 word at 8-bit, 2 words at
;;;1764        * 10-bit). Align down and say so rather than failing. */
;;;1765       if ((w & 0x3U) != 0)
;;;1766       {
;;;1767           DCI_LOG("[DCI] crop width %u pclk aligned down to %u", w, w & ~0x3U);
;;;1768           w = (uint16_t)(w & ~0x3U);
;;;1769           if (w == 0)
;;;1770           {
;;;1771               return DCI_ERROR_INVALID_PARAM;
;;;1772           }
;;;1773       }
;;;1774   
;;;1775       c.x0 = x0;
;;;1776       c.y0 = y0;
;;;1777       c.w  = w;
;;;1778       c.h  = h;
;;;1779       return dci_reconfig_core(NULL, NULL, &c);
;;;1780   }
;;;1781   
;;;1782   /* Turning crop on or off changes frame_bytes, so it is a full sequence and can
;;;1783    * fail - not a single bit write. */
