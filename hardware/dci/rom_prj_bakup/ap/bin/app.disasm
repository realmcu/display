;;;24     /*============================================================================*
;;;25      *                         Arena
;;;26      *============================================================================*/
;;;27     #define DEMO_GUARD_WORDS        4
;;;28     #define DEMO_POOL_WORDS         ((DCI_DEMO_POOL_KB * 1024UL) / 4)
;;;29     
;;;30     /*
;;;31      * uint32_t so the arena is word aligned, which is the driver's only hard requirement
;;;32      * on a framebuffer (DESIGN.md 10.4).
;;;33      *
;;;34      * DCI_DEMO_SECTION lets the integrator move this out of the default RW section - on
;;;35      * a part where 256 KB will not fit there, point it at SRAM or PSRAM.
;;;36      */
;;;37     #ifndef DCI_DEMO_SECTION
;;;38     #define DCI_DEMO_SECTION
;;;39     #endif
;;;40     
;;;41     DCI_DEMO_SECTION static uint32_t demo_pool[DEMO_POOL_WORDS];
;;;42     
