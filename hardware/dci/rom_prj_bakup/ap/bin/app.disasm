;;;340        /* spec 2.9 caps non-JPEG frames at 2048x2048. The driver cannot convert pclk
;;;341         * to pixels - that ratio is a property of the pixel format, which DCI never
;;;342         * sees - so bound the pclk count by the loosest legal case (2 pclk/pixel). */
;;;343        if (!init->jpeg)
