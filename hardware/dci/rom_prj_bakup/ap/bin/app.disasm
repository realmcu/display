;;;1932   
;;;1933       *reg = 0;
;;;1934   }
;;;1935   
;;;1936   /*
;;;1937    * Liveness: a gated clock, a wrong base or a dead bus returns the *same* value no
;;;1938    * matter what is written - typically all-0 or all-1. So the question is whether the
;;;1939    * read-back varies, not whether it equals some particular value.
;;;1940    *
;;;1941    * Checking for a specific constant would be wrong: ESCR and ESUR are fully writable
;;;1942    * 32-bit registers, so an all-ones read-back is a legitimate result there.
;;;1943    *
;;;1944    * Uses CR, whose writable mask has both set and clear bits, so 0 and rw_mask must
;;;1945    * read back differently on any working block.
;;;1946    */
;;;1947   static bool dci_regtest_alive(uint32_t *lo, uint32_t *hi)
;;;1948   {
