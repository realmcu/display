;;;1154       if (dci.state == DCI_STATE_RESET)
;;;1155       {
;;;1156           return DCI_ERROR_NOT_INIT;
;;;1157       }
;;;1158       if (dci.state == DCI_STATE_BUSY || dci.state == DCI_STATE_SUSPENDED)
;;;1159       {
;;;1160           return DCI_ERROR_STATE;
;;;1161       }
