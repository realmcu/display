;;;671    
;;;672        if ((dci.buf_lock_mask & BIT(k)) != 0)
;;;673        {
;;;674            /* Only reachable under OVERWRITE: delivered before, never collected. The
;;;675             * consumer sees it as a gap in seq. */
;;;676            dci.stats.frames_dropped++;
;;;677        }
;;;678        dci.buf_lock_mask |= (uint8_t)BIT(k);
;;;679    
;;;680        dci.stats.seq++;
;;;681        dci.stats.frames_done++;
;;;682        dci.last_bytes = bytes;
;;;683    
;;;684        f->addr      = (uint8_t *)dci.dma.buf[k];
;;;685        f->bytes     = bytes;
;;;686        f->index     = k;
;;;687        f->seq       = dci.stats.seq;
;;;688        f->truncated = truncated;
;;;689    
;;;690        if (dci.dma.notify_mode == DCI_NOTIFY_POLL)
;;;691        {
;;;692            /* The ring makes completion order a fixed rotation, so the queue is just
;;;693             * a head and a count (DESIGN.md 11.3). */
;;;694            if (dci.ready_count == 0)
;;;695            {
;;;696                dci.ready_head  = k;
;;;697                dci.ready_count = 1;
;;;698            }
;;;699            else if (dci.ready_count < dci.dma.buf_count)
;;;700            {
;;;701                dci.ready_count++;
;;;702            }
;;;703            else
;;;704            {
;;;705                /* Full: the oldest entry is the one being overwritten. */
;;;706                dci.ready_head = (uint8_t)((dci.ready_head + 1) % dci.dma.buf_count);
;;;707            }
;;;708        }
;;;709        rtl_dci_unlock(s);
;;;710    
;;;711        /* POLL never calls frame_ready, not even as a "data available" hint: one
;;;712         * event must not have two entry points (DESIGN.md 11.2). */
;;;713        if (dci.dma.notify_mode == DCI_NOTIFY_CALLBACK && dci.dma.frame_ready != NULL)
;;;714        {
;;;715            dci.dma.frame_ready(f);
;;;716        }
;;;717    }
