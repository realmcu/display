;;;288    /**
;;;289     * \brief   Let the driver allocate a DMA channel instead of naming one.
;;;290     *
;;;291     * Preferred: the driver then asks the DMA HAL for the deepest FIFO available, which
;;;292     * is what a pixel stream wants, and the channel is released on Capture_Init failure
;;;293     * or on a later Reconfig. Naming a channel explicitly is still allowed but takes
;;;294     * the FIFO depth out of the driver's hands.
;;;295     *
;;;296     * On BBPro4 (rtl87x3k, AP core) a DCI capture only works on a DMA1 channel, which is
;;;297     * 16..23 there: AP DMA0 was dropped from the silicon. An explicit channel outside
;;;298     * that range is refused with DCI_ERROR_DMA_CHANNEL rather than quietly corrected,
;;;299     * because it means the caller expected a channel that cannot carry DCI at all. AUTO
;;;300     * handles the constraint on its own.
;;;301     */
;;;302    #define DCI_DMA_CH_AUTO             0xFFU
