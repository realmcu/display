;;;96     /**
;;;97      * @brief Initialize the I2Cx peripheral according to the specified parameters in the I2C_InitStruct.
;;;98      *
;;;99      * @param[in] I2Cx            Select the I2C peripheral, refer to @ref I2C_DECLARATION.
;;;100     * @param[in] I2C_InitStruct  Pointer to an I2C_InitTypeDef structure that contains the configuration information for the I2C peripheral.
;;;101     */
;;;102    void I2C_Init(I2C_TypeDef *I2Cx, I2C_InitTypeDef *I2C_InitStruct)
;;;103    {
;;;104        /* Check the parameters */
;;;105        assert_param(IS_I2C_ALL_PERIPH(I2Cx));
;;;106        assert_param(IS_I2C_CLOCK_SPEED(I2C_InitStruct->I2C_ClockSpeed));
;;;107        assert_param(IS_I2C_DEVICE_MODE(I2C_InitStruct->I2C_DeviceMode));
;;;108        assert_param(IS_I2C_ADDRESS_MODE(I2C_InitStruct->I2C_AddressMode));
;;;109    
;;;110        /* Disable I2C device before change configuration */
;;;111        IC_ENABLE_TypeDef i2c_0x6c = {.d32 = I2Cx->IC_ENABLE};
;;;112        i2c_0x6c.b.ic_enable = 0x0;
;;;113        I2Cx->IC_ENABLE = i2c_0x6c.d32;
;;;114    
;;;115        /* Config sda tx hold time in different clock speed */
;;;116        uint8_t sda_tx_hold = 0;
;;;117        uint32_t I2CSrcClk = I2C_GetClock(I2Cx);
;;;118        uint32_t i2c_source_clock_ns = NS_PER_SECOND / I2CSrcClk;
;;;119    
;;;120        if ((I2CSrcClk == 40000000) && (I2C_InitStruct->I2C_ClockSpeed > 400000))
;;;121        {
;;;122            sda_tx_hold = I2C_FAST_MODE_PLUS_SDA_HOLD_TIME_NS / i2c_source_clock_ns;
;;;123        }
;;;124        else
;;;125        {
;;;126            sda_tx_hold = (I2C_STANDARD_FAST_MODE_SDA_HOLD_TIME_NS / i2c_source_clock_ns == 0) ? 1 :
;;;127                          (I2C_STANDARD_FAST_MODE_SDA_HOLD_TIME_NS / i2c_source_clock_ns);
;;;128        }
;;;129    
;;;130        /* ------------------------------ Initialize I2C device ------------------------------*/
;;;131        if (I2C_DEVICE_MODE_MASTER == I2C_InitStruct->I2C_DeviceMode)
;;;132        {
;;;133            /* Configure I2C device mode which can be selected for master or slave */
;;;134            IC_CON_TypeDef i2c_0x00 = {.d32 = I2Cx->IC_CON};
;;;135            i2c_0x00.b.master_mode = 0x1;
;;;136            i2c_0x00.b.ic_slave_disable = 0x1;
;;;137            i2c_0x00.b.ic_restart_en = 0x1;
;;;138            I2Cx->IC_CON = i2c_0x00.d32;
;;;139    
;;;140            /* Set target address */
;;;141            IC_TAR_TypeDef i2c_0x04 = {.d32 = I2Cx->IC_TAR};
;;;142            i2c_0x04.b.ic_10bitaddr_master = I2C_InitStruct->I2C_AddressMode;
;;;143            i2c_0x04.b.ic_tar = I2C_InitStruct->I2C_SlaveAddress;
;;;144            I2Cx->IC_TAR = i2c_0x04.d32;
;;;145    
;;;146            /* Set SDA hold time in master mode */
;;;147            IC_SDA_HOLD_TypeDef i2c_0x7c = {.d32 = I2Cx->IC_SDA_HOLD};
;;;148            i2c_0x7c.b.ic_sda_tx_hold = sda_tx_hold;
;;;149            i2c_0x7c.b.ic_sda_rx_hold = 0x1;
;;;150            I2Cx->IC_SDA_HOLD = i2c_0x7c.d32;
;;;151    
;;;152            I2C_RisingTimeNs = I2C_InitStruct->I2C_RisingTimeNs;
;;;153            /* Configure I2C speed */
;;;154            I2C_SetClockSpeed(I2Cx, I2C_InitStruct->I2C_ClockSpeed);
;;;155        }
;;;156        else
;;;157        {
;;;158            /* Set to slave mode */
;;;159            IC_CON_TypeDef i2c_0x00 = {.d32 = I2Cx->IC_CON};
;;;160            i2c_0x00.b.master_mode = 0x0;
;;;161            i2c_0x00.b.ic_10bitaddr_slave = I2C_InitStruct->I2C_AddressMode;
;;;162            i2c_0x00.b.ic_slave_disable = 0x0;
;;;163            I2Cx->IC_CON = i2c_0x00.d32;
;;;164    
;;;165            /* Set slave address */
;;;166            IC_SAR_TypeDef i2c_0x08 = {.d32 = I2Cx->IC_SAR};
;;;167            i2c_0x08.b.ic_sar = I2C_InitStruct->I2C_SlaveAddress;
;;;168            I2Cx->IC_SAR = i2c_0x08.d32;
;;;169    
;;;170            /* Set Ack in slave mode */
;;;171            IC_ACK_GENERAL_CALL_TypeDef i2c_0x98 = {.d32 = I2Cx->IC_ACK_GENERAL_CALL};
;;;172            i2c_0x98.b.ack_gen_call &= I2C_InitStruct->I2C_Ack;
;;;173            I2Cx->IC_ACK_GENERAL_CALL = i2c_0x98.d32;
;;;174    
;;;175            /* Set SDA hold time in slave mode */
;;;176            IC_SDA_HOLD_TypeDef i2c_0x7c = {.d32 = I2Cx->IC_SDA_HOLD};
;;;177            i2c_0x7c.b.ic_sda_tx_hold = sda_tx_hold;
;;;178            i2c_0x7c.b.ic_sda_rx_hold = 0x08;
;;;179            I2Cx->IC_SDA_HOLD = i2c_0x7c.d32;
;;;180    
;;;181            /* Set SDA setup time delay only in slave transmitter mode(greater than 2) ,delay time:[(IC_SDA_SETUP - 1) * (ic_clk_period)]*/
;;;182            IC_SDA_SETUP_TypeDef i2c_0x94 = {.d32 = I2Cx->IC_SDA_SETUP};
;;;183            i2c_0x94.b.sda_setup = I2C_SDA_SETUP_TIME_VALUE;
;;;184            I2Cx->IC_SDA_SETUP = i2c_0x94.d32;
;;;185        }
;;;186    
;;;187        /* Set Tx empty level */
;;;188        IC_TX_TL_TypeDef i2c_0x3c = {.d32 = I2Cx->IC_TX_TL};
;;;189        i2c_0x3c.b.tx_tl = I2C_InitStruct->I2C_TxThresholdLevel;
;;;190        I2Cx->IC_TX_TL = i2c_0x3c.d32;
;;;191    
;;;192        /*set Rx full level*/
;;;193        IC_RX_TL_TypeDef i2c_0x40 = {.d32 = I2Cx->IC_RX_TL};
;;;194        i2c_0x40.b.rx_tl = I2C_InitStruct->I2C_RxThresholdLevel;
;;;195        I2Cx->IC_RX_TL = i2c_0x40.d32;
;;;196    
;;;197        /* Config I2C dma mode */
;;;198        IC_DMA_CR_TypeDef i2c_0x88 = {.d32 = I2Cx->IC_DMA_CR};
;;;199        i2c_0x88.b.rdmae = I2C_InitStruct->I2C_RxDMAEn;
;;;200        i2c_0x88.b.tdmae = I2C_InitStruct->I2C_TxDMAEn;
;;;201        I2Cx->IC_DMA_CR = i2c_0x88.d32;
;;;202    
;;;203        /* Config I2C waterlevel */
;;;204        IC_DMA_TDLR_TypeDef i2c_0x8c = {.d32 = I2Cx->IC_DMA_TDLR};
;;;205        IC_DMA_RDLR_TypeDef i2c_0x90 = {.d32 = I2Cx->IC_DMA_RDLR};
;;;206        i2c_0x8c.b.dmatdl = I2C_InitStruct->I2C_TxWaterlevel;
;;;207        i2c_0x90.b.dmardl = I2C_InitStruct->I2C_RxWaterlevel;
;;;208        I2Cx->IC_DMA_TDLR = i2c_0x8c.d32;
;;;209        I2Cx->IC_DMA_RDLR = i2c_0x90.d32;
;;;210    
;;;211        /* Mask all interrupt */
;;;212        I2Cx->IC_INTR_MASK = 0x0;
;;;213    
;;;214        uint8_t index = I2C_GetIndex(I2Cx);
;;;215        uint64_t timeout_us = (uint64_t)9000000 * I2C_TIMEOUT_SCALE / (I2C_InitStruct->I2C_ClockSpeed);
;;;216        if (timeout_us < I2C_TIMEOUT_MIN_US)
;;;217        {
;;;218            timeout_us = I2C_TIMEOUT_MIN_US;
;;;219        }
;;;220        I2C_TimeOutUs[index] = (uint32_t)timeout_us;
;;;221    }
;;;222    
;;;223    /**
;;;224     * @brief Fill each I2C_InitStruct member with its default value.
;;;225     *
;;;226     * @param[in] I2C_InitStruct  Pointer to a I2C_InitTypeDef structure which will be initialized.
;;;227     */
;;;228    void I2C_StructInit(I2C_InitTypeDef *I2C_InitStruct)
;;;229    {
;;;230        /* I2C source clock is 40MHz, depending on clock divider */
;;;231        I2C_InitStruct->I2C_Clock             = 40000000;
;;;232        /* I2C SCK freqency is 400KHz */
;;;233        I2C_InitStruct->I2C_ClockSpeed        = 400000;
;;;234        /* Master mode */
;;;235        I2C_InitStruct->I2C_DeviceMode        = I2C_DEVICE_MODE_MASTER;
;;;236        /* 7-bit address mode */
;;;237        I2C_InitStruct->I2C_AddressMode       = I2C_ADDRESS_MODE_7BIT;
;;;238        /* Set slave address */
;;;239        I2C_InitStruct->I2C_SlaveAddress      = 0;
;;;240        /* Enable acknowledge in slave mode */
;;;241        I2C_InitStruct->I2C_Ack               = ENABLE;
;;;242        /* Tx fifo depth: 24 * 8bits */
;;;243        I2C_InitStruct->I2C_TxThresholdLevel  = 0;
;;;244        /* Rx fifo depth: 24 * 8bits */
;;;245        I2C_InitStruct->I2C_RxThresholdLevel  = 0;
;;;246        /* Disable dma */
;;;247        I2C_InitStruct->I2C_TxDMAEn           = DISABLE;
;;;248        I2C_InitStruct->I2C_RxDMAEn           = DISABLE;
;;;249        /* I2C Tx waterlevel, should be less than fifo threshold.
;;;250           The best value is I2C FIFO Depth - DMA Msize */
;;;251        I2C_InitStruct->I2C_TxWaterlevel      = 23;
;;;252        /* I2C Rx waterlevel, should be less than fifo threshold.
;;;253           The best value is DMA Msize */
;;;254        I2C_InitStruct->I2C_RxWaterlevel      = 1;
;;;255        /* Specify I2C scl rising time with 2.2K ohm pull up resistor, the unit is ns*/
;;;256        I2C_InitStruct->I2C_RisingTimeNs     = 50;
;;;257    
;;;258    }
