;;;797    /**
;;;798     * @brief Write command through the I2Cx peripheral.
;;;799     *
;;;800     * @param[in] I2Cx       Select the I2C peripheral, refer to @ref I2C_DECLARATION.
;;;801     * @param[in] command    Command of write or read.
;;;802     *                       - I2C_READ_CMD: Read command. Data to be transmitted can be 0 in this situation.
;;;803     *                       - I2C_WRITE_CMD: Write command.
;;;804     * @param[in] data       Data to be transmitted.
;;;805     * @param[in] StopState  Whether to send a stop signal.
;;;806     *                       - ENABLE: Send stop signal.
