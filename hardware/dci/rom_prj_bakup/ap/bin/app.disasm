;;;343                }
;;;344    #if (IR_SUPPORT_TX_FINISH_INTERRUPT == 1)
;;;345                /* Disable TX Finish Interrupt */
;;;346                if (IR_INT & IR_INT_TX_FINISH)
;;;347                {
;;;348                    IR->IR_TX_SR &= ~((IR_INT & IR_INT_TX_FINISH) << IR_TX_FINISH_MSK_TO_EN_POS);
;;;349                }
;;;350                /* Disable Remaining TX Interrupts */
;;;351                if ((IR_INT & (~(IR_INT_TF_OF | IR_INT_TX_FINISH))) != 0)
;;;352                {
;;;353                    IR->IR_TX_CONFIG &= ~((IR_INT & (~(IR_INT_TF_OF | IR_INT_TX_FINISH))) << IR_TX_MSK_TO_EN_POS);
;;;354                }
;;;355    #else
;;;356                /* Disable Remaining TX Interrupts. Exclude IR_INT_TF_OF to avoid writing it to the wrong register. */
;;;357                if ((IR_INT & (~IR_INT_TF_OF)) != 0)
;;;358                {
;;;359                    IR->IR_TX_CONFIG &= (~((IR_INT & (~IR_INT_TF_OF)) << IR_TX_MSK_TO_EN_POS));
