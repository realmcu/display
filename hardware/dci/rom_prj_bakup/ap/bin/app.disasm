;;;364    }
;;;365    
;;;366    /**
;;;367     * @brief Enables or disables the specified IR interrupt.
;;;368     *
;;;369     * @param[in] IR_INT Specifies the IR interrupt to be enabled or disabled, refer to @ref IR_INTERRUPT.
;;;370     *            This parameter can be one of the following values:
;;;371     *            - IR_INT_TF_EMPTY: TX FIFO empty interrupt.
;;;372     *            - IR_INT_TF_LEVEL: TX FIFO threshold interrupt.
;;;373     *            - IR_INT_TF_OF: TX FIFO overflow interrupt.
;;;374     *            - IR_INT_TX_FINISH: TX finish interrupt.
;;;375     *            - IR_INT_RF_FULL: RX FIFO full interrupt.
;;;376     *            - IR_INT_RF_LEVEL: RX FIFO threshold interrupt.
;;;377     *            - IR_INT_RX_CNT_OF: RX counter overflow interrupt.
;;;378     *            - IR_INT_RF_OF: RX FIFO overflow interrupt.
;;;379     *            - IR_INT_RX_CNT_THR: RX counter threshold interrupt.
;;;380     *            - IR_INT_RF_ERROR: RX FIFO error read interrupt. Trigger when RX FIFO empty and read RX FIFO.
;;;381     *            - IR_INT_RISING_EDGE: IR RX rising edge interrupt.
;;;382     *            - IR_INT_FALLING_EDGE: IR RX falling edge interrupt.
;;;383     * @param[in] NewState New state of the specified IR interrupt.
;;;384     *            - ENABLE: Enable the specified IR interrupt.
;;;385     *            - DISABLE: Disable the specified IR interrupt.
;;;386     */
;;;387    void IR_INTConfig(uint32_t IR_INT, FunctionalState NewState)
;;;388    {
