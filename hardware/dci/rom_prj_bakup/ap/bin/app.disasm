;;;871        if (dci.mode == DCI_MODE_SNAPSHOT)
;;;872        {
;;;873            /* Rotate so a following Start() fills the other buffer while the consumer
;;;874             * still works on this one (DESIGN.md 6.4). Also on the error paths: a
;;;875             * truncated frame is still held by the consumer, so a retry belongs in
;;;876             * the other buffer. */
;;;877            dci.cur_group = (uint8_t)((k + 1) % dci.dma.buf_count);
;;;878        }
;;;879    
;;;880        if (err != DCI_SUCCESS)
;;;881        {
;;;882            if (err == DCI_ERROR_BUF_OVERFLOW)
;;;883            {
;;;884                dci.stats.buf_overflow++;
;;;885            }
;;;886            dci.state = DCI_STATE_ERROR;
;;;887            dci_report(err, ris);
;;;888            return;
;;;889        }
;;;890    
;;;891        if (dci.mode == DCI_MODE_SNAPSHOT)
;;;892        {
;;;893            dci.state = DCI_STATE_IDLE;
;;;894            return;
;;;895        }
;;;896    
;;;897        dci_rearm_or_gate();
;;;898    }
;;;899    
;;;900    /*
;;;901     * CONTINUOUS fixed length: the closed ring gives no Transfer event, so the frame
;;;902     * is settled by a rendezvous between IT_FRAME and the group-last block. Whichever
;;;903     * arrives first only sets its bit; the same bit set twice in a row means the
;;;904     * other half never came, which catches both a short and a long frame and cannot
;;;905     * misfire on the first frame (DESIGN.md 7.2).
;;;906     */
;;;907    static void dci_rendezvous(uint8_t bit, uint32_t ris)
;;;908    {
;;;909        uint8_t  k, next;
;;;910        uint32_t s = rtl_dci_lock();
;;;911    
;;;912        if ((dci.evt & bit) != 0)
;;;913        {
;;;914            dci.evt = 0;
;;;915            rtl_dci_unlock(s);
;;;916            dci.state = DCI_STATE_ERROR;
;;;917            dci_resync();
