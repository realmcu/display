;;;126        for (i = 0; i < demo_bufs.count; i++)
;;;127        {
;;;128            for (w = 0; w < demo_bufs.bytes / 4; w++)
;;;129            {
;;;130                demo_bufs.buf[i][w] = DCI_DEMO_POISON;
;;;131            }
;;;132        }
;;;133    }
;;;134    
;;;135    /*============================================================================*
;;;136     *                         Checks
;;;137     *============================================================================*/
;;;138    /*
;;;139     * The guard check is the highest-value assertion in the whole demo: it is the only
;;;140     * one that catches a miscomputed block split directly, rather than as a corrupt
;;;141     * image that still has to be interpreted by eye.
;;;142     */
;;;143    bool dci_demo_buf_guards_ok(void)
;;;144    {
;;;145        uint32_t stride = demo_bufs.bytes / 4 + DEMO_GUARD_WORDS;
;;;146        uint32_t i, g;
;;;147    
;;;148        if (!demo_bufs.valid)
;;;149        {
;;;150            return false;
;;;151        }
;;;152    
;;;153        for (i = 0; i <= demo_bufs.count; i++)
;;;154        {
;;;155            uint32_t base = i * stride;
;;;156    
;;;157            for (g = 0; g < DEMO_GUARD_WORDS; g++)
;;;158            {
;;;159                if (demo_pool[base + g] != DCI_DEMO_GUARD)
;;;160                {
;;;161                    DEMO_LOG("  GUARD violated at pool word %u (%p): 0x%08X",
;;;162                             base + g, (void *)&demo_pool[base + g],
;;;163                             demo_pool[base + g]);
;;;164                    return false;
;;;165                }
;;;166            }
;;;167        }
;;;168        return true;
;;;169    }
;;;170    
;;;171    /*
;;;172     * The head of a delivered frame, over the UART, plus the guard word in front of it.
;;;173     *
;;;174     * This exists because "seq 1, 38400 B" looks the same whether the DMA wrote a frame or
;;;175     * wrote nothing: the byte count comes from the descriptor, not from the data. A dozen
;;;176     * words settle it immediately, and name the failure while doing so:
;;;177     *
;;;178     *   DEADBEEF repeated  - this demo's poison. The DMA never wrote here.
;;;179     *   A5A5A5A5 in [-1]   - the guard is intact, so nothing overran into it.
;;;180     *   one constant value - something wrote, but not pixels (bus stuck, or a sensor
;;;181     *                        putting out a flat field).
;;;182     *   varying values     - real data; compare against the expected format.
;;;183     */
;;;184    void dci_demo_buf_head_dump(const DCI_frame_t *f, uint32_t words)
;;;185    {
;;;186        const uint32_t *p;
;;;187        uint32_t        avail;
;;;188        uint32_t        i;
;;;189    
;;;190        if (f == NULL)
;;;191        {
;;;192            return;
;;;193        }
;;;194    
;;;195        p = dci_demo_buf_get(f->index);
;;;196        if (p == NULL)
;;;197        {
;;;198            return;
;;;199        }
;;;200    
;;;201        avail = f->bytes / 4;
;;;202        if (words > avail)
;;;203        {
;;;204            words = avail;
;;;205        }
;;;206        if (words == 0)
;;;207        {
;;;208            DEMO_LOG("  head: frame is 0 words long, nothing to show");
;;;209            return;
;;;210        }
;;;211    
;;;212        /* The guard immediately below the buffer. Printed with the data rather than only on
;;;213         * the guard check, because "was anything written, and did it stay in bounds" is one
;;;214         * question in practice. */
;;;215        DEMO_LOG("  guard[-1] 0x%08X %s", p[-1],
;;;216                 (p[-1] == DCI_DEMO_GUARD) ? "(intact)" : "(!! OVERWRITTEN)");
;;;217    
;;;218        for (i = 0; i < words; i += 4)
;;;219        {
;;;220            uint32_t n = ((words - i) < 4) ? (words - i) : 4;
;;;221    
;;;222            switch (n)
;;;223            {
;;;224            case 4:
;;;225                DEMO_LOG("  +%04X: %08X %08X %08X %08X", (unsigned)(i * 4),
;;;226                         p[i], p[i + 1], p[i + 2], p[i + 3]);
;;;227                break;
;;;228            case 3:
;;;229                DEMO_LOG("  +%04X: %08X %08X %08X", (unsigned)(i * 4),
;;;230                         p[i], p[i + 1], p[i + 2]);
;;;231                break;
;;;232            case 2:
;;;233                DEMO_LOG("  +%04X: %08X %08X", (unsigned)(i * 4), p[i], p[i + 1]);
;;;234                break;
;;;235            default:
;;;236                DEMO_LOG("  +%04X: %08X", (unsigned)(i * 4), p[i]);
;;;237                break;
;;;238            }
;;;239        }
;;;240    
;;;241        /*
;;;242         * Say what was just shown, so the reader does not have to recognise the constants.
;;;243         *
;;;244         * Judged over the WHOLE frame, not just the words printed above: on a colour bar the
;;;245         * first words legitimately are one constant - the leading bar is tens of pixels wide
;;;246         * - so a verdict based on the head alone would cry "no variation" on a perfectly
;;;247         * good capture. The head is for the eye; the counting is for the verdict.
;;;248         */
;;;249        {
;;;250            const uint32_t *q     = dci_demo_buf_get(f->index);
;;;251            uint32_t        step  = (avail > 4096U) ? (avail / 4096U) : 1U;  /* cap the scan */
;;;252            uint32_t        seen  = 0, poison = 0, same = 0;
;;;253    
;;;254            for (i = 0; i < avail; i += step)
;;;255            {
;;;256                seen++;
;;;257                if (q[i] == DCI_DEMO_POISON) { poison++; }
;;;258                if (q[i] == q[0])            { same++; }
;;;259            }
;;;260    
;;;261            if (poison == seen)
;;;262            {
;;;263                DEMO_LOG("  -> all poison over the whole frame: "
;;;264                         "THE DMA DID NOT WRITE THIS BUFFER");
;;;265            }
;;;266            else if (same == seen)
;;;267            {
;;;268                DEMO_LOG("  -> one constant 0x%08X over the whole frame: "
;;;269                         "written, but no pixel variation", q[0]);
;;;270            }
;;;271            else if (poison != 0)
;;;272            {
;;;273                DEMO_LOG("  -> %u of %u sampled words still poison: partial write",
