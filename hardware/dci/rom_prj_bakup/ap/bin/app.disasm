;;;741        s = rtl_dci_lock();
;;;742        if (dci.state != DCI_STATE_BUSY || (dci.buf_lock_mask & BIT(next_group)) == 0)
;;;743        {
;;;744            rtl_dci_unlock(s);
;;;745            return;
;;;746        }
;;;747        dci.state = DCI_STATE_SUSPENDED;
;;;748        dci.stats.suspend_count++;
;;;749        rtl_dci_unlock(s);
