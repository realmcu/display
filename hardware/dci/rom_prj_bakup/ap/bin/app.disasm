;;;170        dma.on_busy         = on_busy;
;;;171        dma.notify_mode     = notify;
;;;172        if (notify == DCI_NOTIFY_CALLBACK)
;;;173        {
;;;174            dma.frame_ready = dci_demo_on_frame_ready;
;;;175        }
;;;176        for (i = 0; i < buf_count; i++)
;;;177        {
;;;178            dma.buf[i] = dci_demo_buf_get(i);
;;;179        }
;;;180    
;;;181        /*
;;;182         * frame_error, and the VSYNC/LINE handlers the macros asked for. This is also the
;;;183         * register-level interrupt enable: the driver adds IT_VSYNC / IT_LINE to IER only
;;;184         * for the pointers that are non-NULL, so a disabled interrupt is a NULL pointer
;;;185         * here rather than a masking step somewhere else. Must be before Start(), which
