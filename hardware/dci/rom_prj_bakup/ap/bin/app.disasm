;;;359        if (crop->w != 0 || crop->h != 0)
;;;360        {
;;;361            if (crop->w > 0x4000U || crop->h > 0x4000U)   /* CAPCNT / VLINE are 14 bit */
;;;362            {
;;;363                return DCI_ERROR_SIZE;
;;;364            }
;;;365            /* Register table, CROP: "If crop window exceeds picture size, only
;;;366             * picture size is captured" - the hardware truncates silently, which
;;;367             * lands straight in the desync case of DESIGN.md 7.1. */
;;;368            if ((uint32_t)crop->x0 + crop->w > init->sensor_pclk_per_line ||
;;;369                (uint32_t)crop->y0 + crop->h > init->sensor_lines)
;;;370            {
;;;371                return DCI_ERROR_SIZE;
;;;372            }
;;;373        }
;;;374    
;;;375        if (dma->buf_count < DCI_BUF_SINGLE || dma->buf_count > DCI_MAX_BUF)
;;;376        {
;;;377            return DCI_ERROR_INVALID_PARAM;
;;;378        }
;;;379        if (dma->on_busy > DCI_ON_BUSY_OVERWRITE || dma->notify_mode > DCI_NOTIFY_POLL)
;;;380        {
;;;381            return DCI_ERROR_INVALID_PARAM;
;;;382        }
;;;383        if (dma->notify_mode == DCI_NOTIFY_CALLBACK && dma->frame_ready == NULL)
;;;384        {
;;;385            return DCI_ERROR_NO_CALLBACK;
;;;386        }
;;;387        if (dma->buf_bytes == 0 || (dma->buf_bytes & 0x3U) != 0)
;;;388        {
;;;389            return DCI_ERROR_ALIGN;
;;;390        }
;;;391        for (i = 0; i < dma->buf_count; i++)
;;;392        {
;;;393            if (dma->buf[i] == NULL)
;;;394            {
;;;395                return DCI_ERROR_INVALID_PARAM;
;;;396            }
;;;397            if (((uint32_t)dma->buf[i] & 0x3U) != 0)
;;;398            {
;;;399                return DCI_ERROR_ALIGN;
;;;400            }
;;;401        }
;;;402        if (rtl_dci_get_dma_depth(dma->dma_channel_num) == 0)
;;;403        {
