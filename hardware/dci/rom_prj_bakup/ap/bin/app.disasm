;;;319    /**
;;;320     * @brief Fills each SPI_InitStruct member with its default value.
;;;321     *
;;;322     * @note   The default settings for the SPI_InitStruct member are shown in the following table:
;;;323     *         | SPI_InitStruct member      | Default value                  |
;;;324     *         |:--------------------------:|:------------------------------:|
;;;325     *         | SPI_Direction              | @ref SPI_DIRECTION_FULLDUPLEX  |
;;;326     *         | SPI_RXNDF                  | 1                              |
;;;327     *         | SPI_Mode                   | @ref SPI_MODE_MASTER           |
;;;328     *         | SPI_DataSize               | @ref SPI_DATA_SIZE_8b           |
;;;329     *         | SPI_CPOL                   | @ref SPI_CPOL_HIGH             |
;;;330     *         | SPI_CPHA                   | @ref SPI_CPHA_2EDGE            |
;;;331     *         | SPI_FrameFormat            | @ref SPI_FRAME_MOTOROLA        |
;;;332     *         | SPI_BaudRatePrescaler      | 128                            |
;;;333     *         | SPI_ToggleEn               | DISABLE                        |
;;;334     *         | SPI_TxThresholdLevel       | 1                              |
;;;335     *         | SPI_RxThresholdLevel       | 0                              |
;;;336     *         | SPI_TxDMAEn                | DISABLE                        |
;;;337     *         | SPI_RxDMAEn                | DISABLE                        |
;;;338     *         | SPI_TxWaterlevel           | SPI_TX_FIFO_SIZE - 1           |
;;;339     *         | SPI_RxWaterlevel           | 1                              |
;;;340     *
;;;341     * @param[in] SPI_InitStruct  Pointer to a SPI_InitTypeDef structure which will be initialized.
;;;342     */
;;;343    void SPI_StructInit(SPI_InitTypeDef *SPI_InitStruct)
;;;344    {
;;;345        /* TX and RX Mode */
;;;346        SPI_InitStruct->SPI_Direction         = SPI_DIRECTION_FULLDUPLEX;
;;;347        /* Number of data to read in RX/EEPROM Mode */
;;;348        SPI_InitStruct->SPI_RXNDF              = 1;
;;;349        /* 8-bit serial data transfer */
;;;350        SPI_InitStruct->SPI_DataSize          = SPI_DATA_SIZE_8b;
;;;351        /* Inactive state of clock is high */
;;;352        SPI_InitStruct->SPI_CPOL              = SPI_CPOL_HIGH;
;;;353        /* Serial clock toggles in first of first data bit */
;;;354        SPI_InitStruct->SPI_CPHA              = SPI_CPHA_2EDGE;
;;;355    #if (SPI_FIXED_FRAME_FORMAT == 0)
;;;356        /* Motorola format */
;;;357        SPI_InitStruct->SPI_FrameFormat       = SPI_FRAME_MOTOROLA;
;;;358    #endif
;;;359        /* Speed = SPI Clock source/ SPI_ClkDIV*/
;;;360        SPI_InitStruct->SPI_BaudRatePrescaler = 128;
;;;361    #if (SPI0_SUPPORT_MASTER_SLAVE == 1)
;;;362        SPI_InitStruct->SPI_Mode = SPI_MODE_MASTER;
;;;363    #endif
;;;364    #if (SPI_SUPPORT_SWAP == 1)
;;;365        /* Reverse the rx bit or not */
;;;366        SPI_InitStruct->SPI_SwapTxBitEn       = DISABLE;
;;;367        SPI_InitStruct->SPI_SwapRxBitEn       = DISABLE;
;;;368        SPI_InitStruct->SPI_SwapTxByteEn      = DISABLE;
;;;369        SPI_InitStruct->SPI_SwapRxByteEn      = DISABLE;
;;;370    #endif
;;;371        /* Toggle CS line or not */
;;;372        SPI_InitStruct->SPI_ToggleEn          = DISABLE;
;;;373    #if (SPI_SUPPORT_WRAP_MODE == 1)
;;;374        /* Number of data to read in TX/FullDuplex Mode */
;;;375        SPI_InitStruct->SPI_TXNDF             = 1;
;;;376        /* Enable CS high active or not */
;;;377        SPI_InitStruct->SPI_CSHighActiveEn    = DISABLE;
;;;378        /* Disable tx ndf */
;;;379        SPI_InitStruct->SPI_WrapModeEn     = DISABLE;
;;;380        /* Disable dma */
;;;381        SPI_InitStruct->SPI_WrapModeDMAEn  = DISABLE;
;;;382        /* Wrapper Tx fifo depth: SPI_WRAPPER_TX_FIFO_SIZE bytes */
;;;383        SPI_InitStruct->SPI_WrapTxThresholdLevel  = 1;
;;;384        /* SPI Tx waterlevel, should be less than fifo threshold.
;;;385           The best value is SPI FIFO Depth - GDMA Msize */
;;;386        SPI_InitStruct->SPI_WrapTxWaterlevel   =  SPI_TX_FIFO_SIZE - 1;
;;;387        /* Set CS clock divider */
;;;388        SPI_InitStruct->SPI_WrapCSClockDiv = SPI_WRAP_CS_CLOCK_DIV_1;
;;;389        /* Set CS hold delay count */
;;;390        SPI_InitStruct->SPI_WrapCSHoldDlyCount = 0;
;;;391        /* Set CS setup delay count */
;;;392        SPI_InitStruct->SPI_WrapCSSetupDlyCount = 0;
;;;393    
;;;394    #endif
;;;395        /* Tx fifo depth: SPI_TX_FIFO_SIZE bytes */
;;;396        SPI_InitStruct->SPI_TxThresholdLevel  = 1;
;;;397        /* Rx fifo depth: SPI_RX_FIFO_SIZE bytes */
;;;398        SPI_InitStruct->SPI_RxThresholdLevel  = 0;
;;;399        /* Disable dma */
;;;400        SPI_InitStruct->SPI_TxDMAEn           = DISABLE;
;;;401        SPI_InitStruct->SPI_RxDMAEn           = DISABLE;
;;;402        /* SPI Tx waterlevel, should be less than fifo threshold.
;;;403           The best value is SPI FIFO Depth - DMA Msize */
;;;404        SPI_InitStruct->SPI_TxWaterlevel      = SPI_TX_FIFO_SIZE - 1;
;;;405        /* SPI Rx waterlevel, should be less than fifo threshold.
;;;406           The best value is DMA Msize */
;;;407        SPI_InitStruct->SPI_RxWaterlevel      = 1;
;;;408    }
