;;;1796   
;;;1797   /*============================================================================*
;;;1798    *                     Register Read/Write Self Test
;;;1799    *============================================================================*/
;;;1800   /*
;;;1801    * Bring-up aid: proves the register block is reachable and its bits behave, with
;;;1802    * no camera and no DMA involved. The failure it exists to catch is a clock that is
;;;1803    * still gated or a wrong base address, both of which otherwise show up much later
;;;1804    * as "capture produces nothing" and cost a lot of time to trace back.
;;;1805    *
;;;1806    * DR is excluded throughout: reading it pops the FIFO (DESIGN.md 13.1).
;;;1807    */
;;;1808   
;;;1809   /* Writable-bit masks, derived from the register table. Bits outside these are
;;;1810    * reserved or read-only and must read back 0.
;;;1811    *
;;;1812    * CR.capture (bit 0) is deliberately excluded: the register table marks it R/WAC,
;;;1813    * i.e. the hardware clears it on its own (in snapshot mode it self-clears at the
;;;1814    * end of a frame). A bit that may legitimately refuse to latch cannot be pattern
;;;1815    * tested - it would report a false stuck-0 on the very first bring-up step, which
;;;1816    * is worse than not covering it. Every capture test exercises it thoroughly. */
;;;1817   #define DCI_CR_RW_MASK      0x001F4FFEUL    /* [20:16] [14] [11:1], skip capture and
;;;1818                                                  rsvd 15 / 13:12 */
;;;1819   #define DCI_IER_RW_MASK     0x0000001FUL
;;;1820   #define DCI_ESCR_RW_MASK    0xFFFFFFFFUL
;;;1821   #define DCI_ESUR_RW_MASK    0xFFFFFFFFUL
;;;1822   #define DCI_CWSTRT_RW_MASK  0x1FFF3FFFUL    /* vst[28:16], hoffcnt[13:0] */
;;;1823   #define DCI_CWSIZE_RW_MASK  0x3FFF3FFFUL    /* vline[29:16], capcnt[13:0] */
;;;1824   
;;;1825   typedef struct
;;;1826   {
;;;1827       const char *name;
;;;1828       uint16_t    offset;
;;;1829       uint32_t    rw_mask;
;;;1830   } dci_reg_desc_t;
;;;1831   
;;;1832   /* Order matches the register map so the report reads like the dump. */
;;;1833   static const dci_reg_desc_t dci_reg_tbl[] =
;;;1834   {
;;;1835       {"CR",     0x00, DCI_CR_RW_MASK    },
;;;1836       {"SR",     0x04, 0                 },  /* read-only */
;;;1837       {"RIS",    0x08, 0                 },  /* read-only */
;;;1838       {"IER",    0x0C, DCI_IER_RW_MASK   },
;;;1839       {"MIS",    0x10, 0                 },  /* read-only */
;;;1840       {"ICR",    0x14, 0                 },  /* write-1-only, checked separately */
;;;1841       {"ESCR",   0x18, DCI_ESCR_RW_MASK  },
;;;1842       {"ESUR",   0x1C, DCI_ESUR_RW_MASK  },
;;;1843       {"CWSTRT", 0x20, DCI_CWSTRT_RW_MASK},
;;;1844       {"CWSIZE", 0x24, DCI_CWSIZE_RW_MASK},
;;;1845   };
;;;1846   
;;;1847   #define DCI_REG_TBL_CNT     (sizeof(dci_reg_tbl) / sizeof(dci_reg_tbl[0]))
;;;1848   
;;;1849   static volatile uint32_t *dci_reg_at(uint32_t offset)
;;;1850   {
;;;1851       return (volatile uint32_t *)(DCI_REG_BASE + offset);
;;;1852   }
;;;1853   
;;;1854   /*
;;;1855    * Walking-1 plus all-1 plus 0x5555.../0xAAAA... over the writable bits. Walking-1
;;;1856    * localises a single stuck bit; the alternating patterns catch shorts between
;;;1857    * adjacent bits, which a walking pattern alone can miss.
;;;1858    *
;;;1859    * `varied` is set when the register returned at least two different values, which
;;;1860    * is what tells a live block from a gated one - see dci_regtest_alive().
;;;1861    */
;;;1862   static void dci_regtest_one(const dci_reg_desc_t *d, DCI_regtest_item_t *it,
;;;1863                               bool *varied)
;;;1864   {
;;;1865       volatile uint32_t *reg = dci_reg_at(d->offset);
;;;1866       const uint32_t     pat[] = {0xFFFFFFFFUL, 0x55555555UL, 0xAAAAAAAAUL};
;;;1867       uint32_t           first_rb = 0;
;;;1868       bool               have_first = false;
;;;1869       uint32_t           i;
;;;1870   
;;;1871       it->name    = d->name;
;;;1872       it->offset  = d->offset;
;;;1873       it->rw_mask = d->rw_mask;
;;;1874       it->stuck_0 = 0;
;;;1875       it->stuck_1 = 0;
;;;1876       it->skipped = (d->rw_mask == 0);
;;;1877   
;;;1878       if (it->skipped)
;;;1879       {
;;;1880           return;
;;;1881       }
;;;1882   
;;;1883       for (i = 0; i < 32; i++)
;;;1884       {
;;;1885           uint32_t w = (1UL << i) & d->rw_mask;
;;;1886           uint32_t rb;
;;;1887   
;;;1888           if (w == 0)
;;;1889           {
;;;1890               continue;
;;;1891           }
;;;1892           *reg = w;
;;;1893           rb   = *reg;
;;;1894   
;;;1895           if (!have_first)
;;;1896           {
;;;1897               first_rb = rb;
;;;1898               have_first = true;
;;;1899           }
;;;1900           else if (rb != first_rb)
;;;1901           {
;;;1902               *varied = true;
;;;1903           }
;;;1904   
;;;1905           if ((rb & w) == 0)
;;;1906           {
;;;1907               it->stuck_0 |= w;
;;;1908           }
;;;1909           /* Anything outside the bit just written must be 0: a 1 here is either a
;;;1910            * reserved bit that is not really reserved, or bits bleeding into each
;;;1911            * other. Restricted to rw_mask so that self-setting status bits elsewhere
;;;1912            * in the word cannot cause a false alarm. */
;;;1913           it->stuck_1 |= (rb & d->rw_mask & ~w);
;;;1914       }
;;;1915   
;;;1916       for (i = 0; i < sizeof(pat) / sizeof(pat[0]); i++)
;;;1917       {
;;;1918           uint32_t w = pat[i] & d->rw_mask;
;;;1919           uint32_t rb;
;;;1920   
;;;1921           *reg = w;
;;;1922           rb   = *reg;
;;;1923   
;;;1924           if (have_first && rb != first_rb)
;;;1925           {
;;;1926               *varied = true;
;;;1927           }
;;;1928   
;;;1929           it->stuck_0 |= (w & ~rb);
;;;1930           it->stuck_1 |= (rb & d->rw_mask & ~w);
;;;1931       }
;;;1932   
;;;1933       *reg = 0;
;;;1934   }
;;;1935   
;;;1936   /*
;;;1937    * Liveness: a gated clock, a wrong base or a dead bus returns the *same* value no
;;;1938    * matter what is written - typically all-0 or all-1. So the question is whether the
;;;1939    * read-back varies, not whether it equals some particular value.
;;;1940    *
;;;1941    * Checking for a specific constant would be wrong: ESCR and ESUR are fully writable
;;;1942    * 32-bit registers, so an all-ones read-back is a legitimate result there.
;;;1943    *
;;;1944    * Uses CR, whose writable mask has both set and clear bits, so 0 and rw_mask must
;;;1945    * read back differently on any working block.
;;;1946    */
;;;1947   static bool dci_regtest_alive(uint32_t *lo, uint32_t *hi)
;;;1948   {
;;;1949       *dci_reg_at(0x00) = 0;
;;;1950       *lo = *dci_reg_at(0x00) & DCI_CR_RW_MASK;
;;;1951   
;;;1952       *dci_reg_at(0x00) = DCI_CR_RW_MASK;
;;;1953       *hi = *dci_reg_at(0x00) & DCI_CR_RW_MASK;
;;;1954   
;;;1955       *dci_reg_at(0x00) = 0;
;;;1956       return (*lo != *hi);
;;;1957   }
;;;1958   
;;;1959   /*
;;;1960    * Every register gets a distinct value, then all are read back. A single shared
;;;1961    * read-back value means the offsets alias onto one another - the signature of a
;;;1962    * decode problem or of pointing at the wrong block entirely.
;;;1963    */
;;;1964   static bool dci_regtest_distinct(void)
;;;1965   {
;;;1966       uint32_t i;
;;;1967       bool     ok = true;
;;;1968   
;;;1969       for (i = 0; i < DCI_REG_TBL_CNT; i++)
;;;1970       {
;;;1971           if (dci_reg_tbl[i].rw_mask != 0)
;;;1972           {
;;;1973               *dci_reg_at(dci_reg_tbl[i].offset) = (0x11111111UL * (i + 1)) &
;;;1974                                                    dci_reg_tbl[i].rw_mask;
;;;1975           }
;;;1976       }
;;;1977       for (i = 0; i < DCI_REG_TBL_CNT; i++)
;;;1978       {
;;;1979           uint32_t want;
;;;1980   
;;;1981           if (dci_reg_tbl[i].rw_mask == 0)
;;;1982           {
;;;1983               continue;
;;;1984           }
;;;1985           want = (0x11111111UL * (i + 1)) & dci_reg_tbl[i].rw_mask;
;;;1986           if ((*dci_reg_at(dci_reg_tbl[i].offset) & dci_reg_tbl[i].rw_mask) != want)
;;;1987           {
;;;1988               ok = false;
;;;1989           }
;;;1990       }
;;;1991       for (i = 0; i < DCI_REG_TBL_CNT; i++)
;;;1992       {
;;;1993           if (dci_reg_tbl[i].rw_mask != 0)
;;;1994           {
;;;1995               *dci_reg_at(dci_reg_tbl[i].offset) = 0;
;;;1996           }
;;;1997       }
;;;1998       return ok;
;;;1999   }
;;;2000   
;;;2001   /*
;;;2002    * ICR is write-1-only and RIS is read-only, so with no pixel activity RIS should
;;;2003    * stay 0 no matter what is written to ICR. MIS must equal RIS & IER - here 0 for
;;;2004    * any IER, which at least proves MIS is not stuck.
;;;2005    */
;;;2006   static void dci_regtest_int_paths(DCI_regtest_t *r)
;;;2007   {
;;;2008       uint32_t ier;
;;;2009   
;;;2010       DCI->IER = 0;
;;;2011       DCI->ICR = DCI_INT_ALL;
;;;2012       r->w1c_ok = ((DCI->RIS & DCI_INT_ALL) == 0);
;;;2013   
;;;2014       /* MIS = RIS & IER. Use the IER read-back rather than the value just written, so
;;;2015        * the comparison states the hardware rule instead of assuming the write stuck -
;;;2016        * IER's own writability is covered by the pattern test. */
;;;2017       DCI->IER  = DCI_INT_ALL;
;;;2018       ier       = DCI->IER & DCI_INT_ALL;
;;;2019       r->mis_ok = ((DCI->MIS & DCI_INT_ALL) == (DCI->RIS & ier));
;;;2020   
;;;2021       DCI->IER  = 0;
;;;2022       DCI->ICR  = DCI_INT_ALL;
;;;2023   }
;;;2024   
;;;2025   /*
;;;2026    * Settles TODO(verify) #11: the register table says CAPCNT's low 2 bits are
;;;2027    * force-cleared, while the dump example shows plain N-1 encoding. Write 1s and
;;;2028    * look.
;;;2029    */
;;;2030   static void dci_regtest_capcnt(DCI_regtest_t *r)
;;;2031   {
