;;;536    /*
;;;537     * A closed ring never presents LLP = 0, so transfer-complete can never fire and
;;;538     * the group-last block is the only completion signal. The LLP = 0 topologies are
;;;539     * the mirror image: Transfer fires and means the data exceeded the quota
;;;540     * (DESIGN.md 6.4).
;;;541     */
;;;542    static void dci_dma_int_config(void)
;;;543    {
;;;544        rtl_dci_dma_int_select(dci.dma.dma_channel_num, dci.ring_closed);
;;;545    }
