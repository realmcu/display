;;;1638   /*
;;;1639    * Swapping buffer addresses when nothing else moves is the common runtime change
;;;1640    * (an upper layer rotating a memory pool), so it skips the DCI reconfiguration
;;;1641    * entirely: ENABLE stays 1 and only the descriptor DARs move.
;;;1642    *
;;;1643    * Note the "no buffer held" requirement - this cannot be used to rotate snapshot
;;;1644    * buffers, because it is exactly unavailable while the application holds one. Use
;;;1645    * buf_count = 2 and the driver's own rotation for that (DESIGN.md 6.4).
;;;1646    */
