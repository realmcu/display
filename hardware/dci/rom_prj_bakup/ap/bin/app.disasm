;;;278                 s.err_count, s.resync_count, s.suspend_count, s.buf_overflow, s.seq);
;;;279    
;;;280        /*
;;;281         * frames_done may legitimately be one higher than asked for in continuous mode:
;;;282         * DCI_Capture_Stop() polls CAPTURE down to 0 with the interrupt still enabled, so a
;;;283         * frame that had already ended is still settled and counted. Fewer than expected is
;;;284         * always a fault; one extra is the stop boundary, not a lost frame.
;;;285         */
;;;286        if (s.frames_done < expect_frames)
;;;287        {
;;;288            DEMO_LOG("  frames_done %u, expected at least %u", s.frames_done,
;;;289                     (unsigned)expect_frames);
;;;290            return DEMO_FAIL_STATS;
;;;291        }
;;;292        if (s.ovr_count || s.err_count || s.resync_count || s.buf_overflow)
;;;293        {
;;;294            DEMO_LOG("  error counters are not clean");
;;;295            return DEMO_FAIL_STATS;
;;;296        }
;;;297        return DEMO_PASS;
;;;298    }
