;;;1167       {
;;;1168           return DCI_ERROR_INVALID_PARAM;
;;;1169       }
;;;1170   
;;;1171       /* CONTINUOUS always enters the closed ring at group 0; SNAPSHOT continues the
;;;1172        * rotation so the application can process one shot while the next is taken. */
