;;;111    /* CPU writes it, DMA reads it. Static and non-cacheable rather than allocated:
;;;112     * deterministic, no allocation failure path (DESIGN.md 6.5). */
;;;113    DCI_NONCACHE_SECTION static DCI_DMA_LLIDef dci_lli_ring[DCI_MAX_DESC];
