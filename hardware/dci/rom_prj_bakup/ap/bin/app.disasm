;;;847                err = dci.g.var_len ? DCI_ERROR_BUF_OVERFLOW : DCI_ERROR_FRAME_LONG;
;;;848            }
;;;849        }
;;;850        else
;;;851        {
;;;852            bytes = rtl_dci_dma_curr_dar(dci.dma.dma_channel_num) -
;;;853                    (uint32_t)dci.dma.buf[k];
;;;854            if (!dci.g.var_len && bytes < dci.g.frame_bytes)
;;;855            {
;;;856                /* spec 2.6 guarantees IT_FRAME even for a short frame, so this is
