;;;345    /**
;;;346     * @brief Configure the specified I2C interrupt.
;;;347     *
;;;348     * @param[in] I2Cx      Select the I2C peripheral, refer to @ref I2C_DECLARATION.
;;;349     * @param[in] I2C_IT    This parameter can be one of the following values, refer to @ref I2C_INTERRUPTS.
;;;350     *                      - I2C_INT_MST_ON_HOLD: When master Tx FIFO is empty and no stop bit command is issued, master will hold the SCL low.
;;;351     *                      - I2C_INT_GEN_CALL: Set only when a general call address is received and it is acknowledged.
;;;352     *                      - I2C_INT_START_DET: Indicates whether a START or RESTART condition has occurred on the I2C
;;;353     *                           interface regardless of whether I2C is operating in slave or master mode.
;;;354     *                      - I2C_INT_STOP_DET: Indicates whether a STOP condition has occurred on the I2C interface
;;;355     *                           regardless of whether I2C is operating in slave or master mode.
;;;356     *                      - I2C_INT_ACTIVITY: This bit captures I2C activity and stays set until it is cleared.
;;;357     *                      - I2C_INT_RX_DONE: When the I2C is acting as a slave-transmitter, this bit is set to 1 if the
;;;358     *                           master does not acknowledge a transmitted byte. This occurs on the last byte of the
;;;359     *                           transmission, indicating that the transmission is done.
;;;360     *                      - I2C_INT_TX_ABRT: This bit indicates if I2C as an I2C transmitter, is unable to complete the
;;;361     *                           intended actions on the contents of the transmit FIFO.
;;;362     *                      - I2C_INT_RD_REQ: This bit is set to 1 when acting as a slave and another I2C master is
;;;363     *                           attempting to read data.
;;;364     *                      - I2C_INT_TX_EMPTY: This bit is set to 1 when the transmit buffer is at or below the threshold value.
;;;365     *                      - I2C_INT_TX_OVER: Set during transmit if the transmit buffer is filled to Tx FIFO depth and
;;;366     *                           the processor attempts to issue another I2C command.
;;;367     *                      - I2C_INT_RX_FULL: Set when the receive buffer reaches or goes above the RX_TL threshold in the
;;;368     *                           IC_RX_TL register.
;;;369     *                      - I2C_INT_RX_OVER: Set if the receive buffer is completely filled to Rx FIFO depth and an
;;;370     *                           additional byte is received from an external I2C device.
;;;371     *                      - I2C_INT_RX_UNDER: Set if the processor attempts to read the receive buffer when it is empty by reading.
;;;372     * @param[in] NewState  Enable or disable the specified I2C interrupt.
;;;373     *                      This parameter can be one of the following values:
;;;374     *                      - ENABLE: Enable the specified I2C interrupt.
;;;375     *                      - DISABLE: Disable the specified I2C interrupt.
;;;376     */
;;;377    void I2C_INTConfig(I2C_TypeDef *I2Cx, uint16_t I2C_INT, FunctionalState NewState)
;;;378    {
;;;379        /* Check the parameters */
;;;380        assert_param(IS_I2C_ALL_PERIPH(I2Cx));
;;;381        assert_param(I2C_GET_INT(I2C_INT));
;;;382        assert_param(IS_FUNCTIONAL_STATE(NewState));
;;;383    
;;;384        if (NewState != DISABLE)
;;;385        {
;;;386            /* Enable the selected I2C interrupts */
;;;387            I2Cx->IC_INTR_MASK |= I2C_INT;
;;;388        }
;;;389        else
;;;390        {
;;;391            /* Disable the selected I2C interrupts */
;;;392            I2Cx->IC_INTR_MASK &= (uint16_t)~I2C_INT;
;;;393        }
;;;394    }
;;;395    
;;;396    /**
;;;397     * @brief Clear the specified I2C interrupt pending bit.
;;;398     *
;;;399     * @param[in] I2Cx    Select the I2C peripheral, refer to @ref I2C_DECLARATION.
