;;;47      *
;;;48      * Derived from the DMA's BLOCK_TS width, which is **16 bit on this SoC family**
;;;49      * (65535 words = 256 KB per block), not the 20 bit of the older parts. Worst legal
;;;50      * case is 2048x2048 at 2 bytes/pixel = 2,097,152 words, needing 33 blocks.
;;;51      *
;;;52      * The ring costs DCI_MAX_BUF * DCI_MAX_CHUNK * 20 bytes = 1320 bytes at 33, which is
;;;53      * the price of covering every resolution the spec allows. Common cases stay far
;;;54      * below: 320x240 needs 1, 466x466 needs 2, 640x480 needs 3, 1280x720 needs 8.
;;;55      */
;;;56     #define DCI_MAX_CHUNK               33
;;;57     #define DCI_MAX_DESC                (DCI_MAX_BUF * DCI_MAX_CHUNK)
;;;58     
;;;59     /**
;;;60      * \brief   Largest BLOCK_TS the DMA can be given, in source data items (words here).
;;;61      *
;;;62      * \note    Must match the SoC's DMA_CTLx_H block_ts field width. The SoC layer
;;;63      *          cross-checks this with a static assertion.
;;;64      */
;;;65     #define DCI_MAX_BLOCK_TS            65535UL
;;;66     #define DCI_MAX_PIXELS              2048        /*!< Non-JPEG max width/height. */
;;;67     /** \} */
;;;68     
