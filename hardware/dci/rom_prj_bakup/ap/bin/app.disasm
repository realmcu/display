;;;488    I2C_Status I2C_WaitForFIFO(I2C_TypeDef *I2Cx, uint32_t I2C_FLAG)
;;;489    {
;;;490        uint8_t index = I2C_GetIndex(I2Cx);
;;;491        uint32_t time_out_us = I2C_TimeOutUs[index];
;;;492        uint32_t start_timestamp_us = 0;
;;;493        uint32_t now_timestamp_us = 0;
;;;494    
;;;495        /* Wait until the FIFO condition selected by I2C_FLAG becomes true:
;;;496         * - TX: writable (TX FIFO Not Full, space available)
;;;497         * - RX: readable (RX FIFO Not Empty, data available)
;;;498         */
;;;499        start_timestamp_us = timestamp_get_us();
;;;500        while ((I2Cx->IC_STATUS & I2C_FLAG) == 0)
;;;501        {
;;;502            I2C_Status status = I2C_CheckAbortStatus(I2Cx);
;;;503            if (status != I2C_SUCCESS)
;;;504            {
;;;505                return status;
;;;506            }
;;;507    
;;;508            now_timestamp_us = timestamp_get_us();
;;;509            if ((uint32_t)(now_timestamp_us - start_timestamp_us) >= time_out_us)
;;;510            {
;;;511                return I2C_ERR_TIMEOUT;
;;;512            }
;;;513        }
;;;514    
;;;515        return I2C_CheckAbortStatus(I2Cx);
;;;516    }
;;;517    
;;;518    I2C_Status I2C_WaitTXIdle(I2C_TypeDef *I2Cx)
;;;519    {
;;;520        uint8_t index = I2C_GetIndex(I2Cx);
;;;521        uint32_t time_out_us = I2C_TimeOutUs[index];
;;;522        uint32_t start_timestamp_us = 0;
;;;523        uint32_t now_timestamp_us = 0;
;;;524    
;;;525        /* Wait until the transmit is fully completed:
;;;526         * - Bus becomes idle (ACTIVITY == 0)
;;;527         * - TX FIFO is empty (TFE == 1)
;;;528         */
;;;529        start_timestamp_us = timestamp_get_us();
;;;530        while (((I2Cx->IC_STATUS & I2C_FLAG_ACTIVITY) != 0) ||
;;;531               ((I2Cx->IC_STATUS & I2C_FLAG_TFE) == 0))
;;;532        {
;;;533            I2C_Status status = I2C_CheckAbortStatus(I2Cx);
;;;534            if (status != I2C_SUCCESS)
;;;535            {
;;;536                return status;
;;;537            }
;;;538    
;;;539            now_timestamp_us = timestamp_get_us();
;;;540            if ((uint32_t)(now_timestamp_us - start_timestamp_us) >= time_out_us)
;;;541            {
;;;542                return I2C_ERR_TIMEOUT;
;;;543            }
;;;544        }
;;;545    
;;;546        return I2C_SUCCESS;
;;;547    }
