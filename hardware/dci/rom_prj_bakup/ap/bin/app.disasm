;;;832         * gamble on finishing the reload inside the vertical blanking. Worst case is
;;;833         * one cleanly skipped frame instead of an overrun (DESIGN.md 9.4 step 1). */
;;;834        if (dci.mode == DCI_MODE_CONTINUOUS || over_quota)
;;;835        {
