;;;315        if (init->edm > DCI_EDM_10BIT || init->fcrc > DCI_FCRC_QUARTER ||
;;;316            init->bsm > DCI_BSM_2_OF_4 || init->sync > DCI_SYNC_EMBEDDED)
;;;317        {
;;;318            return DCI_ERROR_INVALID_PARAM;
