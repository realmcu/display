;;;77         assert_param(IS_GPIO_PIN(GPIO_InitStruct->GPIO_Pin));
;;;78         assert_param(IS_GPIO_DIR(GPIO_InitStruct->GPIO_Dir));
;;;79     #if (GPIO_SUPPORT_OUTPUT_MODE_SELECT == 1)
