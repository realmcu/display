;;;347            {
;;;348                return DCI_ERROR_SIZE;
;;;349            }
;;;350        }
;;;351    
;;;352        if (init->crop && (crop->w == 0 || crop->h == 0))
;;;353        {
;;;354            return DCI_ERROR_INVALID_PARAM;
;;;355        }
;;;356        /* Checked whenever a window is set, not only while CROP is on, so that
;;;357         * DCI_ConfigCrop() rejects a bad window at once instead of letting a later
