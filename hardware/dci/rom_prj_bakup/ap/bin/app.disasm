;;;317                 DEMO_NEEDS_SIGNAL ? "   [needs a live camera]" : "   [no camera needed]");
;;;318        DEMO_LOG(" buffers: %d", DEMO_FORCE_BUF_COUNT);
;;;319        DEMO_LOG(" fill   : %s", (dci_demo_on_busy_cfg() == DCI_ON_BUSY_OVERWRITE)
;;;320                 ? "OVERWRITE - keeps writing into a held buffer, may tear"
;;;321                 : "GATE - stops rather than overwrite a held buffer");
;;;322        DEMO_LOG(" irq    : FRAME/OVR/ERR on (always), VSYNC %s, LINE %s, per-frame log %s",
;;;323                 DCI_DEMO_IRQ_VSYNC ? "on" : "off",
;;;324                 DCI_DEMO_IRQ_LINE  ? "on" : "off",
;;;325                 DCI_DEMO_IRQ_LOG   ? "on" : "off");
;;;326        /*
;;;327         * The settings that used to be separate cases. Printed unconditionally, including the
;;;328         * defaults, because the whole point of the banner is that a log from another build
;;;329         * looks identical otherwise - and these four now decide what the run actually does.
;;;330         */
