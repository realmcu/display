;;;366    /**
;;;367     * @brief Enables or disables the specified IR interrupt.
;;;368     *
;;;369     * @param[in] IR_INT Specifies the IR interrupt to be enabled or disabled, refer to @ref IR_INTERRUPT.
;;;370     *            This parameter can be one of the following values:
;;;371     *            - IR_INT_TF_EMPTY: TX FIFO empty interrupt.
;;;372     *            - IR_INT_TF_LEVEL: TX FIFO threshold interrupt.
;;;373     *            - IR_INT_TF_OF: TX FIFO overflow interrupt.
;;;374     *            - IR_INT_TX_FINISH: TX finish interrupt.
;;;375     *            - IR_INT_RF_FULL: RX FIFO full interrupt.
;;;376     *            - IR_INT_RF_LEVEL: RX FIFO threshold interrupt.
;;;377     *            - IR_INT_RX_CNT_OF: RX counter overflow interrupt.
;;;378     *            - IR_INT_RF_OF: RX FIFO overflow interrupt.
;;;379     *            - IR_INT_RX_CNT_THR: RX counter threshold interrupt.
;;;380     *            - IR_INT_RF_ERROR: RX FIFO error read interrupt. Trigger when RX FIFO empty and read RX FIFO.
;;;381     *            - IR_INT_RISING_EDGE: IR RX rising edge interrupt.
;;;382     *            - IR_INT_FALLING_EDGE: IR RX falling edge interrupt.
;;;383     * @param[in] NewState New state of the specified IR interrupt.
;;;384     *            - ENABLE: Enable the specified IR interrupt.
;;;385     *            - DISABLE: Disable the specified IR interrupt.
;;;386     */
;;;387    void IR_INTConfig(uint32_t IR_INT, FunctionalState NewState)
;;;388    {
;;;389        /* Check the parameters */
;;;390        assert_param(IS_IR_INT_CONFIG(IR_INT));
;;;391        assert_param(IS_FUNCTIONAL_STATE(NewState));
;;;392    
;;;393        IR_TX_CONFIG_TypeDef ir_0x04 = {.d32 = IR->IR_TX_CONFIG};
;;;394        if (NewState == ENABLE)
;;;395        {
;;;396            /* Enable the selected IR interrupts in RX mode */
;;;397            if (ir_0x04.b.ir_mode_sel)
;;;398            {
;;;399                /* Handle RX Edge Interrupts (Rising/Falling), require specific offset shifting*/
;;;400                if (IR_INT & (IR_INT_RISING_EDGE | IR_INT_FALLING_EDGE))
;;;401                {
;;;402                    IR->IR_RX_EX_INT |= ((IR_INT & (IR_INT_RISING_EDGE | IR_INT_FALLING_EDGE)) >>
;;;403                                         IR_RX_EXTENSION_INT_OFFSET);
;;;404                }
;;;405                /* Handle Normal RX Interrupts. Exclude edge interrupts to prevent writing incorrect bits to this register. */
;;;406                if ((IR_INT & (~(IR_INT_RISING_EDGE | IR_INT_FALLING_EDGE))) != 0)
;;;407                {
;;;408                    IR->IR_RX_CONFIG |= (IR_INT & (~(IR_INT_RISING_EDGE | IR_INT_FALLING_EDGE)));
;;;409                }
;;;410            }
;;;411            /* Enable the selected IR interrupts in TX mode */
;;;412            else
;;;413            {
;;;414    #if (IR_SUPPORT_TX_FINISH_INTERRUPT == 1)
;;;415                /* Handle TX Finish Interrupt */
;;;416                if (IR_INT & IR_INT_TX_FINISH)
;;;417                {
;;;418                    IR->IR_TX_SR |= IR_INT_TX_FINISH;
;;;419                }
;;;420                /* Handle Normal TX Interrupts. Exclude IR_INT_TX_FINISH to avoid writing it to the wrong register. */
;;;421                if ((IR_INT & (~IR_INT_TX_FINISH)) != 0)
;;;422                {
;;;423                    /* Enable the selected IR interrupts in TX mode */
;;;424                    IR->IR_TX_CONFIG |= (IR_INT & (~IR_INT_TX_FINISH));
;;;425                }
;;;426    #else
;;;427                /* Handle TX Interrupts. */
;;;428                IR->IR_TX_CONFIG |= IR_INT;
;;;429    #endif
;;;430            }
;;;431        }
;;;432        else
;;;433        {
;;;434            /* Disable the selected IR interrupts in RX mode */
;;;435            if (ir_0x04.b.ir_mode_sel)
;;;436            {
;;;437                /* Disable RX Edge Interrupts */
;;;438                if (IR_INT & (IR_INT_RISING_EDGE | IR_INT_FALLING_EDGE))
;;;439                {
;;;440                    IR->IR_RX_EX_INT &= ~((IR_INT & (IR_INT_RISING_EDGE | IR_INT_FALLING_EDGE)) >>
;;;441                                          IR_RX_EXTENSION_INT_OFFSET);
;;;442                }
;;;443                /* Disable Normal RX Interrupts. Exclude edge interrupts before writing to IR_RX_CONFIG */
;;;444                if ((IR_INT & (~(IR_INT_RISING_EDGE | IR_INT_FALLING_EDGE))) != 0)
;;;445                {
;;;446                    IR->IR_RX_CONFIG &= ~(IR_INT & (~(IR_INT_RISING_EDGE | IR_INT_FALLING_EDGE)));
;;;447                }
;;;448            }
;;;449            /* Disable the selected IR interrupts in TX mode */
;;;450            else
;;;451            {
;;;452    #if (IR_SUPPORT_TX_FINISH_INTERRUPT == 1)
;;;453                /* Disable TX Finish Interrupt */
;;;454                if (IR_INT & IR_INT_TX_FINISH)
;;;455                {
;;;456                    IR->IR_TX_SR &= ~IR_INT_TX_FINISH;
;;;457                }
;;;458                /* Disable/Clear Normal TX Interrupts. Exclude IR_INT_TX_FINISH before writing to IR_TX_CONFIG */
;;;459                if ((IR_INT & (~IR_INT_TX_FINISH)) != 0)
;;;460                {
;;;461                    IR->IR_TX_CONFIG &= ~(IR_INT & (~IR_INT_TX_FINISH));
;;;462                }
;;;463    #else
;;;464                /* Disable TX Interrupts */
;;;465                IR->IR_TX_CONFIG &= (~IR_INT);
;;;466    #endif
;;;467            }
;;;468        }
;;;469    }
