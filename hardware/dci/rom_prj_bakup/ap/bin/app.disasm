;;;924    /**
;;;925     * @brief Check whether the last I2Cx event is equal to the one passed as parameter.
;;;926     *
;;;927     * @param[in] I2Cx       Select the I2C peripheral, refer to @ref I2C_DECLARATION.
;;;928     * @param[in] I2C_EVENT  Specify the event to be checked about I2C transmit abort status.
;;;929     *                       This parameter can be one of the following values, refer to @ref I2C_TRANSMIT_ABORT_SOURCE.
;;;930     *                       - ABRT_SLVRD_INTX: When the processor side responds to a slave mode request for data to be transmitted to a remote master and user send read command.
;;;931     *                       - ABRT_SLV_ARBLOST: Slave lost the bus while transmitting data to a remote master.
;;;932     *                       - ABRT_SLVFLUSH_TXFIFO: Slave has received a read command and some data exists in the Tx FIFO so the slave issues an I2C_INT_TX_ABRT interrupt to flush old data in Tx FIFO.
;;;933     *                       - ARB_LOST: Master has lost arbitration or the slave transmitter has lost arbitration.
;;;934     *                       - ABRT_MASTER_DIS: User tries to initiate a master operation with the master mode disabled.
;;;935     *                       - ABRT_10B_RD_NORSTRT: The restart is disabled and the master sends a read command in 10-bit address mode.
;;;936     *                       - ABRT_SBYTE_NORSTRT: The restart is disabled and the user is trying to send a START byte.
;;;937     *                       - ABRT_HS_NORSTRT: The restart is disabled and the user is trying to use the master to transfer data in High Speed mode.
;;;938     *                       - ABRT_SBYTE_ACKDET: Master has sent a START byte and the START byte was acknowledged (wrong behavior).
;;;939     *                       - ABRT_HS_ACKDET: Master is in High Speed mode and the High Speed master code was acknowledged (wrong behavior).
;;;940     *                       - ABRT_GCALL_READ: Sent a general call but the user programmed the byte following the general call to be a read from the bus.
;;;941     *                       - ABRT_GCALL_NOACK: Sent a general call and no slave on the bus acknowledged the general call.
;;;942     *                       - ABRT_TXDATA_NOACK: Master sent data byte(s) following the address, it did not receive an acknowledge from the remote slave.
;;;943     *                       - ABRT_10ADDR2_NOACK: Master is in 10-bit address mode and the second address byte of the 10-bit address was not acknowledged by any slave.
;;;944     *                       - ABRT_10ADDR1_NOACK: Master is in 10-bit address mode and the first 10-bit address byte was not acknowledged by any slave.
;;;945     *                       - ABRT_7B_ADDR_NOACK: Master is in 7-bit address mode and the address sent was not acknowledged by any slave.
;;;946     *
;;;947     * @return The status of I2C event (SET or RESET).
;;;948     * @retval SET    The last I2C event matches the specified event.
;;;949     * @retval RESET  The last I2C event does not match the specified event.
;;;950     */
;;;951    FlagStatus I2C_CheckEvent(I2C_TypeDef *I2Cx, uint32_t I2C_EVENT)
;;;952    {
;;;953        FlagStatus bit_status = RESET;
;;;954    
;;;955        /* Check the parameters */
;;;956        assert_param(IS_I2C_ALL_PERIPH(I2Cx));
;;;957        assert_param(IS_I2C_EVENT(I2C_EVENT));
;;;958    
;;;959        if ((I2Cx->IC_TX_ABRT_SOURCE & I2C_EVENT) != (uint32_t)RESET)
;;;960        {
;;;961    
;;;962            bit_status = SET;
;;;963        }
;;;964    
;;;965        /* Return the I2C event status */
;;;966        return  bit_status;
;;;967    }
