;;;628    /**
;;;629     * @brief Clear the specified SPI interrupt pending bit.
;;;630     *
;;;631     * @param[in] SPIx  Select the SPI peripheral, refer to @ref SPI_DECLARATION.
;;;632     * @param[in] SPI_IT  Specifies the SPI interrupt to clear.
;;;633     *            This parameter can be one of the following values, refer to @ref SPI_INTERRUPT.
;;;634     *            - SPI_INT_TXO: Transmit FIFO overflow interrupt.
;;;635     *            - SPI_INT_RXO: Receive FIFO overflow interrupt.
;;;636     *            - SPI_INT_RXU: Receive FIFO underflow interrupt.
;;;637     *            - SPI_INT_MST: Multi-master contention interrupt. (master only)
;;;638     *            - SPI_INT_FAE: The data of slave RX does not match DFS. (slave only)
;;;639     *            - SPI_INT_TUF: Transmit FIFO underflow interrupt. (slave only)
;;;640     *            - SPI_INT_RIG: CS rising edge detect interrupt. (slave only)
;;;641     */
;;;642    void SPI_ClearINTPendingBit(SPI_TypeDef *SPIx, uint16_t SPI_IT)
;;;643    {
;;;644        /* Check the parameters */
;;;645        assert_param(IS_SPI_ALL_PERIPH(SPIx));
;;;646        assert_param(IS_SPI_CONFIG_IT(SPI_IT));
;;;647    
;;;648        if (SPI_IT & SPI_INT_TXO)
;;;649        {
;;;650            (void)SPIx->SPI_TXOICR;
;;;651        }
;;;652    
;;;653        if (SPI_IT & SPI_INT_RXO)
;;;654        {
;;;655            (void)SPIx->SPI_RXOICR;
;;;656        }
;;;657    
;;;658        if (SPI_IT & SPI_INT_RXU)
;;;659        {
;;;660            (void)SPIx->SPI_RXUICR;
;;;661        }
;;;662    
;;;663        if (SPI_IT & SPI_INT_FAE)
;;;664        {
;;;665            (void)SPIx->SPI_M_S_MSTICR_FAEICR;
;;;666        }
;;;667    
;;;668        if (SPI_IT & SPI_INT_TUF)
;;;669        {
;;;670            (void)SPIx->SPI_M_S_IDR_TXUICR;
;;;671        }
;;;672    
;;;673        if (SPI_IT & SPI_INT_RIG)
;;;674        {
;;;675            (void)SPIx->SPI_M_S_VERSION_ID_SSRICR;
;;;676        }
;;;677    
;;;678    #if (SPI_SUPPORT_WRAP_MODE == 1)
;;;679        if (SPI_IT & (SPI_INT_WRAP_TXD | SPI_INT_WRAP_TXO))
