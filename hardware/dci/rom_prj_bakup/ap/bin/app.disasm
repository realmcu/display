;;;2227   /* Raw hex is not enough on its own; the N-1 encoded fields print both forms. */
;;;2228   void DCI_DumpSnapshot(const DCI_snapshot_t *snap)
;;;2229   {
;;;2230       DCI_CR_TypeDef     cr;
;;;2231       DCI_SR_TypeDef     sr;
