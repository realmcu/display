;;;412    
;;;413    /*============================================================================*
;;;414     *                         Overlay
;;;415     *============================================================================*/
;;;416    /*
;;;417     * The overlay is compile-time, so it is read once here rather than threaded through
;;;418     * every case. Crop dimensions are expressed as a percentage of the row rather than in
;;;419     * absolute pixels: the table spans 160x120 to 800x600, and an absolute window would be
;;;420     * meaningless on one end or out of bounds on the other. Percentages make a single
;;;421     * macro setting valid on every row.
;;;422     */
;;;423    static void dci_demo_overlay_apply(dci_demo_cfg_t *c)
;;;424    {
;;;425        const dci_demo_signal_t *s = c->sig;
;;;426    
;;;427        (void)s;                    /* only read by the crop branches below */
;;;428    
;;;429        c->fcrc = (DCI_FCRC_T)DCI_DEMO_OV_FCRC;
;;;430        c->bsm  = (DCI_BSM_T)DCI_DEMO_OV_BSM;
;;;431        c->oebs = (DCI_DEMO_OV_OEBS != 0);
;;;432        c->lsm  = (DCI_DEMO_OV_LSM  != 0);
;;;433        c->oels = (DCI_DEMO_OV_OELS != 0);
;;;434    
;;;435    #if (DCI_DEMO_OV_CROP == DCI_DEMO_CROP_OFF)
;;;436        c->crop_en = false;
;;;437    #else
;;;438        c->crop_en = true;
;;;439    #if   (DCI_DEMO_OV_CROP == DCI_DEMO_CROP_CENTER)
;;;440        /* Half in each axis, centred: the ordinary case, and the one where a
;;;441         * transposed x/y or w/h shows up as a shifted window rather than a failure. */
;;;442        c->crop_w = (uint16_t)(s->width  / 2);
;;;443        c->crop_h = (uint16_t)(s->height / 2);
;;;444        c->crop_x = (uint16_t)(s->width  / 4);
;;;445        c->crop_y = (uint16_t)(s->height / 4);
;;;446    #elif (DCI_DEMO_OV_CROP == DCI_DEMO_CROP_ORIGIN)
;;;447        /* The x0 = y0 = 0 boundary. Worth its own setting because an off-by-one in
;;;448         * the N-1 window encoding is invisible when the window starts in the middle. */
;;;449        c->crop_w = (uint16_t)(s->width  / 5);
;;;450        c->crop_h = (uint16_t)(s->height / 5);
;;;451        c->crop_x = 0;
;;;452        c->crop_y = 0;
;;;453    #elif (DCI_DEMO_OV_CROP == DCI_DEMO_CROP_FULL)
;;;454        /* The whole frame, cropping enabled. Should be byte-identical to crop off:
;;;455         * isolates "the window is wrong" from "enabling CROP at all is wrong". */
;;;456        c->crop_w = s->width;
;;;457        c->crop_h = s->height;
;;;458        c->crop_x = 0;
;;;459        c->crop_y = 0;
;;;460    #else
;;;461    #error "DCI_DEMO_OV_CROP is not one of DCI_DEMO_CROP_*"
;;;462    #endif
;;;463    #endif /* DCI_DEMO_OV_CROP */
;;;464    }
;;;465    
;;;466    /*============================================================================*
;;;467     *                         Geometry
;;;468     *============================================================================*/
;;;469    /*
;;;470     * Mirrors dci_calc_geometry() in rtl_dci.c, from the table row instead of from
;;;471     * DCI_InitTypeDef. Same order, same rounding:
;;;472     *
;;;473     *   line_bytes = pclk_per_line x bytes_per_pclk     (crop replaces pclk_per_line)
;;;474     *   line_bytes = line_bytes / bsm_den x bsm_num     (byte select)
;;;475     *   lines_out  = lsm ? (oels ? h/2 : ceil(h/2)) : h (line select)
;;;476     *
;;;477     * Byte select is the subtle one: the group has to divide the line exactly. The driver
;;;478     * refuses it otherwise rather than rounding (dci_demo_bsm_divides() below), so the
;;;479     * division here is only ever exact - if it truncated, the cross-check against
;;;480     * DCI_Capture_GetFrameInfo() would fire on the next line of output.
;;;481     */
;;;482    static void dci_demo_bsm_ratio(DCI_BSM_T bsm, uint32_t *num, uint32_t *den)
;;;483    {
;;;484        switch (bsm)
;;;485        {
;;;486        case DCI_BSM_EVERY_2ND: *num = 1; *den = 2; break;
;;;487        case DCI_BSM_1_OF_4:    *num = 1; *den = 4; break;
;;;488        case DCI_BSM_2_OF_4:    *num = 2; *den = 4; break;
;;;489        default:                *num = 1; *den = 1; break;
;;;490        }
;;;491    }
;;;492    
;;;493    /*
;;;494     * Whether the byte-select group divides the line evenly, which the driver requires:
;;;495     * dci_calc_geometry() returns INVALID_PARAM on (line_bytes % bsm_den) != 0, because a
;;;496     * partial group at the end of a line would shift every line after it.
;;;497     *
;;;498     * Both geometries have to divide, not just the one that gets delivered. Capture_Init()
;;;499     * measures the uncropped line, and DCI_CropCmd() then re-runs the same arithmetic on the
;;;500     * window - so a row can be refused at Init and never reach the crop at all. The window
;;;501     * always divides in practice, since DCI_ConfigCrop() aligns its width down to 4 pclk, but
;;;502     * that is a property of the driver rather than of this table, so it is checked rather
;;;503     * than assumed.
;;;504     *
;;;505     * 466-raw8 is the row this exists for: 466 bytes per line is even but not a multiple of
;;;506     * 4, so 1-of-2 is legal there and 1-of-4 and 2-of-4 are not.
;;;507     */
;;;508    static bool dci_demo_bsm_divides(const dci_demo_cfg_t *c, uint32_t *bad_line,
;;;509                                     uint32_t *den_out)
;;;510    {
;;;511        uint32_t num, den;
;;;512        uint32_t full = (uint32_t)c->pclk_per_line * c->bytes_per_pclk;
;;;513    
;;;514        dci_demo_bsm_ratio(c->bsm, &num, &den);
;;;515        *den_out = den;
;;;516        (void)num;
;;;517    
;;;518        if ((full % den) != 0)
;;;519        {
;;;520            *bad_line = full;
;;;521            return false;
;;;522        }
;;;523        if (c->crop_en)
;;;524        {
;;;525            uint32_t win = (uint32_t)c->crop_pclk_w * c->bytes_per_pclk;
;;;526    
;;;527            if ((win % den) != 0)
;;;528            {
;;;529                *bad_line = win;
;;;530                return false;
;;;531            }
;;;532        }
;;;533        return true;
;;;534    }
;;;535    
;;;536    static void dci_demo_cfg_derive(dci_demo_cfg_t *c)
;;;537    {
;;;538        const dci_demo_signal_t *s = c->sig;
;;;539        uint8_t  ppp = dci_demo_fmt_pclk_per_pixel(s->fmt);
;;;540        uint32_t num, den;
;;;541        uint32_t pclk;
;;;542        uint16_t lines;
;;;543    
;;;544        c->bytes_per_pclk = (s->fmt == DCI_FMT_RAW10) ? 2 : 1;
;;;545        c->pclk_per_line  = (uint16_t)(s->width * ppp);
;;;546        c->lines_in       = s->height;
;;;547    
;;;548        /* Crop is programmed in pixel clocks, and RAW10 is where that stops being a
;;;549         * formality. Align the width down exactly as DCI_ConfigCrop() will, so the
;;;550         * printed configuration is what the hardware ends up with rather than what was
;;;551         * asked for. */
;;;552        c->crop_pclk_x = (uint16_t)(c->crop_x * ppp);
;;;553        c->crop_pclk_w = (uint16_t)((c->crop_w * ppp) & ~0x3U);
;;;554    
;;;555        if (s->fmt == DCI_FMT_JPEG)
;;;556        {
;;;557            /* No frame size exists. The buffer cap is the only number, and the demo
;;;558             * must not pretend to know more than that. */
;;;559            c->line_bytes  = 0;
;;;560            c->lines_out   = 0;
;;;561            c->frame_bytes = 0;
;;;562            c->init_bytes  = DCI_DEMO_JPEG_CAP_KB * 1024UL;
;;;563            return;
;;;564        }
;;;565    
;;;566        pclk  = c->crop_en ? c->crop_pclk_w : c->pclk_per_line;
;;;567        lines = c->crop_en ? c->crop_h      : c->lines_in;
;;;568    
;;;569        dci_demo_bsm_ratio(c->bsm, &num, &den);
;;;570        c->line_bytes = pclk * c->bytes_per_pclk;
;;;571        c->line_bytes = c->line_bytes / den * num;
;;;572    
;;;573        c->lines_out = c->lsm ? (c->oels ? (uint16_t)(lines / 2)
;;;574                                 : (uint16_t)((lines + 1) / 2))
;;;575                       : lines;
;;;576    
;;;577        c->frame_bytes = c->line_bytes * c->lines_out;
;;;578    
;;;579        /*
;;;580         * What Capture_Init() will validate against, which is not what will be delivered
;;;581         * when cropping. Init sees only DCI_InitTypeDef - the window arrives later via
;;;582         * DCI_ConfigCrop() - so it measures the UNCROPPED frame and rejects a buffer
;;;583         * sized for the cropped one with BUF_TOO_SMALL. Allocating for the larger of the
;;;584         * two is the whole reason this field is separate from frame_bytes.
;;;585         */
;;;586        if (c->crop_en)
;;;587        {
;;;588            uint32_t full_line = (uint32_t)c->pclk_per_line * c->bytes_per_pclk / den * num;
;;;589            uint16_t full_out  = c->lsm ? (c->oels ? (uint16_t)(c->lines_in / 2)
;;;590                                           : (uint16_t)((c->lines_in + 1) / 2))
;;;591                                 : c->lines_in;
;;;592            c->init_bytes = full_line * full_out;
;;;593        }
;;;594        else
;;;595        {
;;;596            c->init_bytes = c->frame_bytes;
;;;597        }
;;;598    }
;;;599    
;;;600    /*============================================================================*
;;;601     *                         Resolve
;;;602     *============================================================================*/
;;;603    bool dci_demo_cfg_resolve(uint8_t index, dci_demo_cfg_t *out)
;;;604    {
;;;605        const dci_demo_signal_t *s = dci_demo_signal_get(index);
;;;606    
;;;607        if (out == NULL)
;;;608        {
;;;609            return false;
;;;610        }
;;;611        memset(out, 0, sizeof(*out));
;;;612    
;;;613        if (s == NULL)
;;;614        {
;;;615            DEMO_LOG("[CFG] signal %u does not exist (have %u)", index,
;;;616                     dci_demo_signal_count());
;;;617            return false;
;;;618        }
;;;619        out->sig   = s;
;;;620        out->index = index;
;;;621    
;;;622        dci_demo_overlay_apply(out);
;;;623    
;;;624        /*
;;;625         * Rules, in two groups. The first three the driver would refuse anyway; catching
;;;626         * them here means the message names the macro that has to change instead of
;;;627         * surfacing as MODE_CONFLICT from Capture_Init with no hint which of four rules
;;;628         * tripped.
;;;629         */
;;;630        if (out->crop_en && s->fmt == DCI_FMT_JPEG)
;;;631        {
;;;632            DEMO_LOG("[CFG] %s: crop and JPEG are mutually exclusive (spec 2.7)", s->name);
;;;633            DEMO_LOG("      -> set DCI_DEMO_OV_CROP to DCI_DEMO_CROP_OFF, or pick "
;;;634                     "another signal row");
;;;635            return false;
;;;636        }
;;;637        if (out->bsm != DCI_BSM_ALL && s->fmt == DCI_FMT_RAW10)
;;;638        {
;;;639            DEMO_LOG("[CFG] %s: byte select needs EDM=8BIT, this row is 10-bit", s->name);
;;;640            DEMO_LOG("      -> DCI_DEMO_OV_BSM must be DCI_BSM_ALL on a RAW10 row");
;;;641            return false;
;;;642        }
;;;643        if (s->sync == DCI_SYNC_EMBEDDED && s->fmt == DCI_FMT_RAW10)
;;;644        {
;;;645            /* Not reachable from the table as written - no row is both - but the check
;;;646             * belongs here rather than in a comment, because adding such a row is a
;;;647             * plausible mistake and this is where it would be caught. */
;;;648            DEMO_LOG("[CFG] %s: embedded sync is 8-bit only (spec 2.4)", s->name);
;;;649            return false;
;;;650        }
;;;651    
;;;652        /*
;;;653         * The second group is the dangerous one: the driver ACCEPTS these, the geometry
;;;654         * computes, the capture reports no error, and the image is quietly wrong.
;;;655         *
;;;656         * Byte select drops bytes. At 1 byte per pixel that is "drop pixels"; at 2 bytes
;;;657         * per pixel it takes one byte out of each pixel and leaves a buffer full of half
;;;658         * pixels. DCI has no concept of a pixel and so cannot possibly refuse it - this
;;;659         * check is the only thing standing between the macro and a corrupt frame that
;;;660         * looks like a hardware fault.
;;;661         */
;;;662        if (out->bsm != DCI_BSM_ALL && s->fmt == DCI_FMT_JPEG)
;;;663        {
;;;664            /* Before the bytes-per-pixel rule below, which would report JPEG as a
;;;665             * "0-byte/pixel format" - true of the table entry, meaningless as a diagnosis.
;;;666             * Dropping bytes out of an entropy-coded stream does not decimate it, it
;;;667             * destroys it from the first dropped byte onwards. */
;;;668            DEMO_LOG("[CFG] %s: byte select on a JPEG stream corrupts it from the first "
;;;669                     "dropped byte on", s->name);
;;;670            DEMO_LOG("      -> set DCI_DEMO_OV_BSM to 0 on a JPEG row");
;;;671            return false;
;;;672        }
;;;673        if (out->bsm != DCI_BSM_ALL && dci_demo_fmt_bytes_per_pixel(s->fmt) != 1)
;;;674        {
;;;675            DEMO_LOG("[CFG] %s: byte select on a %u-byte/pixel format would keep part "
;;;676                     "of every pixel", s->name, dci_demo_fmt_bytes_per_pixel(s->fmt));
;;;677            DEMO_LOG("      the driver would ACCEPT this and the frame would be corrupt "
;;;678                     "with no error reported");
;;;679            DEMO_LOG("      -> byte select belongs on a 1-byte/pixel row: null-min, "
;;;680                     "qvga-raw8, or 466-raw8 at setting 1");
;;;681            return false;
;;;682        }
;;;683        if (out->fcrc != DCI_FCRC_ALL && s->fmt == DCI_FMT_JPEG)
;;;684        {
;;;685            /* Legal, but frame rate control drops whole frames and JPEG frames end by
;;;686             * content: dropping one mid-stream is not distinguishable from a truncated
;;;687             * one. Refuse rather than produce an unreadable result. */
;;;688            DEMO_LOG("[CFG] %s: frame rate control on JPEG makes a dropped frame "
;;;689                     "indistinguishable from a truncated one", s->name);
;;;690            return false;
;;;691        }
;;;692    
;;;693        dci_demo_cfg_derive(out);
;;;694    
;;;695        /*
;;;696         * The one byte-select rule that needs the derived line length. Unlike the rules
;;;697         * above, the driver does refuse this - but it refuses it as INVALID_PARAM out of
;;;698         * Capture_Init, alongside a null lines_out, a zero-length line and four unrelated
;;;699         * parameter faults. Naming the line length and the group size here is the difference
;;;700         * between "change DCI_DEMO_OV_BSM" and reading dci_calc_geometry().
;;;701         */
;;;702        if (out->bsm != DCI_BSM_ALL)
;;;703        {
;;;704            uint32_t bad_line, den;
;;;705    
;;;706            if (!dci_demo_bsm_divides(out, &bad_line, &den))
;;;707            {
;;;708                DEMO_LOG("[CFG] %s: %u B/line is not a multiple of the %u-byte select "
;;;709                         "group", s->name, (unsigned)bad_line, (unsigned)den);
;;;710                DEMO_LOG("      a partial group at the end of a line would shift every "
;;;711                         "line after it, so the driver refuses it (INVALID_PARAM)");
;;;712                DEMO_LOG("      -> DCI_DEMO_OV_BSM 1 (one of two) divides this row; 2 and "
;;;713                         "3 need a line length that is a multiple of 4");
;;;714                return false;
;;;715            }
;;;716        }
;;;717    
;;;718        /* Only reachable through the crop macros; a 0-pclk window after aligning down
;;;719         * would be rejected by ConfigCrop, so say which macro produced it. */
