;;;355    /*============================================================================*
;;;356     *                         Test environment
;;;357     *============================================================================*/
;;;358    /*
;;;359     * Board bring-up writes that are NOT part of the DCI driver, which is why they live
;;;360     * here and not in rtl_dci_int.c: the driver configures DCI, while this opens up the
;;;361     * environment DCI needs to exist in on this bring-up platform.
;;;362     *
;;;363     * Transcribed from the JLink sequence used to bring the part up by hand:
;;;364     *
;;;365     *     w4 0x40701080, 0xFFFFFFFF
;;;366     *     w4 0x40701084, 0xFFFFFFFF
;;;367     *     w4 0x40701088, 0xFFFFFFFF
;;;368     *     w4 0x4070108C, 0xFFFFFFFF
;;;369     *     w4 0x40701090, 0xFFFFFFFF
;;;370     *
;;;371     * Five consecutive 32-bit words, all ones. Kept as the literal addresses the JLink
;;;372     * script uses rather than being dressed up as named registers: no register table for
;;;373     * this block has been seen, so inventing names would assert more than is known. When
;;;374     * that table turns up, name them and say what the bits do.
;;;375     *
;;;376     * Idempotent and side-effect free as far as DCI is concerned, so it is safe to call
;;;377     * from every case, including the ones that never touch a pixel.
;;;378     */
;;;379    /*
;;;380     * Overridable so the host-side build can point it at plain RAM. On target it is the
;;;381     * literal address; nothing else should ever redefine it.
;;;382     */
;;;383    #ifndef DEMO_ENV_REG_FIRST
;;;384    #define DEMO_ENV_REG_FIRST      0x40701080UL
;;;385    #endif
;;;386    #define DEMO_ENV_REG_COUNT      5U
;;;387    
;;;388    void dci_demo_env_init(void)
;;;389    {
;;;390        uint32_t i;
;;;391        uint32_t stuck = 0;
;;;392    
;;;393        DEMO_LOG("[ENV] 0x%08X..0x%08X <- 0xFFFFFFFF (%u words)",
;;;394                 (unsigned)DEMO_ENV_REG_FIRST,
;;;395                 (unsigned)(DEMO_ENV_REG_FIRST + (DEMO_ENV_REG_COUNT - 1U) * 4U),
;;;396                 (unsigned)DEMO_ENV_REG_COUNT);
;;;397    
;;;398        for (i = 0; i < DEMO_ENV_REG_COUNT; i++)
;;;399        {
;;;400            *(volatile uint32_t *)(DEMO_ENV_REG_FIRST + i * 4U) = 0xFFFFFFFFUL;
;;;401        }
;;;402    
;;;403        /*
;;;404         * Read back and report, because up to now this block was written blind.
;;;405         *
;;;406         * These five words are the platform enables this bring-up depends on, and nothing
;;;407         * downstream can work if they did not take. A write to an ungated-but-absent block,
;;;408         * or to one whose own clock is off, is silently dropped on this bus - so "the log
;;;409         * printed [ENV]" has never actually proven the writes landed.
;;;410         *
;;;411         * Not all-ones is NOT automatically a fault: these are unknown bits with no register
;;;412         * table, so some are very likely read-only, reserved or write-1-to-clear, and reading
;;;413         * back something else is expected for those. What matters is the all-zero case: a word
;;;414         * that reads 0 right after 0xFFFFFFFF was written to it means the write went nowhere,
;;;415         * and that is a finding rather than a curiosity.
;;;416         */
;;;417        for (i = 0; i < DEMO_ENV_REG_COUNT; i++)
;;;418        {
;;;419            uint32_t v = *(volatile uint32_t *)(DEMO_ENV_REG_FIRST + i * 4U);
;;;420    
;;;421            DEMO_LOG("      [%u] 0x%08X -> reads 0x%08X%s", (unsigned)i,
;;;422                     (unsigned)(DEMO_ENV_REG_FIRST + i * 4U), (unsigned)v,
;;;423                     (v == 0xFFFFFFFFUL) ? "  (took)" :
;;;424                     ((v == 0U) ? "  <- READS ZERO: write did not land" : "  (partial)"));
;;;425    
;;;426            if (v == 0U)
;;;427            {
;;;428                stuck++;
;;;429            }
;;;430        }
;;;431    
;;;432        if (stuck != 0)
;;;433        {
;;;434            DEMO_LOG("      *** %u of %u env words read back 0 after writing all-ones.",
;;;435                     (unsigned)stuck, (unsigned)DEMO_ENV_REG_COUNT);
;;;436            DEMO_LOG("      The writes are NOT reaching this block, so whatever it enables");
;;;437            DEMO_LOG("      is still off. Everything downstream - including any external");
;;;438            DEMO_LOG("      pin or clock it gates - has to be treated as unconfigured.");
;;;439        }
;;;440    }
