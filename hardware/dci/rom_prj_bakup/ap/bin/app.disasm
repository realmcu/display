;;;1545       }
;;;1546   
;;;1547       /* on_busy, notify_mode and the callback pointers map to no register and do
;;;1548        * not move the ring, so changing only those must not cost a frame. */
;;;1549       if (memcmp(&cand_init, &dci.init, sizeof(cand_init)) == 0 &&
;;;1550           memcmp(&cand_crop, &dci.crop, sizeof(cand_crop)) == 0 &&
;;;1551           !dci_dma_hw_differs(&cand_dma, &dci.dma))
