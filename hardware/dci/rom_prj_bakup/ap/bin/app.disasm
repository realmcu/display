;;;579    
;;;580    /*
;;;581     * One group of chunks_per_frame descriptors per buffer. CONTINUOUS links the
;;;582     * groups head to tail into a closed ring so the hardware switches buffers on its
;;;583     * own; SNAPSHOT leaves each group ending at LLP = 0 so the channel stops dead
;;;584     * and can be reloaded from a known state on the next Start().
;;;585     */
;;;586    static void dci_build_ring(void)
;;;587    {
;;;588        uint8_t  ch       = dci.dma.dma_channel_num;
;;;589        uint32_t ctl_lli  = rtl_dci_dma_ctl_low(ch, true);
;;;590        uint32_t ctl_term = rtl_dci_dma_ctl_low(ch, false);
;;;591        uint8_t  chunks   = dci.g.chunks_per_frame;
;;;592        uint8_t  k, i;
;;;593    
;;;594        memset(dci_lli_ring, 0, sizeof(dci_lli_ring));
;;;595    
;;;596        for (k = 0; k < dci.dma.buf_count; k++)
;;;597        {
;;;598            for (i = 0; i < chunks; i++)
;;;599            {
;;;600                uint8_t  d = (uint8_t)(k * chunks + i);
;;;601                uint32_t words, offset;
;;;602                bool     last = (i == chunks - 1);
;;;603    
;;;604                dci_chunk_span(i, &words, &offset);
;;;605    
