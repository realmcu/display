;;;70       * \{
;;;71       */
;;;72     #define DCI_INT_FRAME               BIT0
;;;73     #define DCI_INT_OVR                 BIT1
;;;74     #define DCI_INT_ERR                 BIT2
;;;75     #define DCI_INT_VSYNC               BIT3
;;;76     #define DCI_INT_LINE                BIT4
;;;77     #define DCI_INT_ALL                 (DCI_INT_FRAME | DCI_INT_OVR | DCI_INT_ERR | \
;;;78                                          DCI_INT_VSYNC | DCI_INT_LINE)
;;;79     /** \} */
;;;80     
