;;;6      
;;;7      /*
;;;8       * DCI demo: the signal table, the overlay resolver and the geometry derivation.
;;;9       *
;;;10      * Row order follows the camera table's own principle - the earlier a row is, the safer
;;;11      * it is, and each row introduces exactly one new variable relative to something above
;;;12      * it. Run them in order and a failure at row N with 0..N-1 passing localises the fault
;;;13      * to what row N added, with no bisection.
;;;14      *
;;;15      * The geometry derivation here is a deliberate second implementation of the driver's
;;;16      * dci_calc_geometry(). It is not redundancy for its own sake: the two are computed from
;;;17      * different inputs (a table row versus DCI_InitTypeDef) and compared at setup time, so
;;;18      * a disagreement points at whichever formula is wrong before any capture is trusted.
;;;19      * If this file ever just called into the driver, the check would be vacuous.
;;;20      */
;;;21     
;;;22     #include <string.h>
;;;23     #include "dci_demo.h"
;;;24     #include "dci_demo_signal.h"
;;;25     
;;;26     /*============================================================================*
;;;27      *                         Format properties
;;;28      *============================================================================*/
;;;29     /*
;;;30      * The one place the bytes-per-pixel / pclk-per-pixel distinction is written down.
;;;31      * RAW10 is the row that matters: 1 pclk per pixel but 2 bytes per pixel, the inverse
;;;32      * of RGB565. Any formula that conflates the two works on every other format and fails
;;;33      * only here, which is exactly why the table is a table.
;;;34      */
;;;35     typedef struct
;;;36     {
;;;37         const char *name;
;;;38         uint8_t     bytes_per_pixel;
;;;39         uint8_t     pclk_per_pixel;
;;;40     } dci_fmt_prop_t;
;;;41     
;;;42     static const dci_fmt_prop_t dci_fmt_prop[] =
;;;43     {
;;;44         [DCI_FMT_NONE]   = {"raw-bus", 1, 1},
;;;45         [DCI_FMT_RGB565] = {"RGB565",  2, 2},
;;;46         [DCI_FMT_YUV422] = {"YUV422",  2, 2},
;;;47         [DCI_FMT_RAW8]   = {"RAW8",    1, 1},
;;;48         [DCI_FMT_RAW10]  = {"RAW10",   2, 1},
;;;49         [DCI_FMT_JPEG]   = {"JPEG",    0, 1},
;;;50     };
;;;51     
;;;52     uint8_t dci_demo_fmt_bytes_per_pixel(dci_demo_fmt_t fmt)
;;;53     {
;;;54         return (fmt <= DCI_FMT_JPEG) ? dci_fmt_prop[fmt].bytes_per_pixel : 0;
;;;55     }
;;;56     
;;;57     uint8_t dci_demo_fmt_pclk_per_pixel(dci_demo_fmt_t fmt)
;;;58     {
;;;59         return (fmt <= DCI_FMT_JPEG) ? dci_fmt_prop[fmt].pclk_per_pixel : 1;
;;;60     }
;;;61     
;;;62     const char *dci_demo_fmt_name(dci_demo_fmt_t fmt)
;;;63     {
;;;64         return (fmt <= DCI_FMT_JPEG) ? dci_fmt_prop[fmt].name : "?";
;;;65     }
;;;66     
;;;67     /*============================================================================*
;;;68      *                         The signal table
;;;69      *============================================================================*/
;;;70     /*
;;;71      * Rows 0..11 each correspond to a camera-side preset; rows 12..15 have no camera row
;;;72      * because the OV2640 cannot emit those geometries, but they cover receiver-side
;;;73      * behaviour (block splitting, the pool ceiling) that has to be covered somewhere.
;;;74      *
;;;75      * What is NOT here, and why:
;;;76      *
;;;77      *   camera qvga-yuv422    -> row 2. Two bytes per pixel, two pclk per pixel, identical
;;;78      *                            geometry. The receiver has no way to tell them apart, and
;;;79      *                            a row that configures the peripheral identically is not a
;;;80      *                            second test. Kept as a distinct FORMAT value only so the
;;;81      *                            log records which stimulus was used.
;;;82      *   camera qvga-colorbar  -> row 2. The pattern is generated inside the sensor; the
;;;83      *                            receiver configuration is byte for byte the same.
;;;84      *   camera qvga-pclk-gated-> row 2. "PCLK absent during blanking" has no receiver
;;;85      *                            configuration bit at all - DCI counts the edges it is
;;;86      *                            given. Worth running AS a stimulus against row 2, which
;;;87      *                            is why the row's stim column names it too.
;;;88      *   camera ov5640-hwsync-yuv422 and ov5640-rgb565 -> row 2, both of them. Hardware sync
;;;89      *                            at 320x240 is already covered there, and the sensor
;;;90      *                            identity is not a receiver-side variable: hwsync-yuv422 is
;;;91      *                            {2 bytes, 2 pclk} like RGB565, and ov5640-rgb565 is
;;;92      *                            field for field row 2 already.
;;;93      *
;;;94      * That is 16 camera rows mapping onto 12 receiver rows. The collapse is the point: it
;;;95      * says out loud which stimulus differences this peripheral is blind to.
;;;96      */
;;;97     static const dci_demo_signal_t dci_signals[] =
;;;98     {
;;;99         /*--- 0: the null row -------------------------------------------------------*/
;;;100        /*
;;;101         * No format, no polarity, no feature: every DCI_InitTypeDef field at its reset
;;;102         * value, which is what DCI_StructInit() gives. 320 bus bytes over 120 lines, so
;;;103         * one block and 37 KB - the smallest thing that can still prove data moved.
;;;104         *
;;;105         * This exists because "nothing arrived" and "something arrived wrong" are
;;;106         * different faults with the same symptom, and every other row can produce both.
;;;107         * Here there is no configuration left to be wrong: if this row fails, the fault
;;;108         * is in the clock, the pins, the DMA or the peripheral itself, and no amount of
;;;109         * table-fiddling will help. It is the row that makes the others interpretable.
;;;110         *
;;;111         * Deliberately identical to row 1 - and not just in geometry. Run both through
;;;112         * dci_demo_cfg_to_init() and the two DCI_InitTypeDef structs are BYTE IDENTICAL
;;;113         * (verified by memcmp on the host: 320 pclk/line either way, because NONE is
;;;114         * {1 byte, 1 pclk} per unit at width 320 and RGB565 is {2, 2} at width 160).
;;;115         * fmt is the only field that differs between the rows, and for these two values
;;;116         * fmt reaches no register at all: it only selects edm (both 8BIT here) and jpeg
;;;117         * (both false).
;;;118         *
;;;119         * So by the "do not list duplicate configurations" rule these two are ONE
;;;120         * configuration, and the second is kept on purpose. The difference is not what
;;;121         * the hardware is told - it is what the DEMO claims. Row 1 declares a format,
;;;122         * a pixel count and a bytes-per-pixel ratio; row 0 declares nothing. The same
;;;123         * bytes reach memory through a configuration that has no opinion about them, so
;;;124         * if row 0 passes and row 1 fails, the fault is in the demo's own arithmetic and
;;;125         * not in the peripheral - which no single row can show on its own.
;;;126         */
;;;127        {
;;;128            .name   = "null-min",
;;;129            .stim   = "safe-160x120",
;;;130            .note   = "empty config: DCI_StructInit defaults only, 320 B/line x 120. "
;;;131            "Basic reception. Nothing here can be misconfigured.",
;;;132            .width  = 320,          /* bus bytes, not pixels - fmt is NONE */
;;;133            .height = 120,
;;;134            .fmt    = DCI_FMT_NONE,
;;;135            .pckpol = false, .hspol = false, .vspol = false,
;;;136            .sync   = DCI_SYNC_HARDWARE,
;;;137        },
;;;138    
;;;139        /*--- 1..2: the baselines ---------------------------------------------------*/
;;;140        {
;;;141            .name   = "qqvga-rgb565",
;;;142            .stim   = "safe-160x120",
;;;143            .note   = "smallest sane frame: 1 block, 37 KB, fits anywhere. Start here.",
;;;144            .width  = 160, .height = 120,
;;;145            .fmt    = DCI_FMT_RGB565,
;;;146            .pckpol = true, .hspol = true, .vspol = true,
;;;147            .sync   = DCI_SYNC_HARDWARE,
;;;148        },
;;;149        {
;;;150            /* The reference point. Every polarity and format row below differs from this
;;;151             * one in exactly one field, and the camera table's main row drives it. */
;;;152            .name   = "qvga-rgb565",
;;;153            .stim   = "qvga-rgb565 (also -yuv422 / -colorbar / -pclk-gated)",
;;;154            .note   = "target resolution, the reference for every single-variable row. "
;;;155            "Also receives yuv422, colorbar and pclk-gated unchanged.",
;;;156            .width  = 320, .height = 240,
;;;157            .fmt    = DCI_FMT_RGB565,
;;;158            .pckpol = false, .hspol = false, .vspol = false,
;;;159            .sync   = DCI_SYNC_HARDWARE,
;;;160        },
;;;161    
;;;162        /*--- 3..6: polarity, one bit at a time -------------------------------------*/
;;;163        /*
;;;164         * The pass criterion is not "the image looks right" - it is that matching the
;;;165         * stimulus works and mismatching it visibly breaks. A polarity row that produces
;;;166         * a good image with the wrong setting means the peripheral is ignoring that
;;;167         * configuration bit, which is itself the bug these rows exist to find.
;;;168         *
;;;169         * READ THIS BEFORE PAIRING A ROW WITH A CAMERA PRESET. Two inversions live here,
;;;170         * and both of them flip the answer:
;;;171         *
;;;172         * 1. "Active" in hspol/vspol is the level during BLANKING, not during valid data.
;;;173         *    hspol = false ("HSYNC active low") therefore means HSYNC sits low while
;;;174         *    blanking and data is captured while it is HIGH. See TESTPLAN.md 3.1, whose
;;;175         *    expected result is "only data with both HSYNC and VSYNC in their INACTIVE
;;;176         *    state is captured". So camera qvga-href-neg - HREF inverted, i.e. high
;;;177         *    during blanking - is received with hspol = TRUE, which is what row 4 sets.
;;;178         *    The row name says "high" because that is the register's own wording for the
;;;179         *    bit; it does not mean "valid when high". Same for vspol and row 5.
;;;180         *
;;;181         * 2. pckpol is the edge this receiver SAMPLES on, while the camera's COM10[4] is
;;;182         *    the edge the sensor UPDATES data on - opposite things (ov2640_preset.h says
;;;183         *    so explicitly). Data updated on the falling edge is stable around the
;;;184         *    rising one, so the electrically correct pairing is the OPPOSITE edge:
;;;185         *    OV2640 default (COM10[4]=0, updates falling) wants pckpol = true, and
;;;186         *    camera qvga-pclk-rise wants pckpol = false. ST's own OV2640 examples use
;;;187         *    DCMI_PCKPOLARITY_RISING against a default-configured sensor.
;;;188         *
;;;189         *    The rows below pair the SAME edge instead: rows 0..2 take pckpol = false
;;;190         *    against a falling-edge sensor and row 3 takes pckpol = true against
;;;191         *    qvga-pclk-rise. That is sampling on the edge the data changes on. At the
;;;192         *    <= 10 MHz PCLK this bench runs it may latch correctly anyway on internal
;;;193         *    delay alone, which is the danger: if BOTH settings produce a good image the
;;;194         *    bit is not being honoured, and by the criterion above that is the bug the
;;;195         *    row exists to find. The pairing is left as-is because it has never been
;;;196         *    checked against hardware - when row 3 is first run, try both pckpol values
;;;197         *    and keep whichever one the data agrees with, then fix this comment.
;;;198         */
;;;199        {
;;;200            .name   = "qvga-pck-rising",
;;;201            .stim   = "qvga-pclk-rise",
;;;202            .note   = "polarity: pckpol=1, sample on the rising edge. One bit from "
;;;203            "qvga-rgb565. See the edge-pairing warning above.",
;;;204            .width  = 320, .height = 240,
;;;205            .fmt    = DCI_FMT_RGB565,
;;;206            .pckpol = true, .hspol = false, .vspol = false,
;;;207            .sync   = DCI_SYNC_HARDWARE,
;;;208        },
;;;209        {
;;;210            .name   = "qvga-href-high",
;;;211            .stim   = "qvga-href-neg",
;;;212            .note   = "polarity: hspol=1, HSYNC high during blanking (data captured while "
;;;213            "low). One bit from qvga-rgb565.",
;;;214            .width  = 320, .height = 240,
;;;215            .fmt    = DCI_FMT_RGB565,
;;;216            .pckpol = false, .hspol = true, .vspol = false,
;;;217            .sync   = DCI_SYNC_HARDWARE,
;;;218        },
;;;219        {
;;;220            .name   = "qvga-vsync-high",
;;;221            .stim   = "qvga-vsync-neg",
;;;222            .note   = "polarity: vspol=1, VSYNC high during blanking. Separate from row 4 "
;;;223            "because HSYNC and VSYNC take different state machine branches.",
;;;224            .width  = 320, .height = 240,
;;;225            .fmt    = DCI_FMT_RGB565,
;;;226            .pckpol = false, .hspol = false, .vspol = true,
;;;227            .sync   = DCI_SYNC_HARDWARE,
;;;228        },
;;;229        {
;;;230            /* The combination boundary. Three rows above pass individually and this one
;;;231             * fails only if the polarity bits are coupled - a class of bug no single-bit
;;;232             * row can reach, and the reason the camera table carries all-inverted. */
;;;233            .name   = "qvga-all-inverted",
;;;234            .stim   = "qvga-all-inverted",
;;;235            .note   = "all three polarities inverted at once: catches coupling between "
;;;236            "the bits that the single-bit rows cannot.",
;;;237            .width  = 320, .height = 240,
;;;238            .fmt    = DCI_FMT_RGB565,
;;;239            .pckpol = true, .hspol = true, .vspol = true,
;;;240            .sync   = DCI_SYNC_HARDWARE,
;;;241        },
;;;242    
;;;243        /*--- 7..10: formats --------------------------------------------------------*/
;;;244        {
;;;245            /* The 8-bit RAW control group: when a 10-bit or byte-select row fails, this
;;;246             * separates "the RAW path is broken" from "that feature is broken". */
;;;247            .name   = "qvga-raw8",
;;;248            .stim   = "qvga-raw8",
;;;249            .note   = "1 byte/pixel: pclk/line halves while lines stay. RAW control "
;;;250            "group, and the main row byte select is exercised on (only this "
;;;251            "row and null-min take all four settings).",
;;;252            .width  = 320, .height = 240,
;;;253            .fmt    = DCI_FMT_RAW8,
;;;254            .pckpol = false, .hspol = false, .vspol = false,
;;;255            .sync   = DCI_SYNC_HARDWARE,
;;;256        },
;;;257        {
;;;258            /*
;;;259             * The one format where pclk per pixel and bytes per pixel disagree: 320 pclk
;;;260             * per line carrying 640 bytes, where RGB565 at the same width needs 640 pclk
;;;261             * for the same 640 bytes. Every formula that conflates the two survives all
;;;262             * other rows and dies here. EDM=10BIT is also the only hardware-forced mode
;;;263             * in the table - it cannot be reached with any RGB565 configuration.
;;;264             */
;;;265            .name   = "qvga-raw10",
;;;266            .stim   = "qvga-raw10",
;;;267            .note   = "EDM=10BIT: 1 pclk = one 16-bit sample. The only row where "
;;;268            "pclk/pixel != bytes/pixel. bit15:10 of every sample must be 0.",
;;;269            .width  = 320, .height = 240,
;;;270            .fmt    = DCI_FMT_RAW10,
;;;271            .pckpol = false, .hspol = false, .vspol = false,
;;;272            .sync   = DCI_SYNC_HARDWARE,
;;;273        },
;;;274        {
;;;275            /*
;;;276             * Embedded sync: no HSYNC/VSYNC pins, frame and line boundaries arrive as
;;;277             * 0x00/0xFF code words in the data. Spec 2.4 only requires 8-bit, so any
;;;278             * 8-bit-EDM format passes validation - but full-range data contains pure black
;;;279             * and pure white pixels, which produce exactly those byte values and get
;;;280             * mistaken for codes. Restricted range is the practical requirement, and
;;;281             * YUV422 is the format that provides it natively: BT.656 limits Y to 16..235
;;;282             * and C to 16..240, so 0x00/0xFF cannot occur in pixel data at all. That is
;;;283             * also what the camera-side preset emits, so the geometry matches.
;;;284             *
;;;285             * Geometry is identical to qvga-rgb565 - YUV422 and RGB565 are both {2 bytes,
;;;286             * 2 pclk} per pixel and DCI cannot tell them apart. This row exists for the one
;;;287             * field that differs: sync = EMBEDDED, which is the only path through ESCR/ESUR
;;;288             * and the code-word parser.
;;;289             */
;;;290            .name   = "qvga-embedded",
;;;291            .stim   = "ov5640-sync-yuv422",
;;;292            .note   = "embedded sync codes instead of sync pins. YUV422 because BT.656 "
;;;293            "restricted range (Y 16..235, C 16..240) cannot produce the "
;;;294            "0x00/0xFF code words that full-range pixels alias onto. "
;;;295            "NOTE the OV5640 does not actually emit codes yet - see the "
;;;296            "camera-side table, it warns and behaves as hardware sync.",
;;;297            .width  = 320, .height = 240,
;;;298            .fmt    = DCI_FMT_YUV422,
;;;299            .pckpol = false, .hspol = false, .vspol = false,
;;;300            .sync   = DCI_SYNC_EMBEDDED,
;;;301        },
;;;302        {
;;;303            /*
;;;304             * Variable length: there is no frame size to validate against, the buffer is
;;;305             * a capacity cap, and the frame ends at FF D9 or VSYNC rather than at a byte
;;;306             * count. Structurally different from every other row, which is why crop is
;;;307             * refused with it (spec 2.7) and why the descriptor topology changes.
;;;308             */
;;;309            .name   = "qvga-jpeg",
;;;310            .stim   = "qvga-jpeg",
;;;311            .note   = "variable length: buffer is a capacity cap, frame ends at FF D9. "
;;;312            "Fixed-size checks do not apply; crop is refused.",
;;;313            .width  = 320, .height = 240,
;;;314            .fmt    = DCI_FMT_JPEG,
;;;315            .pckpol = false, .hspol = false, .vspol = false,
;;;316            .sync   = DCI_SYNC_HARDWARE,
;;;317        },
;;;318    
;;;319        /*--- 11: largest camera row ------------------------------------------------*/
;;;320        {
;;;321            .name   = "vga-rgb565",
;;;322            .stim   = "vga-rgb565",
;;;323            .note   = "largest size the camera emits: 600 KB, 3 blocks. Single buffer "
;;;324            "only at a 960 KB pool. Bandwidth and memory pressure.",
;;;325            .width  = 640, .height = 480,
;;;326            .fmt    = DCI_FMT_RGB565,
;;;327            .pckpol = false, .hspol = false, .vspol = false,
;;;328            .sync   = DCI_SYNC_HARDWARE,
;;;329        },
;;;330    
;;;331        /*--- 12: geometry-only row, no camera stimulus -----------------------------*/
;;;332        /*
;;;333         * Beyond what the OV2640 table can produce, kept because the receiver-side
;;;334         * behaviour it triggers has to be covered. Against a live camera it will fail on
;;;335         * frame length - that is expected and stated in the note. Its value is at config
;;;336         * time (the word-aligned split) and against a pattern generator.
;;;337         *
;;;338         * This used to be four rows (466-raw8, 466-rgb565, svga-rgb565, vga-raw10). The
;;;339         * other three were removed by request; what went with them is recorded in
;;;340         * TESTMATRIX.md, because the coverage is gone rather than relocated: the 2-block
;;;341         * and 4-block split paths now have no row at all (the table has 1- and 3-block
;;;342         * rows only), the double-buffer and pool ceilings are no longer pinned by a row,
;;;343         * and RAW10 rests on row 8 alone.
;;;344         */
;;;345        {
;;;346            /*
;;;347             * The only row that reaches the driver's word-aligned fallback split
;;;348             * (rtl_dci.c, dci_calc_geometry() line_aligned == false branch), where the
;;;349             * driver gives up on splitting by lines and splits the frame by words
;;;350             * instead: a different offset formula (first * 4 rather than
;;;351             * first * line_bytes, dci_chunk_span()), a different block-count derivation,
;;;352             * and lines_per_chunk forced to 0 because it no longer means anything.
;;;353             *
;;;354             * Note what this row does NOT demonstrate: an actual mid-line block boundary.
;;;355             * At 466x466 the frame is 54289 words, under the 65535-word block limit, so
;;;356             * it takes ONE block and the only boundary is the start of the frame. What
;;;357             * the row covers is the branch itself - whether the driver takes it and
;;;358             * whether the geometry it computes there is right. A boundary landing
;;;359             * mid-line additionally needs a frame large enough for 2+ blocks at an
;;;360             * unaligned line length, which no row in this table produces.
;;;361             *
;;;362             * Verified by sweeping all 16 rows against all 32 accepted overlay
;;;363             * combinations on the host: line_aligned == 0 occurs on this row and no
;;;364             * other, in 4 of those combinations (overlay off, LSM, BSM=1, BSM=1+LSM).
;;;365             * Delete this row and that branch has zero coverage.
;;;366             *
;;;367             * Why nothing else gets there. The trigger is line_bytes % 4 != 0, and
;;;368             * line_bytes = pclk_per_line * bytes_per_pclk / bsm_den * bsm_num:
;;;369             *   - every other row is 320/466/640/932/1280/1600 pclk at 1 or 2 bytes,
;;;370             *     and all of those products except 466 are multiples of 4;
;;;371             *   - 2 bytes/pixel could only get there with an ODD pixel width, and no
;;;372             *     sensor emits one;
;;;373             *   - BSM can make a line odd (466 -> 233), but the resolver refuses BSM on
;;;374             *     any 2-byte format, so a 466-wide RGB565 row could only reach it through
;;;375             *     the raw driver. That was true while 466-rgb565 existed as a row and is
;;;376             *     moot now that it is gone.
;;;377             *
;;;378             * CAREFUL: cropping this row DESTROYS what it tests. DCI_ConfigCrop() aligns
;;;379             * the window width down to a multiple of 4 pclk, so CROP_FULL turns 466 into
;;;380             * 464 and line_bytes becomes word aligned again - the row silently stops
;;;381             * exercising the branch. Run it with the overlay off, or with LSM/BSM=1,
;;;382             * which keep the line length odd.
;;;383             */
;;;384            .name   = "466-raw8",
;;;385            .stim   = NULL,
;;;386            .note   = "466 B/line is not a multiple of 4 -> the word-aligned fallback "
;;;387            "split, blocks no longer whole lines. The only row that reaches "
;;;388            "that branch. No camera stimulus: config-time row.",
;;;389            .width  = 466, .height = 466,
;;;390            .fmt    = DCI_FMT_RAW8,
;;;391            .pckpol = false, .hspol = false, .vspol = false,
;;;392            .sync   = DCI_SYNC_HARDWARE,
;;;393        },
;;;394    };
;;;395    
;;;396    #define DCI_SIGNAL_COUNT    (sizeof(dci_signals) / sizeof(dci_signals[0]))
;;;397    
;;;398    /* The ids in dci_demo_id.h are plain #defines because they must work inside #if, so
;;;399     * nothing but this assert keeps them in step with the table. */
