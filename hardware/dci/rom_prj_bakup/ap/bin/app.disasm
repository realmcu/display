;;;181            /* Set SDA setup time delay only in slave transmitter mode(greater than 2) ,delay time:[(IC_SDA_SETUP - 1) * (ic_clk_period)]*/
;;;182            IC_SDA_SETUP_TypeDef i2c_0x94 = {.d32 = I2Cx->IC_SDA_SETUP};
;;;183            i2c_0x94.b.sda_setup = I2C_SDA_SETUP_TIME_VALUE;
;;;184            I2Cx->IC_SDA_SETUP = i2c_0x94.d32;
;;;185        }
;;;186    
;;;187        /* Set Tx empty level */
;;;188        IC_TX_TL_TypeDef i2c_0x3c = {.d32 = I2Cx->IC_TX_TL};
;;;189        i2c_0x3c.b.tx_tl = I2C_InitStruct->I2C_TxThresholdLevel;
;;;190        I2Cx->IC_TX_TL = i2c_0x3c.d32;
;;;191    
;;;192        /*set Rx full level*/
;;;193        IC_RX_TL_TypeDef i2c_0x40 = {.d32 = I2Cx->IC_RX_TL};
;;;194        i2c_0x40.b.rx_tl = I2C_InitStruct->I2C_RxThresholdLevel;
;;;195        I2Cx->IC_RX_TL = i2c_0x40.d32;
;;;196    
;;;197        /* Config I2C dma mode */
;;;198        IC_DMA_CR_TypeDef i2c_0x88 = {.d32 = I2Cx->IC_DMA_CR};
;;;199        i2c_0x88.b.rdmae = I2C_InitStruct->I2C_RxDMAEn;
;;;200        i2c_0x88.b.tdmae = I2C_InitStruct->I2C_TxDMAEn;
;;;201        I2Cx->IC_DMA_CR = i2c_0x88.d32;
;;;202    
;;;203        /* Config I2C waterlevel */
