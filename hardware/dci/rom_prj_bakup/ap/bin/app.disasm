;;;6      
;;;7      /*
;;;8       * Deliberately NOT including hal_dma.h or os_sync.h.
;;;9       *
;;;10      * The target is a bare-metal project. Both of those would drag in code it does not
;;;11      * otherwise build:
;;;12      *   - hal_dma.c (the channel allocator) is not in the project's file list, and it
;;;13      *     itself calls os_lock/os_unlock;
;;;14      *   - os_sync.c pulls in osif + os_mem + os_timer + sys_list + os_pm, an OS port, for
;;;15      *     what is two instructions on Cortex-M.
;;;16      * So the critical section and the channel allocator are implemented here instead, on
;;;17      * top of CMSIS and rtl_dma.c - and rtl_dma.c is already compiled by the project.
;;;18      * Nothing new has to be added to the build for DCI.
;;;19      */
;;;20     #include "rtl_dci_int.h"
;;;21     #include "rtl_dma.h"
;;;22     #include "rtl_rcc.h"
;;;23     #include "rtl_nvic.h"
;;;24     #include "vector_table.h"
;;;25     
;;;26     /*============================================================================*
;;;27      *                         SoC wiring
;;;28      *============================================================================*/
;;;29     /*
;;;30      * DMA handshake index - RESOLVED (was TODO(HAL) 1/3).
;;;31      *
;;;32      * The request line is spec section 2.3: one DMA request per complete 32-bit word.
;;;33      * The index is an SoC-level mux value the IP spec does not carry, and it comes from
;;;34      * BBPRO4_DmaPorts_20260915_v0.xlsx, whose history says
;;;35      *
;;;36      *     20260914_v0  Add handshakes for AP FMC0~FMC3 and AP DCI, SCP DCI, XP DCI
;;;37      *
;;;38      * i.e. DCI handshakes landed 2026-09-14, which is why the SDK snapshot checked
;;;39      * earlier (AP table ending at IR_RX(48), reference sheet BB3_Dma1Ports_20250518)
;;;40      * did not have them yet.
;;;41      *
;;;42      * WHY 48 AND NOT THE 49 IN THAT SHEET. The sheet numbers one column for "AP
;;;43      * DMA0/1" jointly and lists DCI at 49, immediately after IR_RX(48). But AP DMA0
;;;44      * was dropped from the silicon, so DCI runs on AP DMA1, and SRC_PER is a
;;;45      * PER-CONTROLLER port number. On DMA1 the DCI port is 48. Per the SoC team:
;;;46      * "AP DMA0 被拿掉, 請用 AP DMA1 HS[48]".
;;;47      *
;;;48      * The SDK corroborates that DMA0 is gone on this core, independently of that note:
;;;49      *   - the AP RCCClock_TypeDef has DMAC1_CLOCK and no DMAC0_CLOCK
;;;50      *     (soc/driver/rcc/src/device/rtl87x3k/rtl_rcc_def.h), and defines DMA_CLOCK as
;;;51      *     NULL for AP while SCP defines it as DMAC0_CLOCK;
;;;52      *   - DMA_GetDMAChannelx() maps AP channels 16..23 onto DMA1_Channel0..7
;;;53      *     (soc/driver/dma/src/device/rtl87x3k/rtl_dma_int.c), with DMA1_CH_NUM0 = 16.
;;;54      *
;;;55      * So a DCI capture is only possible on a DMA1 channel - see
;;;56      * rtl_dci_dma_channel_alloc() below, which enforces that.
;;;57      */
;;;58     #define DCI_DMA_HANDSHAKE_RX        (48U)
;;;59     
;;;60     uint8_t rtl_dci_dma_handshake_rx(void)
;;;61     {
;;;62         return DCI_DMA_HANDSHAKE_RX;
;;;63     }
;;;64     
;;;65     /*
;;;66      * DCI clock enable - NOT NEEDED FOR NOW (was TODO(HAL) 2/3, no longer blocking).
;;;67      *
;;;68      * Per the SoC team the DCI clock is enabled by default, so this is deliberately a
;;;69      * no-op rather than an unimplemented stub: there is nothing to call. The register
;;;70      * block is reachable as-is, which is why DCI_RegTest() and a capture-less
;;;71      * configuration run are both possible today.
;;;72      *
;;;73      * Kept as a function rather than deleted because the display island does have its
;;;74      * own power/clock domain and a future part may well gate it. What such an
;;;75      * implementation would need, if that day comes:
;;;76      *   - the AP RCCClock_TypeDef carries no display-island entry (no DCI, IDU, PPE,
;;;77      *     LCDC, MIPI, JPEG, PNG or GPU), so DCI would not simply join that enum;
;;;78      *   - the island has its own DISPLAY_AON(0x40645000) / DISPLAY_PLATFORM(0x40646000)
;;;79      *     / DISPLAY_PCC(0x40647000) / DISPLAY_RAP(0x4064a000) block, and
;;;80      *     DISPLAY_PCC_BASE appears in address_map.h with zero users anywhere in the
;;;81      *     tree - no register table has landed for it;
;;;82      *   - so the enable would most likely be a direct write to the display PCC, not an
;;;83      *     RCC_ClockCmd() call.
;;;84      *
;;;85      * Note RCC_PeriphClockCmd(p, c, s) would not be the API either: on this SoC
;;;86      * rtl_rcc_def.h defines it as RCC_ClockCmd(p, s). The sibling modules (rtl_idu.c,
;;;87      * rtl_jpu.c) call the three-argument form only because they are shared with older
;;;88      * parts.
;;;89      */
;;;90     void rtl_dci_clock_enable(void)
;;;91     {
;;;92         /* Intentionally empty - the DCI clock is on by default on this part. */
;;;93     
;;;94         /* Left commented rather than compiled out: if a part ever does gate DCI, this
;;;95          * is the line to restore, and #ifdef DCI_CLOCK would silently do nothing on a
;;;96          * build where the macro is simply absent - which is exactly how a missing clock
;;;97          * enable turns into an unexplained DCI_ERROR_NO_RESPONSE.
;;;98          *
;;;99          * RCC_ClockCmd(DCI_CLOCK, ENABLE);
;;;100         */
;;;101    }
;;;102    
;;;103    /*
;;;104     * DCI pin configuration - NOTHING TO DO ON THE FPGA PLATFORM.
;;;105     *
;;;106     * Empty because that is correct here, not because it is unfinished. On the VU13P FPGA
;;;107     * board the DCI signals are dedicated top-level RTL ports pinned by the .xdc, so they
;;;108     * reach the peripheral directly and never pass through the SoC pin mux.
;;;109     *
;;;110     * Evidence, from BBpro4_VU13P_FPGA_Display_FMC1DQ16_Pin_Assignment_20260915_v0.xlsx
;;;111     * (sheet "新版J4"; history 20260911_v1 "add DCMI signals"):
;;;112     *   - the Pin Name column IS the RTL port name (sheet "NOTE", row 20), and the DCI
;;;113     *     signals appear there as dcmi_d[13:0], dcmi_pixclk, dcmi_hsync, dcmi_vsync.
;;;114     *     Note the pin table routes 14 data lines while the IP only has ten: the spec is
;;;115     *     explicit ("DCI 拥有 10 条数据线 D[9:0]", EDM is EDM[0] alone, and unused inputs
;;;116     *     "必须将外部未使用的输入引脚接地"). So d[13:10] are spare board routing, not
;;;117     *     usable DCI data - the 8/10-bit enumeration in this driver is correct;
;;;118     *   - those names form their own class. The same sheet's other pins are either
;;;119     *     P_GPIOx_y (39 of them - SoC GPIOs, the ones a pin mux would apply to) or
;;;120     *     FPGA_IO_PIN_AP/BT/WIFI[n] (42 - reassignable FPGA IO). None of the dcmi_* names
;;;121     *     is a GPIO pin;
;;;122     *   - dcmi_pixclk (FPGA BB9, J4 G5) is on a clock-capable pin, marked *P_*_GC_*, which
;;;123     *     is what an externally driven pixel clock needs.
;;;124     * Consistent with the SDK: pin_def.h has no DCI/DCMI/DVP function number at all
;;;125     * (numbering ends at SPIC0_SIO3(72)), which is expected if these are dedicated pads.
;;;126     *
;;;127     * NOTE for ASIC bring-up: whether silicon also uses dedicated pads is NOT established
;;;128     * by the above - the FPGA board proves nothing about the ASIC's pad ring. 17 signals is
;;;129     * a lot to route through a general mux, so dedicated pads stay the likely answer, but
;;;130     * confirm against the BBPro4 pin list before trusting this function to stay empty
;;;131     * there.
;;;132     *
;;;133     * Board-level facts worth knowing when the capture does not work (they are wiring, not
;;;134     * driver configuration):
;;;135     *   - the DCI pins reuse the MIPI D-PHY debug and LCDC signals on J4, so a bitfile
;;;136     *     carrying DCMI excludes MIPI/LCDC on that connector;
;;;137     *   - the camera's I2C is FPGA_IO_PIN_AP[80]/[81] (J4 G29/G30), deliberately placed
;;;138     *     next to the DCI pins for sensor init.
;;;139     */
;;;140    void rtl_dci_pinmux_init(void)
;;;141    {
;;;142        /* Dedicated RTL ports on this platform - no mux to program. */
;;;143    }
;;;144    
;;;145    /*============================================================================*
;;;146     *                         Critical section
;;;147     *============================================================================*/
;;;148    /*
;;;149     * PRIMASK save/disable/restore rather than os_lock(): this is a bare-metal target, and
;;;150     * os_lock() lives in an OS port the project does not build (see the note on the includes
;;;151     * at the top of this file).
;;;152     *
;;;153     * Saving and restoring PRIMASK rather than unconditionally re-enabling is what makes
;;;154     * this safe to nest and safe to call from an ISR - the driver does both. __disable_irq()
;;;155     * has the compiler barrier CMSIS gives it, so the register writes inside the section
;;;156     * cannot be hoisted out.
;;;157     */
;;;158    uint32_t rtl_dci_lock(void)
;;;159    {
;;;160        uint32_t primask = __get_PRIMASK();
;;;161    
;;;162        __disable_irq();
;;;163        return primask;
;;;164    }
;;;165    
;;;166    void rtl_dci_unlock(uint32_t s)
;;;167    {
;;;168        __set_PRIMASK(s);
;;;169    }
;;;170    
;;;171    /*============================================================================*
;;;172     *                         DMA channel properties
;;;173     *============================================================================*/
;;;174    /*
;;;175     * Self-contained channel allocator, replacing hal_dma_channel_alloc().
;;;176     *
;;;177     * Why not the HAL one: it lives in soc/driver/dma/src/hal/hal_dma.c, which the
;;;178     * bare-metal project does not build, and which itself needs os_lock/os_unlock from an
;;;179     * OS port. Everything used below comes from rtl_dma.c, which the project already
;;;180     * compiles, plus CMSIS. Adding DCI therefore needs no new files in the build.
;;;181     *
;;;182     * WHICH CHANNELS. DCI must run on an AP DMA1 channel, which on this core is 16..23
;;;183     * (DMA1_CH_NUM0 is 16, and DMA_GetDMAChannelx() maps 16..23 onto DMA1_Channel0..7).
;;;184     * AP DMA0 was dropped from the silicon, so a DMA0 channel would be programmed into
;;;185     * registers nothing drives and the capture would simply never start. Scanning only
;;;186     * 16..23 is also why this is simpler than the HAL version, which always scans from 0
;;;187     * and would have to be coaxed upwards.
;;;188     *
;;;189     * HOW "FREE" IS DECIDED. DMA_GetChannelStatus(ch) reads CHENREG, i.e. whether the
;;;190     * channel is currently enabled. That is weaker than the HAL's allocation bitmask: it
;;;191     * cannot see a channel that some other module has reserved but not yet started. In a
;;;192     * bare-metal test image where DCI is the only DMA client on DMA1 that is sufficient, and
;;;193     * it is checked under a critical section so two callers cannot pick the same one. An
;;;194     * application that shares DMA1 should pass an explicit channel instead of AUTO.
;;;195     */
;;;196    #define DCI_DMA1_CH_FIRST       (16U)   /* DMA1_CH_NUM0 on the AP core */
;;;197    
;;;198    /*
;;;199     * Channel FIFO depth. This SoC does not fix the depth per channel number, and without
;;;200     * the HAL there is nobody to ask, so a conservative 8 is assumed for every channel:
;;;201     * DEST_MSIZE is derived from it, and being too small only costs burst efficiency, while
;;;202     * being too large would overrun the FIFO. The reg dump shows the resulting DEST_MSIZE.
;;;203     */
;;;204    #define DCI_DMA_FIFO_DEPTH_ASSUMED  (8U)
;;;205    
;;;206    bool rtl_dci_dma_channel_alloc(uint8_t *channel_num, void (*isr)(void))
;;;207    {
;;;208        uint32_t s;
;;;209        uint8_t  ch;
;;;210        bool     got = false;
;;;211    
;;;212        if (channel_num == NULL)
;;;213        {
;;;214            return false;
;;;215        }
;;;216    
;;;217        /* An explicit channel outside DMA1 is a configuration error, not something to
;;;218         * silently correct: the caller asked for a channel that cannot carry DCI. */
;;;219        if (*channel_num != DCI_DMA_CH_AUTO &&
;;;220            (*channel_num < DCI_DMA1_CH_FIRST || *channel_num >= CHIP_DMA_CHANNEL_NUM))
;;;221        {
;;;222            return false;
;;;223        }
;;;224    
;;;225        s = rtl_dci_lock();
;;;226    
;;;227        if (*channel_num != DCI_DMA_CH_AUTO)
;;;228        {
;;;229            got = (DMA_GetChannelStatus(*channel_num) == RESET);
;;;230            ch  = *channel_num;
;;;231        }
;;;232        else
;;;233        {
;;;234            for (ch = DCI_DMA1_CH_FIRST; ch < CHIP_DMA_CHANNEL_NUM; ch++)
;;;235            {
;;;236                if (DMA_GetChannelStatus(ch) == RESET)
;;;237                {
;;;238                    got = true;
;;;239                    break;
;;;240                }
;;;241            }
;;;242        }
;;;243    
;;;244        if (got)
;;;245        {
;;;246            /* Claim it by disabling it explicitly, so a half-configured channel left behind
;;;247             * by an earlier run cannot start mid-setup. */
;;;248            DMA_Cmd(ch, DISABLE);
;;;249            *channel_num = ch;
;;;250        }
;;;251    
;;;252        rtl_dci_unlock(s);
;;;253    
;;;254        /* Outside the critical section: updating the vector table is not something to do
;;;255         * with interrupts masked, and the channel is already claimed by this point. */
;;;256        if (got && isr != NULL)
;;;257        {
;;;258            IRQn_Type        irq = DMA_GetDMAIRQx(ch);
;;;259            NVIC_InitTypeDef nvic_init;
;;;260    
;;;261            ram_vector_table_update(irq, (IRQ_Fun)isr);
;;;262    
;;;263            /*
;;;264             * And enable it. hal_dma_channel_alloc() only ever did the vector table update,
;;;265             * leaving the NVIC line to the caller - so on the HAL path this was missing and
;;;266             * dci_dma_isr() would never have run. Same priority as the DCI vector: the two
;;;267             * ISRs touch the same driver state, and equal priority means neither can
;;;268             * pre-empt the other.
;;;269             */
;;;270            nvic_init.NVIC_IRQChannel         = irq;
;;;271            nvic_init.NVIC_IRQChannelPriority = 3;
;;;272            nvic_init.NVIC_IRQChannelCmd      = ENABLE;
;;;273            NVIC_Init(&nvic_init);
;;;274        }
;;;275    
;;;276        return got;
;;;277    }
;;;278    
;;;279    void rtl_dci_dma_channel_free(uint8_t channel_num)
;;;280    {
;;;281        if (channel_num < CHIP_DMA_CHANNEL_NUM)
;;;282        {
;;;283            /* Disabling is the whole of releasing here: there is no allocation bitmask to
;;;284             * clear, since this allocator infers "free" from the channel being disabled. */
;;;285            DMA_Cmd(channel_num, DISABLE);
;;;286        }
;;;287    }
;;;288    
;;;289    uint8_t rtl_dci_get_dma_depth(uint8_t channel_num)
;;;290    {
;;;291        if (channel_num >= CHIP_DMA_CHANNEL_NUM)
;;;292        {
;;;293            return 0;
;;;294        }
;;;295        return DCI_DMA_FIFO_DEPTH_ASSUMED;
;;;296    }
;;;297    
;;;298    /* DEST_MSIZE selection lives in rtl_dci_dma.c next to the CTL_LOW composition that
;;;299     * consumes it. */
;;;300    
;;;301    /*
;;;302     * DMA1, not DMA_CLOCK. On the AP core rtl_rcc_def.h defines DMA_CLOCK as NULL - only
;;;303     * the SCP core maps it to DMAC0_CLOCK - so the obvious RCC_ClockCmd(DMA_CLOCK, ENABLE)
;;;304     * compiles, runs and enables nothing. AP DMA0 was dropped from the silicon and DCI
;;;305     * runs on DMA1 (see the handshake note at the top of this file), so DMAC1_CLOCK is
;;;306     * both the correct clock and the only one that exists here.
;;;307     */
;;;308    void rtl_dci_dma_clock_enable(void)
;;;309    {
;;;310        RCC_ClockCmd(DMA1_CLOCK, ENABLE);
;;;311    }
