;;;794        DCI_Cmd(DISABLE);           /* resets the DCI FIFO */
;;;795        DCI_Cmd(ENABLE);
;;;796        DCI_ClearINTPendingBit(DCI_INT_ALL);
;;;797    
;;;798        dci.chunk_idx = 0;
;;;799        dci.evt       = 0;
;;;800        dci.stats.resync_count++;
;;;801        dci.stats.frames_dropped++;
