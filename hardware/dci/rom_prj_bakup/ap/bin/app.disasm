;;;817    /*============================================================================*
;;;818     *                     Frame Completion (DESIGN.md 7.2)
;;;819     *============================================================================*/
;;;820    /*
;;;821     * Shared by the three LLP = 0 topologies: both SNAPSHOT variants and CONTINUOUS
;;;822     * JPEG. All three stop the DMA dead at the end of the frame, which makes
;;;823     * CURR_DAR trustworthy, so IT_FRAME alone settles the frame - no rendezvous.
;;;824     */
