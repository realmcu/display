;;;686    /**
;;;687     * @brief Transmits a data through the SPIx peripheral.
;;;688     *
;;;689     * @param[in] SPIx  Select the SPI peripheral, refer to @ref SPI_DECLARATION.
;;;690     * @param[in] Data  Data to be transmitted.
