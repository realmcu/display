;;;88         for (i = 0; i < count; i++)
;;;89         {
;;;90             demo_bufs.buf[i] = &demo_pool[i * stride + DEMO_GUARD_WORDS];
;;;91         }
;;;92         demo_bufs.bytes = data_words * 4;
;;;93         demo_bufs.count = count;
;;;94         demo_bufs.valid = true;
;;;95     
;;;96         DEMO_LOG("  pool: %u buffer(s) x %u B at %p, %u B guard fence",
;;;97                  count, demo_bufs.bytes, (void *)demo_bufs.buf[0], DEMO_GUARD_WORDS * 4);
;;;98         return true;
;;;99     }
