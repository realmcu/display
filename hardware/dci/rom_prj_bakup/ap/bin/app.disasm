;;;197    /*
;;;198     * frame_bytes cannot be read back from the hardware: with CROP disabled the DCI
;;;199     * captures whatever HSYNC/VSYNC delimit, so the sensor geometry has to be
;;;200     * declared. On top of that EDM sets the bytes per pixel clock while BSM and LSM
;;;201     * decimate bytes and lines (DESIGN.md 12.6-D2).
;;;202     */
;;;203    static DCI_ERROR dci_calc_geometry(const DCI_InitTypeDef *init, const DCI_DMA_config *dma,
;;;204                                       const dci_crop_t *crop, dci_geom_t *g)
;;;205    {
;;;206        uint32_t bytes_per_pclk = (init->edm == DCI_EDM_8BIT) ? 1 : 2;
;;;207        uint32_t pclk_per_line;
;;;208        uint32_t lines_in;
;;;209        uint32_t bsm_num, bsm_den;
;;;210        uint32_t n;
;;;211    
;;;212        memset(g, 0, sizeof(*g));
;;;213        g->var_len = init->jpeg;
;;;214    
;;;215        if (init->jpeg)
;;;216        {
;;;217            /* No declared length: one block covering the whole buffer, LLP = 0, so a
;;;218             * full block means the stream overflowed the buffer (DESIGN.md 9.2). */
;;;219            g->chunk_words      = dma->buf_bytes / 4;
;;;220            g->chunks_per_frame = 1;
;;;221            g->desc_count       = dma->buf_count;
;;;222            if (g->chunk_words == 0 || g->chunk_words > DCI_MAX_BLOCK_TS)
;;;223            {
;;;224                return DCI_ERROR_SIZE;
;;;225            }
;;;226            return DCI_SUCCESS;
;;;227        }
;;;228    
;;;229        pclk_per_line = init->crop ? crop->w : init->sensor_pclk_per_line;
;;;230        lines_in      = init->crop ? crop->h : init->sensor_lines;
;;;231    
;;;232        /* Line decimation: OELS picks the first or the second line of each pair. */
;;;233        if (init->lsm)
;;;234        {
;;;235            g->lines_out = (uint16_t)(init->oels ? (lines_in / 2) : DCI_DIV_UP(lines_in, 2));
;;;236        }
;;;237        else
;;;238        {
;;;239            g->lines_out = (uint16_t)lines_in;
;;;240        }
;;;241        if (g->lines_out == 0)
;;;242        {
;;;243            return DCI_ERROR_INVALID_PARAM;
;;;244        }
;;;245    
;;;246        dci_bsm_ratio(init->bsm, &bsm_num, &bsm_den);
;;;247        g->line_bytes = pclk_per_line * bytes_per_pclk;
;;;248        if ((g->line_bytes % bsm_den) != 0)
;;;249        {
;;;250            /* A partial decimation group at the end of a line would shift every
;;;251             * following line, so refuse instead of guessing. */
;;;252            return DCI_ERROR_INVALID_PARAM;
;;;253        }
;;;254        g->line_bytes = g->line_bytes / bsm_den * bsm_num;
;;;255        if (g->line_bytes == 0)
;;;256        {
;;;257            return DCI_ERROR_INVALID_PARAM;
;;;258        }
;;;259    
;;;260        g->frame_bytes  = g->line_bytes * g->lines_out;
;;;261        g->frame_words  = DCI_DIV_UP(g->frame_bytes, 4);
;;;262        g->line_aligned = ((g->line_bytes % 4) == 0);
;;;263    
;;;264        if (g->line_aligned)
;;;265        {
;;;266            /* Grow the block count only when a block cannot hold the frame, one step
;;;267             * at a time, and keep chunk boundaries on line boundaries. */
;;;268            g->line_words = g->line_bytes / 4;
;;;269            for (n = 1; n <= DCI_MAX_CHUNK; n++)
;;;270            {
;;;271                uint32_t lpc = DCI_DIV_UP(g->lines_out, n);
;;;272                if (lpc * g->line_words <= DCI_MAX_BLOCK_TS)
;;;273                {
;;;274                    g->lines_per_chunk = (uint16_t)lpc;
;;;275                    g->chunk_words     = lpc * g->line_words;
;;;276                    break;
;;;277                }
;;;278            }
;;;279        }
;;;280        else
;;;281        {
;;;282            /* Degenerate case: the line length is not a whole number of words (for
;;;283             * example 466 wide 8-bit), so split by words. Invisible to the caller
;;;284             * because the block layout is not exposed; only the dump shows it. */
;;;285            n = DCI_DIV_UP(g->frame_words, DCI_MAX_BLOCK_TS);
;;;286            if (n <= DCI_MAX_CHUNK)
;;;287            {
;;;288                g->chunk_words = DCI_DIV_UP(g->frame_words, n);
;;;289            }
;;;290        }
;;;291    
;;;292        if (n > DCI_MAX_CHUNK || g->chunk_words == 0 || g->chunk_words > DCI_MAX_BLOCK_TS)
;;;293        {
;;;294            return DCI_ERROR_SIZE;
;;;295        }
;;;296    
;;;297        g->chunks_per_frame = (uint8_t)n;
