;;;527            en |= DCI_INT_VSYNC;
;;;528        }
;;;529        if (dci.dma.line_event != NULL)
;;;530        {
;;;531            en |= DCI_INT_LINE;
;;;532        }
;;;533        DCI->IER = en;
;;;534    }
