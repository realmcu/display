;;;6      
;;;7      /*
;;;8       * DCI demo: interrupt counting and per-frame reporting.
;;;9       *
;;;10      * Five interrupt sources, three of them always on and two optional:
;;;11      *
;;;12      *   FRAME  always enabled - the driver needs it to close a frame. Where the per-frame
;;;13      *          report is emitted, and where "keep frame N" is decided.
;;;14      *   OVR    always enabled. Logs unconditionally.
;;;15      *   ERR    always enabled. Logs unconditionally.
;;;16      *   VSYNC  off unless DCI_DEMO_IRQ_VSYNC. Counted cumulatively.
;;;17      *   LINE   off unless DCI_DEMO_IRQ_LINE. Counted per frame and cumulatively.
;;;18      *
;;;19      * "Off" here means masked in IER, not counted-and-discarded. The driver enables IT_VSYNC
;;;20      * and IT_LINE if and only if the matching callback pointer in DCI_DMA_config is non-NULL
;;;21      * (dci_int_config() in rtl_dci.c), so leaving the pointer NULL is the register-level
;;;22      * disable. That is why the macros gate a pointer here rather than an IER write: the
;;;23      * driver is not modified, and there is no window in which the interrupt is enabled but
;;;24      * unhandled.
;;;25      *
;;;26      * Ordering constraint worth stating because it is not obvious and it fails silently:
;;;27      * DCI_Capture_Start() calls dci_int_config(), which ASSIGNS IER, immediately before
;;;28      * enabling the peripheral. Any IER bit set with DCI_INTConfig() beforehand is wiped, and
;;;29      * any set afterwards races the first frame. Supplying the callbacks and letting the
;;;30      * driver derive IER is the only approach that is correct at both ends.
;;;31      *
;;;32      * No printing in an ISR except on the error paths. LINE is roughly 28,000 interrupts per
;;;33      * second at 466 lines and 60 fps; a print there does not slow the report down, it causes
;;;34      * the overrun the report would have described. The handlers accumulate into plain
;;;35      * counters and the frame handler emits one line.
;;;36      */
;;;37     
;;;38     #include "dci_demo.h"
;;;39     
;;;40     dci_demo_irq_t dci_demo_irq;
;;;41     
;;;42     /*
;;;43      * Which frame to keep, 1-based, 0 meaning keep none. Separate from the counters because
;;;44      * it is written by the thread and read by the ISR, where the counters go the other way.
;;;45      */
;;;46     static volatile uint32_t demo_hold_target;
;;;47     static volatile bool     demo_hold_done;
;;;48     static DCI_frame_t       demo_held_frame;
;;;49     
;;;50     void dci_demo_irq_reset(void)
;;;51     {
;;;52         /* Field by field rather than memset: the struct is volatile, and memset on a
;;;53          * volatile object is a constraint violation that some compilers accept silently. */
;;;54         dci_demo_irq.vsync      = 0;
;;;55         dci_demo_irq.line       = 0;
;;;56         dci_demo_irq.line_total = 0;
;;;57         dci_demo_irq.line_prev  = 0;
;;;58         dci_demo_irq.frame      = 0;
;;;59         dci_demo_irq.ovr        = 0;
;;;60         dci_demo_irq.err        = 0;
;;;61         dci_demo_irq.ready      = 0;
;;;62         dci_demo_irq.last_seq   = 0;
;;;63         dci_demo_irq.last_err   = DCI_SUCCESS;
;;;64         dci_demo_irq.last_ris   = 0;
;;;65     
;;;66         demo_hold_done = false;
;;;67     }
;;;68     
;;;69     /*============================================================================*
;;;70      *                         Optional handlers
;;;71      *============================================================================*/
;;;72     /*
;;;73      * Compiled only when enabled, so a disabled interrupt costs nothing at all - not an
;;;74      * empty function, not a pointer, not a branch. The #if also makes the pointer NULL,
;;;75      * which is what keeps the IER bit clear.
;;;76      */
;;;77     #if (DCI_DEMO_IRQ_VSYNC == 1)
;;;78     static void demo_on_vsync(void)
;;;79     {
;;;80         dci_demo_irq.vsync++;
;;;81     }
;;;82     #endif
;;;83     
;;;84     #if (DCI_DEMO_IRQ_LINE == 1)
;;;85     static void demo_on_line(void)
;;;86     {
;;;87         dci_demo_irq.line++;
;;;88         dci_demo_irq.line_total++;
;;;89     }
;;;90     #endif
;;;91     
;;;92     void dci_demo_irq_install(DCI_DMA_config *dma)
;;;93     {
;;;94         dma->frame_error = dci_demo_on_frame_error;
;;;95     
;;;96     #if (DCI_DEMO_IRQ_VSYNC == 1)
;;;97         dma->vsync_event = demo_on_vsync;
;;;98     #else
;;;99         dma->vsync_event = NULL;        /* leaves IT_VSYNC masked in IER */
;;;100    #endif
;;;101    
;;;102    #if (DCI_DEMO_IRQ_LINE == 1)
;;;103        dma->line_event = demo_on_line;
;;;104    #else
;;;105        dma->line_event = NULL;         /* leaves IT_LINE masked in IER */
;;;106    #endif
;;;107    }
;;;108    
;;;109    /*============================================================================*
;;;110     *                         Frame retention
;;;111     *============================================================================*/
;;;112    void dci_demo_irq_hold_frame(uint32_t n)
;;;113    {
;;;114        demo_hold_target = n;
;;;115        demo_hold_done   = false;
;;;116    }
;;;117    
;;;118    bool dci_demo_irq_held(void)
;;;119    {
;;;120        return demo_hold_done;
;;;121    }
;;;122    
;;;123    const DCI_frame_t *dci_demo_irq_held_frame(void)
;;;124    {
;;;125        return demo_hold_done ? &demo_held_frame : NULL;
;;;126    }
;;;127    
;;;128    /*============================================================================*
;;;129     *                         Delivery
;;;130     *============================================================================*/
;;;131    /*
;;;132     * The per-frame interrupt handler, in the sense that matters to a user of this demo: the
;;;133     * driver's IT_FRAME handler settles the frame and then delivers it here.
;;;134     *
;;;135     * Three things happen per frame, in this order:
;;;136     *
;;;137     *   1. the line count of the frame that just ended is latched and the counter restarted,
;;;138     *      because it is only meaningful per frame;
;;;139     *   2. optionally one line is printed - this frame's lines and the cumulative sync count,
;;;140     *      which together say whether the receiver and the camera still agree on geometry;
;;;141     *   3. the buffer is released, unless this is the frame being kept.
;;;142     *
;;;143     * Step 3 is what implements "capture frame N": not releasing it leaves it locked, and
;;;144     * under the GATE policy the driver stops capture when the ring next needs that buffer.
;;;145     * The data is then static without the thread having to stop the DMA at the right instant.
;;;146     */
;;;147    void dci_demo_on_frame_ready(const DCI_frame_t *frame)
;;;148    {
;;;149        uint32_t n;
;;;150    
;;;151        dci_demo_irq.frame++;
;;;152        dci_demo_irq.ready++;
;;;153        dci_demo_irq.last_seq = frame->seq;
;;;154        n = dci_demo_irq.ready;
;;;155    
;;;156        /* Per-frame, so latch and restart. Read once - LINE can fire between these two
;;;157         * statements if the next frame has already started. */
;;;158        dci_demo_irq.line_prev = dci_demo_irq.line;
;;;159        dci_demo_irq.line      = 0;
;;;160    
;;;161    #if (DCI_DEMO_IRQ_LOG == 1)
;;;162        /*
;;;163         * One line per frame. The line count is 0 unless DCI_DEMO_IRQ_LINE is on, and the
;;;164         * sync count is 0 unless DCI_DEMO_IRQ_VSYNC is on; both are printed regardless so
;;;165         * the format does not change with the build - a log that is missing a column is
;;;166         * harder to read than one with a zero in it.
;;;167         */
;;;168        DEMO_LOG("[IRQ] frame %u  seq %u  buf %u  %u B  lines %u  vsync %u (total)",
;;;169                 (unsigned)n, (unsigned)frame->seq, frame->index,
;;;170                 (unsigned)frame->bytes, (unsigned)dci_demo_irq.line_prev,
;;;171                 (unsigned)dci_demo_irq.vsync);
;;;172    #endif
;;;173    
;;;174        if (demo_hold_target != 0 && n == demo_hold_target)
;;;175        {
;;;176            /*
;;;177             * Stop the pixel flow here rather than in the thread. This runs at the frame
;;;178             * boundary, which is the last moment at which no byte of the next frame has
;;;179             * been written yet - a thread that polls for demo_hold_done and then stops
;;;180             * capture is already a frame period late, and with one buffer that is a frame
;;;181             * period of overwriting.
;;;182             *
;;;183             * Only CR.capture is touched, which is a single register write and legal from
;;;184             * an ISR. The driver's own state is left to DCI_Capture_Stop() in the thread:
;;;185             * that path is graceful, so the frame stays delivered and the buffer stays
;;;186             * locked. Abort() would clear the lock and is exactly what must not happen.
;;;187             */
;;;188            DCI_CaptureCmd(DISABLE);
;;;189    
;;;190            /* Copy the descriptor: the driver's DCI_frame_t for this buffer is reused on
;;;191             * the next delivery to the same index, so the pointer would go stale even
;;;192             * though the data behind it is protected by the lock. */
;;;193            demo_held_frame = *frame;
;;;194            demo_hold_done  = true;
;;;195            return;                     /* deliberately NOT released */
;;;196        }
;;;197    
;;;198        /* Legal from an ISR, and it auto-resumes a capture that the gate had stopped. */
;;;199        DCI_Capture_ReleaseBuffer(frame->index);
;;;200    }
;;;201    
;;;202    /*============================================================================*
;;;203     *                         Errors
;;;204     *============================================================================*/
;;;205    /*
;;;206     * Always logged, whatever DCI_DEMO_IRQ_LOG is set to. Both of these mean a whole frame
;;;207     * was lost, so they cannot flood the log the way LINE would, and a silent overrun is the
;;;208     * worst failure mode this peripheral has: the capture keeps running, the frame count
;;;209     * keeps climbing, and the only evidence is in a statistics counter nobody reads.
;;;210     *
;;;211     * The RIS snapshot is included because it is the only view of which bits were pending at
;;;212     * the moment of the fault - by the time the thread looks, the driver has cleared them.
;;;213     */
;;;214    void dci_demo_on_frame_error(DCI_ERROR err, uint32_t ris)
;;;215    {
;;;216        dci_demo_irq.last_err = err;
;;;217        dci_demo_irq.last_ris = ris;
;;;218    
;;;219        switch (err)
;;;220        {
;;;221        case DCI_ERROR_OVERRUN:
;;;222            dci_demo_irq.ovr++;
;;;223            DEMO_LOG("[IRQ] *** OVERRUN *** FIFO overflowed, frame %u lost, RIS 0x%02X",
;;;224                     (unsigned)(dci_demo_irq.frame + 1), (unsigned)ris);
;;;225            DEMO_LOG("      the DMA could not keep up: PCLK too fast, DMA priority too "
;;;226                     "low, or a long print in an ISR");
;;;227            break;
;;;228    
;;;229        case DCI_ERROR_SYNC:
;;;230            dci_demo_irq.err++;
;;;231            DEMO_LOG("[IRQ] *** SYNC ERROR *** embedded codes out of order, RIS 0x%02X",
;;;232                     (unsigned)ris);
;;;233            DEMO_LOG("      expected frame-start/line-start/line-end/frame-end in order; "
;;;234                     "check the codes and the unmask values");
;;;235            break;
;;;236    
;;;237        case DCI_ERROR_DESYNC:
;;;238            dci_demo_irq.err++;
;;;239            DEMO_LOG("[IRQ] *** DESYNC *** block and frame interrupts disagree, driver "
;;;240                     "resynced, RIS 0x%02X", (unsigned)ris);
;;;241            break;
;;;242    
;;;243        case DCI_ERROR_FRAME_LONG:
;;;244            dci_demo_irq.err++;
;;;245            DEMO_LOG("[IRQ] frame longer than declared: the camera is emitting more than "
;;;246                     "the configured geometry (RIS 0x%02X)", (unsigned)ris);
;;;247            DEMO_LOG("      run the PROBE_SIGNAL case - it measures the real line count");
;;;248            break;
;;;249    
;;;250        case DCI_ERROR_FRAME_SHORT:
;;;251            dci_demo_irq.err++;
;;;252            DEMO_LOG("[IRQ] frame shorter than declared: configured geometry is larger "
;;;253                     "than the camera's output (RIS 0x%02X)", (unsigned)ris);
;;;254            break;
;;;255    
;;;256        case DCI_ERROR_BUF_OVERFLOW:
;;;257            dci_demo_irq.err++;
;;;258            DEMO_LOG("[IRQ] JPEG stream exceeded the buffer: raise "
;;;259                     "DCI_DEMO_JPEG_CAP_KB (RIS 0x%02X)", (unsigned)ris);
;;;260            break;
;;;261    
;;;262        default:
;;;263            dci_demo_irq.err++;
;;;264            DEMO_LOG("[IRQ] error %d, RIS 0x%02X", err, (unsigned)ris);
;;;265            break;
;;;266        }
;;;267    }
;;;268    
;;;269    /*============================================================================*
;;;270     *                         Report
;;;271     *============================================================================*/
;;;272    void dci_demo_irq_report(void)
;;;273    {
;;;274        DEMO_LOG("[IRQ] frame=%u ready=%u vsync=%u line=%u(total) ovr=%u err=%u",
;;;275                 (unsigned)dci_demo_irq.frame, (unsigned)dci_demo_irq.ready,
;;;276                 (unsigned)dci_demo_irq.vsync, (unsigned)dci_demo_irq.line_total,
;;;277                 (unsigned)dci_demo_irq.ovr, (unsigned)dci_demo_irq.err);
;;;278    
;;;279        /* Stating which sources were masked keeps a zero from being read as evidence. A
;;;280         * report saying "vsync=0" is ambiguous; one saying the interrupt was off is not. */
;;;281    #if (DCI_DEMO_IRQ_VSYNC == 0)
;;;282        DEMO_LOG("      IT_VSYNC masked (DCI_DEMO_IRQ_VSYNC=0) - vsync count is not a "
;;;283                 "measurement");
;;;284    #endif
;;;285    #if (DCI_DEMO_IRQ_LINE == 0)
;;;286        DEMO_LOG("      IT_LINE masked (DCI_DEMO_IRQ_LINE=0) - line counts are not a "
;;;287                 "measurement");
;;;288    #endif
;;;289    
;;;290        if (dci_demo_irq.ovr != 0 || dci_demo_irq.err != 0)
;;;291        {
;;;292            DEMO_LOG("      last error %d, RIS 0x%02X at that point",
;;;293                     dci_demo_irq.last_err, (unsigned)dci_demo_irq.last_ris);
;;;294        }
;;;295    
;;;296        /*
;;;297         * The hardware's own view, read straight from the registers. This is the part the
;;;298         * counters above cannot tell you: all-zero counts mean either "no signal arrived" or
;;;299         * "the interrupt never reached the CPU", and those have completely different causes.
;;;300         *
;;;301         * RIS latches regardless of IER, so a bit set here proves the PIXCLK/VSYNC/HSYNC edge
;;;302         * physically happened even if no ISR ever ran. The combination is the diagnosis:
;;;303         *
;;;304         *   RIS FRAME=1 but frame count 0 -> the signal is there, the interrupt is not
;;;305         *                                    reaching the CPU (NVIC, vector table, IER)
;;;306         *   RIS all 0, CR.ENABLE=1        -> nothing is arriving on the pins at all
;;;307         *   CR.ENABLE=0 or CAPTURE=0      -> the peripheral was never actually started
;;;308         */
;;;309        {
;;;310            uint32_t ris = DCI->RIS;
;;;311            uint32_t ier = DCI->IER;
;;;312            DCI_CR_TypeDef cr = {.d32 = DCI->CR};
;;;313            DCI_SR_TypeDef sr = {.d32 = DCI->SR};
;;;314    
;;;315            DEMO_LOG("      RIS 0x%02X [frame=%u ovr=%u err=%u vsync=%u line=%u]"
;;;316                     "  IER 0x%02X",
;;;317                     (unsigned)(ris & 0x1FU),
;;;318                     (unsigned)((ris >> 0) & 1U), (unsigned)((ris >> 1) & 1U),
;;;319                     (unsigned)((ris >> 2) & 1U), (unsigned)((ris >> 3) & 1U),
;;;320                     (unsigned)((ris >> 4) & 1U), (unsigned)(ier & 0x1FU));
;;;321            DEMO_LOG("      CR enable=%u capture=%u   SR fne=%u vsync=%u hsync=%u",
;;;322                     (unsigned)cr.b.enable, (unsigned)cr.b.capture,
;;;323                     (unsigned)sr.b.fne, (unsigned)sr.b.vsync, (unsigned)sr.b.hsync);
;;;324    
;;;325            if (cr.b.enable == 0)
;;;326            {
;;;327                DEMO_LOG("      -> CR.ENABLE is 0: the peripheral is not running");
;;;328            }
;;;329            else if ((ris & DCI_INT_FRAME) != 0 && dci_demo_irq.frame == 0)
;;;330            {
;;;331                DEMO_LOG("      -> FRAME latched in RIS but never counted: the signal is");
;;;332                DEMO_LOG("         arriving, the INTERRUPT is not reaching the CPU");
;;;333            }
;;;334            else if ((ris & 0x1FU) == 0)
;;;335            {
;;;336                /*
;;;337                 * Nothing has ever latched. DO NOT read the SR levels as a diagnosis here -
;;;338                 * that mistake was made once already and it cost a board-level debug session.
;;;339                 *
;;;340                 * SR is COMBINATIONAL on the pin XOR the polarity bit, and it is one sample
;;;341                 * at one instant. Two consequences, both of which make a single read useless:
;;;342                 *
;;;343                 *   - flipping hspol/vspol flips the reading with the pin untouched, so a
;;;344                 *     changed SR proves nothing about the wire;
;;;345                 *   - HSYNC is in its active state for most of a line (~85% at 320 of ~376
;;;346                 *     pclk) and VSYNC for most of a frame, so "reads active" is the overwhelmingly
;;;347                 *     likely sample for a perfectly healthy signal AND for a pin stuck high.
;;;348                 *
;;;349                 * What is diagnostic is that RIS is 0 while IER has LINE enabled: RIS latches
;;;350                 * regardless of IER, so not one line boundary has been recognised. Together
;;;351                 * with FNE=0 (not one word ever entered the FIFO) the fault is upstream of the
;;;352                 * DMA - which is why the DMA registers all looking correct is not reassuring,
;;;353                 * it is simply irrelevant.
;;;354                 *
;;;355                 * The measurement that separates the remaining causes is whether the sync pins
;;;356                 * TOGGLE over a window longer than a frame. dci_demo_sync_probe() does that.
;;;357                 */
;;;358                DEMO_LOG("      -> nothing latched with ENABLE=1, and LINE is enabled in IER.");
;;;359                DEMO_LOG("         RIS latches whether or not the interrupt is enabled, so");
;;;360                DEMO_LOG("         not one line boundary has been recognised. FNE=%u: no word",
;;;361                         (unsigned)sr.b.fne);
;;;362                DEMO_LOG("         ever entered the DCI FIFO either, so this is UPSTREAM of");
;;;363                DEMO_LOG("         the DMA - the DMA registers being correct means nothing.");
;;;364                DEMO_LOG("         The SR levels above are ONE SAMPLE of a level that is");
;;;365                DEMO_LOG("         active most of the time anyway - not evidence either way.");
;;;366                DEMO_LOG("         Run dci_demo_sync_probe() for the measurement that is.");
;;;367            }
;;;368        }
;;;369    }
;;;370    
;;;371    /*============================================================================*
;;;372     *                         Sync probe
;;;373     *============================================================================*/
;;;374    /*
;;;375     * Sample SR in a tight loop for longer than a frame period and report whether the sync
;;;376     * inputs ever CHANGE. This is the measurement a single SR read cannot make, and it needs
;;;377     * no oscilloscope and no reg-dump build.
;;;378     *
;;;379     * Why it is the decisive step when RIS stays 0:
;;;380     *
;;;381     *   sync toggles, RIS still 0  -> the sync wires are alive and DCI is not counting, so
;;;382     *                                 PIXCLK is not reaching the peripheral. DCI advances its
;;;383     *                                 state machine on PIXCLK; with no clock there is no line
;;;384     *                                 boundary, no FIFO write and no frame, whatever the sync
;;;385     *                                 pins do. THIS IS THE ONE THAT MATCHES A CORRECT-LOOKING
;;;386     *                                 DMA AND AN ALL-ZERO RIS.
;;;387     *   sync never toggles         -> the sensor is not emitting, or the pin is not routed.
;;;388     *                                 A stuck level, which is what SR alone is mistaken for.
;;;389     *   HSYNC toggles, VSYNC not   -> VSYNC unrouted, or the window was shorter than a frame.
;;;390     *                                 The printed window length says which.
;;;391     *   RIS becomes non-zero       -> it was working and the earlier read was simply too early.
;;;392     *
;;;393     * The duty cycle is printed as a cross-check on top: for the configured geometry HSYNC
;;;394     * should be active for roughly pclk_per_line / total_line_pclk of the time. A duty cycle
;;;395     * of 0% or 100% is a stuck pin even if the edge counter caught a glitch.
;;;396     *
;;;397     * SR and RIS are both read-only with no side effects, so this is safe with a capture
;;;398     * armed. DR is deliberately NOT touched: reading it pops the FIFO.
;;;399     */
;;;400    void dci_demo_sync_probe(void)
;;;401    {
;;;402        /* Bit positions of SR, from the register table in rtl_dci_def.h. */
;;;403        const uint32_t SR_HSYNC = 1U << 0;
;;;404        const uint32_t SR_VSYNC = 1U << 1;
;;;405        const uint32_t SR_FNE   = 1U << 2;
;;;406    
;;;407        uint32_t i;
;;;408        uint32_t prev;
;;;409        uint32_t h_edges = 0, v_edges = 0;
;;;410        uint32_t h_active = 0, v_active = 0, fne_seen = 0;
;;;411        uint32_t ris_acc;
;;;412        uint32_t taken = 0;
;;;413    
;;;414        DEMO_LOG("  --- sync probe: up to %u samples of SR, looking for EDGES ---",
;;;415                 (unsigned)DCI_DEMO_SYNC_PROBE_SAMPLES);
;;;416    
;;;417        ris_acc = DCI->RIS;
        0x000098c4:    6842        Bh      LDR      r2,[r0,#4]
;;;418        prev    = DCI->SR;
        0x000098c6:    6800        .h      LDR      r0,[r0,#0]
;;;419    
;;;420        for (i = 0; i < DCI_DEMO_SYNC_PROBE_SAMPLES; i++)
        0x000098c8:    4b98        .K      LDR      r3,[pc,#608] ; [0x9b2c] = 0x30d40
        0x000098ca:    42bb        .B      CMP      r3,r7
        0x000098cc:    d065        e.      BEQ      0x999a ; dci_demo_sync_probe + 246
        0x000098ce:    4b98        .K      LDR      r3,[pc,#608] ; [0x9b30] = 0x40643004
;;;421        {
;;;422            uint32_t cur = DCI->SR;
        0x000098d0:    f8d39000    ....    LDR      r9,[r3,#0]
;;;423    
;;;424            ris_acc |= DCI->RIS;
        0x000098d4:    685e        ^h      LDR      r6,[r3,#4]
;;;425    
;;;426            if (((cur ^ prev) & SR_HSYNC) != 0)
        0x000098d6:    ea890800    ....    EOR      r8,r9,r0
        0x000098da:    ea5f70c8    _..p    LSLS     r0,r8,#31
        0x000098de:    d013        ..      BEQ      0x9908 ; dci_demo_sync_probe + 100
;;;427            {
;;;428                h_edges++;
;;;429    
;;;430                /*
;;;431                 * Report the FIRST edge on each line the moment it happens, rather than only
;;;432                 * in the summary. The summary is worth nothing if the log is cut off before
;;;433                 * the loop ends - which is exactly what happened on the first run of this
;;;434                 * probe: the banner appeared and nothing else. One line per SIGNAL, not per
;;;435                 * edge, so this cannot flood: at most two extra lines for the whole probe.
;;;436                 *
;;;437                 * It also answers the question early. "HSYNC toggles" is already most of the
;;;438                 * diagnosis, and waiting 200 000 samples to say so is a pointless delay when
;;;439                 * the interesting case is a board that is producing nothing.
;;;440                 */
;;;441                if (h_edges == 1)
        0x000098e0:    f1ba0f00    ....    CMP      r10,#0
        0x000098e4:    d002        ..      BEQ      0x98ec ; dci_demo_sync_probe + 72
        0x000098e6:    f10a0a01    ....    ADD      r10,r10,#1
        0x000098ea:    e00d        ..      B        0x9908 ; dci_demo_sync_probe + 100
        0x000098ec:    468a        .F      MOV      r10,r1
;;;442                {
;;;443                    DEMO_LOG("      HSYNC TOGGLES (first edge at sample %u)", (unsigned)i);
        0x000098ee:    a091        ..      ADR      r0,{pc}+0x246 ; 0x9b34
        0x000098f0:    4639        9F      MOV      r1,r7
