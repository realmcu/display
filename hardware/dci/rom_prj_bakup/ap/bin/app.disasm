;;;439                break;
;;;440            }
;;;441        case I2C_INT_TX_OVER:
;;;442            {
;;;443                (void)I2Cx->IC_CLR_TX_OVER;
;;;444                break;
;;;445            }
;;;446        case I2C_INT_RD_REQ:
;;;447            {
;;;448                (void)I2Cx->IC_CLR_RD_REQ;
;;;449                break;
