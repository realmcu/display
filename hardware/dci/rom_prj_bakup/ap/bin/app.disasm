;;;264    /*
;;;265     * Every counter that should be zero after a clean run, checked as a group. A single
;;;266     * non-zero counter is the cheapest early warning available: an image can look right
;;;267     * while suspend_count climbs into the hundreds.
;;;268     */
;;;269    dci_demo_result_t dci_demo_check_stats(uint32_t expect_frames)
;;;270    {
;;;271        DCI_stats_t s;
