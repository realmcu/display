;;;469    /*
;;;470     * Mirrors dci_calc_geometry() in rtl_dci.c, from the table row instead of from
;;;471     * DCI_InitTypeDef. Same order, same rounding:
;;;472     *
;;;473     *   line_bytes = pclk_per_line x bytes_per_pclk     (crop replaces pclk_per_line)
;;;474     *   line_bytes = line_bytes / bsm_den x bsm_num     (byte select)
;;;475     *   lines_out  = lsm ? (oels ? h/2 : ceil(h/2)) : h (line select)
;;;476     *
;;;477     * Byte select is the subtle one: the group has to divide the line exactly. The driver
;;;478     * refuses it otherwise rather than rounding (dci_demo_bsm_divides() below), so the
;;;479     * division here is only ever exact - if it truncated, the cross-check against
;;;480     * DCI_Capture_GetFrameInfo() would fire on the next line of output.
;;;481     */
