;;;2095       DCI->IER    = 0;
;;;2096       DCI->ESCR   = 0;
;;;2097       DCI->ESUR   = 0;
;;;2098       DCI->CWSTRT = 0;
;;;2099       DCI->CWSIZE = 0;
;;;2100       DCI->ICR    = DCI_INT_ALL;
