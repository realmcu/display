;;;6      
;;;7      /*
;;;8       * DCI demo: the test cases.
;;;9       *
;;;10      * Three cases: a register self test, a snapshot case and a continuous case. Each is a
;;;11      * linear script - readable top to bottom, breakpoint-friendly on any line - built from
;;;12      * the shared setup in dci_demo.c plus whatever assertions are specific to it. Nothing
;;;13      * here duplicates the setup sequence.
;;;14      *
;;;15      * A case is a different PROCEDURE. Anything that is the same procedure with a different
;;;16      * number in it is a macro in dci_demo_config.h instead, which is why what used to be
;;;17      * snapshot-x2, continuous-1buf, stress and config-only are now DCI_DEMO_SHOTS,
;;;18      * DCI_DEMO_BUF_COUNT + DCI_DEMO_FILL_MODE, DCI_DEMO_FRAMES and DCI_DEMO_NO_CAPTURE.
;;;19      *
;;;20      * A case takes a RESOLVED configuration (dci_demo_cfg_t): the signal row chosen by
;;;21      * DCI_DEMO_SIGNAL with the overlay macros applied and the geometry already derived. No
;;;22      * case recomputes a frame size, so there is exactly one formula to be wrong.
;;;23      *
;;;24      * Both capture cases use POLL notification, except continuous when it has to hold a
;;;25      * frame: the driver's WaitFrame() is a bounded busy-wait designed for exactly this, no OS
;;;26      * required, but deciding WHICH frame to keep has to happen in the frame interrupt.
;;;27      *
;;;28      * Interrupt counting and the frame_ready / frame_error handlers live in dci_demo_irq.c,
;;;29      * shared by every case, because "the image looked right but the sync count drifted" is
;;;30      * precisely the fault those counters exist to expose.
;;;31      *
;;;32      * Every case is wrapped in DEMO_CASE_IS(), so only the one selected in
;;;33      * dci_demo_config.h is compiled. That keeps an unfinished case from breaking the build
;;;34      * of the one under test, and keeps the image down to what is actually being run.
;;;35      */
;;;36     
;;;37     #include <string.h>
;;;38     #include "dci_demo.h"
;;;39     #include "dci_demo_buf.h"
;;;40     #include "dci_demo_case.h"
;;;41     
;;;42     /** \brief  True when the config selected this case. */
;;;43     #define DEMO_CASE_IS(c)     (DCI_DEMO_CASE == (c))
;;;44     
;;;45     /*
;;;46      * The shared helpers below are only referenced by the capture cases. Compiling them for
;;;47      * REG_TEST would produce unused-function warnings on every build, so they are gated on
;;;48      * "is this a capture case" rather than left unconditional.
;;;49      */
;;;50     #define DEMO_IS_CAPTURE_CASE                    \
;;;51         (DEMO_CASE_IS(DCI_DEMO_CASE_SNAPSHOT) ||    \
;;;52          DEMO_CASE_IS(DCI_DEMO_CASE_CONTINUOUS))
;;;53     
;;;54     /*
;;;55      * demo_check_frame() validates a delivered frame. Two builds never call it: NO_CAPTURE
;;;56      * (no frame is ever delivered) and the continuous hold path, which deliberately asserts
;;;57      * almost nothing - a short or long frame is what the dump is there to explain, so it is
;;;58      * reported rather than judged.
;;;59      */
;;;60     #define DEMO_NEEDS_FRAME_CHECK                                              \
;;;61         ((DEMO_CASE_IS(DCI_DEMO_CASE_SNAPSHOT) && (DCI_DEMO_NO_CAPTURE == 0)) || \
;;;62          (DEMO_CASE_IS(DCI_DEMO_CASE_CONTINUOUS) && (DCI_DEMO_CAPTURE_FRAME == 0)))
;;;63     
;;;64     /*
;;;65      * DCI_DEMO_DUMP_LEVEL applies to the cases that stop between frames. A streaming case
;;;66      * pins it to 0 no matter what the config says: a 424 KB frame is roughly 7 s of hex at
;;;67      * 1 Mbps, and printing that between frames causes the very overruns the case exists to
;;;68      * detect. Naming the two levels here keeps that reasoning in one place instead of
;;;69      * appearing as an unexplained literal at each call site.
;;;70      */
;;;71     #define DEMO_DUMP_ONESHOT       DCI_DEMO_DUMP_LEVEL
;;;72     #define DEMO_DUMP_STREAM        0
;;;73     
;;;74     /*
;;;75      * The frame wait is split into slices so it can report progress. DCI_Capture_WaitFrame()
;;;76      * spins a count rather than reading a clock, and prints nothing while it does, so a
;;;77      * single call with the full budget is indistinguishable from a hang. 10 ms per slice is
;;;78      * well over one frame period at any sane rate, so a frame that is coming still arrives
;;;79      * inside the first slice.
;;;80      */
;;;81     #define DEMO_WAIT_SLICE_MS      10
;;;82     #define DEMO_WAIT_SLICES        ((DCI_DEMO_TIMEOUT_MS + DEMO_WAIT_SLICE_MS - 1) \
;;;83                                      / DEMO_WAIT_SLICE_MS)
;;;84     
;;;85     /*
;;;86      * DMA ERROR interrupts seen by the SoC layer. Declared here rather than reached through
;;;87      * rtl_dci_dma.h, because that header is the SoC port's own and the demo has no business
;;;88      * including it; one extern for one diagnostic counter is the smaller coupling. Returns 0
;;;89      * on a port that does not track them.
;;;90      */
;;;91     extern uint32_t rtl_dci_dma_err_count(void);
;;;92     
;;;93     /*============================================================================*
;;;94      *                         Frame validation
;;;95      *============================================================================*/
;;;96     /*
;;;97      * Everything checkable about a delivered frame without knowing what the camera was
;;;98      * pointed at. Content-independent by design: a real sensor looking at a real scene
;;;99      * has no golden data to compare against, so the assertions have to be structural.
;;;100     */
