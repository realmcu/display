;;;223    /**
;;;224     * @brief Fill each I2C_InitStruct member with its default value.
;;;225     *
;;;226     * @param[in] I2C_InitStruct  Pointer to a I2C_InitTypeDef structure which will be initialized.
;;;227     */
;;;228    void I2C_StructInit(I2C_InitTypeDef *I2C_InitStruct)
;;;229    {
;;;230        /* I2C source clock is 40MHz, depending on clock divider */
;;;231        I2C_InitStruct->I2C_Clock             = 40000000;
;;;232        /* I2C SCK freqency is 400KHz */
;;;233        I2C_InitStruct->I2C_ClockSpeed        = 400000;
;;;234        /* Master mode */
;;;235        I2C_InitStruct->I2C_DeviceMode        = I2C_DEVICE_MODE_MASTER;
;;;236        /* 7-bit address mode */
