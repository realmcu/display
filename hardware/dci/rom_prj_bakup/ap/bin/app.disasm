;;;727    /*
;;;728     * Runs after the delivery call has returned, never before: a consumer may finish
;;;729     * in the frame_ready callback and release the buffer synchronously, in which case
;;;730     * there is nothing to gate. Checking first would waste a frame (DESIGN.md 8.2).
;;;731     */
;;;732    static void dci_gate_check(uint8_t next_group)
;;;733    {
;;;734        uint32_t s;
;;;735    
;;;736        if (dci.dma.on_busy == DCI_ON_BUSY_OVERWRITE)
;;;737        {
;;;738            return;
;;;739        }
;;;740    
;;;741        s = rtl_dci_lock();
