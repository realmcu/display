;;;108    /*============================================================================*
;;;109     *                         Channel programming
;;;110     *============================================================================*/
;;;111    void rtl_dci_dma_arm(uint8_t channel_num, uint32_t src, uint32_t dar,
;;;112                         uint32_t block_ts, const DCI_DMA_LLIDef *lli_head,
;;;113                         uint8_t priority)
;;;114    {
        0x00007fc8:    e92d43f0    -..C    PUSH     {r4-r9,lr}
        0x00007fcc:    b093        ..      SUB      sp,sp,#0x4c
        0x00007fce:    4698        .F      MOV      r8,r3
        0x00007fd0:    4617        .F      MOV      r7,r2
        0x00007fd2:    460c        .F      MOV      r4,r1
