;;;2239           return;
;;;2240       }
;;;2241       cr.d32   = snap->cr;
        0x00007696:    e9d49100    ....    LDRD     r9,r1,[r4,#0]
        0x0000769a:    f89425a8    ...%    LDRB     r2,[r4,#0x5a8]
        0x0000769e:    f89435a9    ...5    LDRB     r3,[r4,#0x5a9]
