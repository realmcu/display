;;;515    /*
;;;516     * An interrupt with no consumer is left masked. OVR/ERR/FRAME are always on
;;;517     * because the driver itself needs them; VSYNC and LINE follow their callbacks.
;;;518     * LINE in particular is 28k/s at 466 lines @60fps, which is why ST's
;;;519     * unconditional LINE | VSYNC | ERR | OVR default is not copied (DESIGN.md 11.4).
;;;520     */
;;;521    static void dci_int_config(void)
;;;522    {
;;;523        uint32_t en = DCI_INT_FRAME | DCI_INT_OVR | DCI_INT_ERR;
;;;524    
;;;525        if (dci.dma.vsync_event != NULL)
;;;526        {
;;;527            en |= DCI_INT_VSYNC;
;;;528        }
;;;529        if (dci.dma.line_event != NULL)
;;;530        {
;;;531            en |= DCI_INT_LINE;
;;;532        }
;;;533        DCI->IER = en;
;;;534    }
;;;535    
;;;536    /*
;;;537     * A closed ring never presents LLP = 0, so transfer-complete can never fire and
;;;538     * the group-last block is the only completion signal. The LLP = 0 topologies are
;;;539     * the mirror image: Transfer fires and means the data exceeded the quota
;;;540     * (DESIGN.md 6.4).
;;;541     */
;;;542    static void dci_dma_int_config(void)
;;;543    {
;;;544        rtl_dci_dma_int_select(dci.dma.dma_channel_num, dci.ring_closed);
;;;545    }
;;;546    
;;;547    /*============================================================================*
;;;548     *                     Descriptor Ring (DESIGN.md 6.4)
;;;549     *============================================================================*/
;;;550    /* Words and byte offset of chunk i inside one frame. */
;;;551    static void dci_chunk_span(uint8_t i, uint32_t *words, uint32_t *offset)
;;;552    {
;;;553        if (dci.g.var_len)
;;;554        {
;;;555            *words  = dci.g.chunk_words;
;;;556            *offset = 0;
;;;557        }
;;;558        else if (dci.g.line_aligned)
;;;559        {
;;;560            uint32_t first = (uint32_t)i * dci.g.lines_per_chunk;
;;;561            uint32_t lines = dci.g.lines_out - first;
;;;562    
;;;563            if (lines > dci.g.lines_per_chunk)
;;;564            {
;;;565                lines = dci.g.lines_per_chunk;
;;;566            }
;;;567            *words  = lines * dci.g.line_words;
;;;568            *offset = first * dci.g.line_bytes;
;;;569        }
;;;570        else
;;;571        {
;;;572            uint32_t first = (uint32_t)i * dci.g.chunk_words;
;;;573            uint32_t words_left = dci.g.frame_words - first;
;;;574    
;;;575            *words  = (words_left > dci.g.chunk_words) ? dci.g.chunk_words : words_left;
;;;576            *offset = first * 4;
;;;577        }
;;;578    }
;;;579    
;;;580    /*
;;;581     * One group of chunks_per_frame descriptors per buffer. CONTINUOUS links the
;;;582     * groups head to tail into a closed ring so the hardware switches buffers on its
