;;;575            *words  = (words_left > dci.g.chunk_words) ? dci.g.chunk_words : words_left;
;;;576            *offset = first * 4;
;;;577        }
;;;578    }
;;;579    
;;;580    /*
;;;581     * One group of chunks_per_frame descriptors per buffer. CONTINUOUS links the
;;;582     * groups head to tail into a closed ring so the hardware switches buffers on its
;;;583     * own; SNAPSHOT leaves each group ending at LLP = 0 so the channel stops dead
;;;584     * and can be reloaded from a known state on the next Start().
;;;585     */
;;;586    static void dci_build_ring(void)
;;;587    {
;;;588        uint8_t  ch       = dci.dma.dma_channel_num;
;;;589        uint32_t ctl_lli  = rtl_dci_dma_ctl_low(ch, true);
;;;590        uint32_t ctl_term = rtl_dci_dma_ctl_low(ch, false);
;;;591        uint8_t  chunks   = dci.g.chunks_per_frame;
;;;592        uint8_t  k, i;
;;;593    
;;;594        memset(dci_lli_ring, 0, sizeof(dci_lli_ring));
;;;595    
;;;596        for (k = 0; k < dci.dma.buf_count; k++)
;;;597        {
;;;598            for (i = 0; i < chunks; i++)
;;;599            {
;;;600                uint8_t  d = (uint8_t)(k * chunks + i);
;;;601                uint32_t words, offset;
;;;602                bool     last = (i == chunks - 1);
;;;603    
;;;604                dci_chunk_span(i, &words, &offset);
;;;605    
;;;606                dci_lli_ring[d].SAR      = (uint32_t)&DCI->DR;
;;;607                dci_lli_ring[d].DAR      = (uint32_t)dci.dma.buf[k] + offset;
;;;608                dci_lli_ring[d].CTL_HIGH = words;
;;;609    
;;;610                if (!last)
;;;611                {
;;;612                    dci_lli_ring[d].LLP     = (uint32_t)&dci_lli_ring[d + 1];
;;;613                    dci_lli_ring[d].CTL_LOW = ctl_lli;
;;;614                }
;;;615                else if (dci.ring_closed)
;;;616                {
;;;617                    uint8_t next = (uint8_t)(((k + 1) % dci.dma.buf_count) * chunks);
;;;618    
;;;619                    dci_lli_ring[d].LLP     = (uint32_t)&dci_lli_ring[next];
;;;620                    dci_lli_ring[d].CTL_LOW = ctl_lli;
;;;621                }
;;;622                else
;;;623                {
;;;624                    dci_lli_ring[d].LLP     = 0;
;;;625                    dci_lli_ring[d].CTL_LOW = ctl_term;
;;;626                }
;;;627            }
;;;628        }
;;;629    }
;;;630    
;;;631    /*
;;;632     * Loads the channel for one group and opens the gate. The channel registers are
;;;633     * programmed with the contents of the group's first descriptor on purpose: the
;;;634     * two DW DMAC conventions (start from the register set, or fetch the first LLI)
;;;635     * then produce the same block sequence.
;;;636     */
;;;637    static void dci_arm(uint8_t group)
;;;638    {
;;;639        uint8_t ch   = dci.dma.dma_channel_num;
        0x0000697c:    7e34        4~      LDRB     r4,[r6,#0x18]
        0x0000697e:    7e70        p~      LDRB     r0,[r6,#0x19]
;;;640        uint8_t head = (uint8_t)(group * dci.g.chunks_per_frame);
        0x00006980:    4369        iC      MULS     r1,r5,r1
;;;641    
;;;642        rtl_dci_dma_arm(ch, (uint32_t)&DCI->DR, dci_lli_ring[head].DAR,
        0x00006982:    b2ca        ..      UXTB     r2,r1
        0x00006984:    0092        ..      LSLS     r2,r2,#2
        0x00006986:    fa52f181    R...    UXTAB    r1,r2,r1
        0x0000698a:    4a14        .J      LDR      r2,[pc,#80] ; [0x69dc] = 0x2000150c
        0x0000698c:    eb020181    ....    ADD      r1,r2,r1,LSL #2
        0x00006990:    684a        Jh      LDR      r2,[r1,#4]
        0x00006992:    690b        .i      LDR      r3,[r1,#0x10]
        0x00006994:    e9cd1000    ....    STRD     r1,r0,[sp,#0]
        0x00006998:    f1070128    ..(.    ADD      r1,r7,#0x28
        0x0000699c:    4620         F      MOV      r0,r4
        0x0000699e:    f001fb13    ....    BL       rtl_dci_dma_arm ; 0x7fc8
;;;643                        dci_lli_ring[head].CTL_HIGH, &dci_lli_ring[head],
