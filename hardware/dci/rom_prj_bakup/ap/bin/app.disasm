;;;781    /*============================================================================*
;;;782     *                     Resync (DESIGN.md 7.2.1)
;;;783     *============================================================================*/
;;;784    /*
;;;785     * A counting DMA cannot be spliced back onto a stream that lost words, so
;;;786     * recovery is always tear down and restart from a frame boundary - never
;;;787     * "continue". ST does the same (unconditional HAL_DMA_Abort_IT on OVR/ERR).
;;;788     */
;;;789    static void dci_resync(void)
;;;790    {
;;;791        (void)dci_capture_off(DCI_WAIT_CAPTURE_ISR_ITER);
;;;792        dci_dma_stop();
