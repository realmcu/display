;;;370    
;;;371    /*============================================================================*
;;;372     *                         Sync probe
;;;373     *============================================================================*/
;;;374    /*
;;;375     * Sample SR in a tight loop for longer than a frame period and report whether the sync
;;;376     * inputs ever CHANGE. This is the measurement a single SR read cannot make, and it needs
;;;377     * no oscilloscope and no reg-dump build.
;;;378     *
;;;379     * Why it is the decisive step when RIS stays 0:
;;;380     *
;;;381     *   sync toggles, RIS still 0  -> the sync wires are alive and DCI is not counting, so
;;;382     *                                 PIXCLK is not reaching the peripheral. DCI advances its
;;;383     *                                 state machine on PIXCLK; with no clock there is no line
;;;384     *                                 boundary, no FIFO write and no frame, whatever the sync
;;;385     *                                 pins do. THIS IS THE ONE THAT MATCHES A CORRECT-LOOKING
;;;386     *                                 DMA AND AN ALL-ZERO RIS.
;;;387     *   sync never toggles         -> the sensor is not emitting, or the pin is not routed.
;;;388     *                                 A stuck level, which is what SR alone is mistaken for.
;;;389     *   HSYNC toggles, VSYNC not   -> VSYNC unrouted, or the window was shorter than a frame.
;;;390     *                                 The printed window length says which.
;;;391     *   RIS becomes non-zero       -> it was working and the earlier read was simply too early.
;;;392     *
;;;393     * The duty cycle is printed as a cross-check on top: for the configured geometry HSYNC
;;;394     * should be active for roughly pclk_per_line / total_line_pclk of the time. A duty cycle
;;;395     * of 0% or 100% is a stuck pin even if the edge counter caught a glitch.
;;;396     *
;;;397     * SR and RIS are both read-only with no side effects, so this is safe with a capture
;;;398     * armed. DR is deliberately NOT touched: reading it pops the FIFO.
;;;399     */
;;;400    void dci_demo_sync_probe(void)
;;;401    {
        0x000098a4:    e92d4ff0    -..O    PUSH     {r4-r11,lr}
        0x000098a8:    b085        ..      SUB      sp,sp,#0x14
        0x000098aa:    49a0        .I      LDR      r1,[pc,#640] ; [0x9b2c] = 0x30d40
        0x000098ac:    a08f        ..      ADR      r0,{pc}+0x240 ; 0x9aec
        0x000098ae:    f7fbfa5d    ..].    BL       log_direct ; 0x4d6c
        0x000098b2:    489f        .H      LDR      r0,[pc,#636] ; [0x9b30] = 0x40643004
        0x000098b4:    f04f0a00    O...    MOV      r10,#0
;;; ../../../../../display/hardware/dci/test\dci_demo_irq.c
        0x000098b8:    f04f0b00    O...    MOV      r11,#0
        0x000098bc:    2100        .!      MOVS     r1,#0
        0x000098be:    2400        .$      MOVS     r4,#0
        0x000098c0:    2500        .%      MOVS     r5,#0
        0x000098c2:    2700        .'      MOVS     r7,#0
