;;;825    
;;;826    /**
;;;827     * @brief Check whether the specified SPI interrupt is set.
;;;828     *
;;;829     * @param[in] SPIx  Select the SPI peripheral, refer to @ref SPI_DECLARATION.
;;;830     * @param[in] SPI_IT  Specifies the SPI interrupt to check.
;;;831     *            This parameter can be one of the following values, refer to @ref SPI_INTERRUPT.
;;;832     *            - SPI_INT_TXE: Transmit FIFO threshold interrupt. Triggered when the transmit FIFO level is less than or equal to the threshold.
;;;833     *            - SPI_INT_TXO: Transmit FIFO overflow interrupt.
;;;834     *            - SPI_INT_RXU: Receive FIFO underflow interrupt.
;;;835     *            - SPI_INT_RXO: Receive FIFO overflow interrupt.
;;;836     *            - SPI_INT_RXF: Receive FIFO threshold interrupt. Triggered when the receive FIFO level is greater than or equal to the threshold.
;;;837     *            - SPI_INT_MST: Multi-master contention interrupt. (master only)
;;;838     *            - SPI_INT_FAE: The data of slave RX does not match DFS. (slave only)
;;;839     *            - SPI_INT_TUF: Transmit FIFO underflow interrupt. (slave only)
;;;840     *            - SPI_INT_RIG: CS rising edge detect interrupt. (slave only)
;;;841     *            - SPI_INT_WRAP_TXE: Wrap mode transmit FIFO empty interrupt.
;;;842     *            - SPI_INT_WRAP_TXO: Wrap mode transmit FIFO overflow interrupt.
;;;843     *            - SPI_INT_WRAP_TXD: Wrap mode transmit done interrupt.
;;;844     *
