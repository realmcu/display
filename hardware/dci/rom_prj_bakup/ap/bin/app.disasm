;;;1834   {
;;;1835       {"CR",     0x00, DCI_CR_RW_MASK    },
;;;1836       {"SR",     0x04, 0                 },  /* read-only */
;;;1837       {"RIS",    0x08, 0                 },  /* read-only */
;;;1838       {"IER",    0x0C, DCI_IER_RW_MASK   },
;;;1839       {"MIS",    0x10, 0                 },  /* read-only */
;;;1840       {"ICR",    0x14, 0                 },  /* write-1-only, checked separately */
