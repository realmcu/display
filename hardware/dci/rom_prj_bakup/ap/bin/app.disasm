;;;251    /*
;;;252     * Leaves the peripheral idle so a reset-less rerun starts from a known state rather
;;;253     * than inheriting a running ring.
;;;254     *
;;;255     * Skipped whenever a frame is still held for a dump (DEMO_SKIP_TEARDOWN): Abort()
;;;256     * invalidates every delivered frame by contract, which would destroy exactly the data the
;;;257     * printed address points at.
;;;258     */
;;;259    void dci_demo_teardown(void)
;;;260    {
;;;261        DCI_Capture_Abort();
;;;262    }
