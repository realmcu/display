;;;515    /*
;;;516     * An interrupt with no consumer is left masked. OVR/ERR/FRAME are always on
;;;517     * because the driver itself needs them; VSYNC and LINE follow their callbacks.
;;;518     * LINE in particular is 28k/s at 466 lines @60fps, which is why ST's
;;;519     * unconditional LINE | VSYNC | ERR | OVR default is not copied (DESIGN.md 11.4).
;;;520     */
