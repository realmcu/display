;;;743        {
;;;744            rtl_dci_unlock(s);
;;;745            return;
;;;746        }
;;;747        dci.state = DCI_STATE_SUSPENDED;
;;;748        dci.stats.suspend_count++;
;;;749        rtl_dci_unlock(s);
;;;750    
;;;751        /* Stops at the frame boundary. The DMA channel is untouched, so it stays
;;;752         * parked at the start of the next group with 0 words transferred - the reason
;;;753         * a resume needs no DMA work at all, exactly like ST's HAL_DCMI_Resume. */
;;;754        (void)dci_capture_off(DCI_WAIT_CAPTURE_ISR_ITER);
;;;755    }
;;;756    
;;;757    /*
;;;758     * CONTINUOUS JPEG only: the gate decision and the channel reload are the same
;;;759     * decision point, so they share one path (DESIGN.md 9.4 step 4).
;;;760     */
;;;761    static void dci_rearm_or_gate(void)
;;;762    {
;;;763        uint8_t  next;
;;;764        uint32_t s = rtl_dci_lock();
;;;765    
;;;766        next = (uint8_t)((dci.cur_group + 1) % dci.dma.buf_count);
;;;767        dci.cur_group = next;
;;;768    
;;;769        if (dci.dma.on_busy == DCI_ON_BUSY_GATE && (dci.buf_lock_mask & BIT(next)) != 0)
;;;770        {
;;;771            dci.state = DCI_STATE_SUSPENDED;
;;;772            dci.stats.suspend_count++;
