;;;127    
;;;128    /*============================================================================*
;;;129     *                         Delivery
;;;130     *============================================================================*/
;;;131    /*
;;;132     * The per-frame interrupt handler, in the sense that matters to a user of this demo: the
;;;133     * driver's IT_FRAME handler settles the frame and then delivers it here.
;;;134     *
;;;135     * Three things happen per frame, in this order:
;;;136     *
;;;137     *   1. the line count of the frame that just ended is latched and the counter restarted,
;;;138     *      because it is only meaningful per frame;
;;;139     *   2. optionally one line is printed - this frame's lines and the cumulative sync count,
;;;140     *      which together say whether the receiver and the camera still agree on geometry;
;;;141     *   3. the buffer is released, unless this is the frame being kept.
;;;142     *
;;;143     * Step 3 is what implements "capture frame N": not releasing it leaves it locked, and
;;;144     * under the GATE policy the driver stops capture when the ring next needs that buffer.
;;;145     * The data is then static without the thread having to stop the DMA at the right instant.
;;;146     */
;;;147    void dci_demo_on_frame_ready(const DCI_frame_t *frame)
;;;148    {
;;;149        uint32_t n;
;;;150    
;;;151        dci_demo_irq.frame++;
;;;152        dci_demo_irq.ready++;
;;;153        dci_demo_irq.last_seq = frame->seq;
;;;154        n = dci_demo_irq.ready;
;;;155    
;;;156        /* Per-frame, so latch and restart. Read once - LINE can fire between these two
;;;157         * statements if the next frame has already started. */
;;;158        dci_demo_irq.line_prev = dci_demo_irq.line;
;;;159        dci_demo_irq.line      = 0;
;;;160    
;;;161    #if (DCI_DEMO_IRQ_LOG == 1)
;;;162        /*
;;;163         * One line per frame. The line count is 0 unless DCI_DEMO_IRQ_LINE is on, and the
;;;164         * sync count is 0 unless DCI_DEMO_IRQ_VSYNC is on; both are printed regardless so
;;;165         * the format does not change with the build - a log that is missing a column is
;;;166         * harder to read than one with a zero in it.
;;;167         */
;;;168        DEMO_LOG("[IRQ] frame %u  seq %u  buf %u  %u B  lines %u  vsync %u (total)",
;;;169                 (unsigned)n, (unsigned)frame->seq, frame->index,
;;;170                 (unsigned)frame->bytes, (unsigned)dci_demo_irq.line_prev,
;;;171                 (unsigned)dci_demo_irq.vsync);
;;;172    #endif
;;;173    
;;;174        if (demo_hold_target != 0 && n == demo_hold_target)
;;;175        {
;;;176            /*
;;;177             * Stop the pixel flow here rather than in the thread. This runs at the frame
;;;178             * boundary, which is the last moment at which no byte of the next frame has
;;;179             * been written yet - a thread that polls for demo_hold_done and then stops
;;;180             * capture is already a frame period late, and with one buffer that is a frame
;;;181             * period of overwriting.
;;;182             *
;;;183             * Only CR.capture is touched, which is a single register write and legal from
;;;184             * an ISR. The driver's own state is left to DCI_Capture_Stop() in the thread:
;;;185             * that path is graceful, so the frame stays delivered and the buffer stays
;;;186             * locked. Abort() would clear the lock and is exactly what must not happen.
;;;187             */
;;;188            DCI_CaptureCmd(DISABLE);
