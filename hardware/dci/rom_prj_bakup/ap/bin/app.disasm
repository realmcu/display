;;;332        DEMO_LOG(" shots  : %d%s", DCI_DEMO_SHOTS,
;;;333                 (DCI_DEMO_SHOTS > 1) ? "  (rotation check: shot 1 held while 2 is taken)"
;;;334                 : "");
;;;335        DEMO_LOG(" capture: %s", (DCI_DEMO_NO_CAPTURE != 0)
;;;336                 ? "NO - configure and dump registers only"
;;;337                 : "yes - frame held on delivery, address printed for JLink");
;;;338    #elif DEMO_CASE_IS_CONTINUOUS
;;;339        DEMO_LOG(" frames : %d", DCI_DEMO_FRAMES);
;;;340    #if (DCI_DEMO_CAPTURE_FRAME != 0)
;;;341        DEMO_LOG(" hold   : frame %d, kept for a JLink dump", DCI_DEMO_CAPTURE_FRAME);
;;;342    #else
;;;343        DEMO_LOG(" hold   : no - every frame released, nothing static to dump");
;;;344    #endif
;;;345    #endif
