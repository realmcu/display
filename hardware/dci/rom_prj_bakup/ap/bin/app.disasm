;;;700            {
;;;701                dci.ready_count++;
;;;702            }
;;;703            else
;;;704            {
;;;705                /* Full: the oldest entry is the one being overwritten. */
;;;706                dci.ready_head = (uint8_t)((dci.ready_head + 1) % dci.dma.buf_count);
;;;707            }
