;;;751        /* Stops at the frame boundary. The DMA channel is untouched, so it stays
;;;752         * parked at the start of the next group with 0 words transferred - the reason
;;;753         * a resume needs no DMA work at all, exactly like ST's HAL_DCMI_Resume. */
;;;754        (void)dci_capture_off(DCI_WAIT_CAPTURE_ISR_ITER);
