;;;327    
;;;328    /*============================================================================*
;;;329     *                         10-bit packing
;;;330     *============================================================================*/
;;;331    /*
;;;332     * Under EDM = 10BIT the hardware packs one sample per 16-bit half-word, value in
;;;333     * bits 9:0 and bits 15:10 cleared (DESIGN.md 2, "数据打包"). That makes this the
;;;334     * only format in the table with a per-sample invariant that holds regardless of what
;;;335     * the camera is pointed at - every other content check can only ask "did anything
;;;336     * arrive". So it is worth checking exhaustively rather than by sampling.
;;;337     *
;;;338     * What a violation tells you, in order of likelihood:
;;;339     *   - all half-words have high bits set    -> EDM never took effect; the capture is
;;;340     *                                             actually running 8-bit, so pairs of
;;;341     *                                             8-bit pixels are being read as one
;;;342     *                                             10-bit sample
;;;343     *   - every other half-word is affected    -> half-word phase is off by one byte,
;;;344     *                                             i.e. a block boundary landed mid-sample
;;;345     *   - a contiguous tail is affected        -> the frame is longer than declared and
;;;346     *                                             the excess is being written as 8-bit
;;;347     *
;;;348     * Returns the count so the caller can distinguish those patterns; 0 means clean.
;;;349     */
;;;350    uint32_t dci_demo_buf_raw10_bad_samples(const DCI_frame_t *f, uint32_t report_max)
;;;351    {
;;;352        const uint16_t *s = (const uint16_t *)(const void *)f->addr;
;;;353        uint32_t        samples = f->bytes / 2;
;;;354        uint32_t        bad = 0;
;;;355        uint32_t        reported = 0;
;;;356        uint32_t        i;
;;;357    
;;;358        if (f->addr == NULL || samples == 0)
;;;359        {
;;;360            return 0;
;;;361        }
