;;;631    /*
;;;632     * Loads the channel for one group and opens the gate. The channel registers are
;;;633     * programmed with the contents of the group's first descriptor on purpose: the
;;;634     * two DW DMAC conventions (start from the register set, or fetch the first LLI)
;;;635     * then produce the same block sequence.
