;;;27     #define I2C_SCL_LOW_PERIOD_COMPENSATE                (1)
;;;28     
;;;29     #define NS_PER_SECOND                                (1000000000)
;;;30     /* I2C SCL High/Low min period according to spec */
;;;31     #define I2C_FAST_MODE_PLUS_SCL_LOW_PERIOD_MIN_NS     (500)
;;;32     #define I2C_FAST_MODE_PLUS_SCL_HIGH_PERIOD_MIN_NS    (260)
;;;33     #define I2C_FAST_MODE_SCL_LOW_PERIOD_MIN_NS          (1300)
;;;34     #define I2C_FAST_MODE_SCL_HIGH_PERIOD_MIN_NS         (600)
;;;35     #define I2C_STANDARD_MODE_SCL_LOW_PERIOD_MIN_NS      (4700)
;;;36     #define I2C_STANDARD_MODE_SCL_HIGH_PERIOD_MIN_NS     (4000)
;;;37     /* SDA Hold Time */
;;;38     #define I2C_STANDARD_FAST_MODE_SDA_HOLD_TIME_NS      (600)
;;;39     #define I2C_FAST_MODE_PLUS_SDA_HOLD_TIME_NS          (300)
;;;40     #define I2C_TIMEOUT_SCALE                            (256)
;;;41     #define I2C_TIMEOUT_MIN_US                           (20000)
