;;;597        {
;;;598            for (i = 0; i < chunks; i++)
;;;599            {
;;;600                uint8_t  d = (uint8_t)(k * chunks + i);
;;;601                uint32_t words, offset;
;;;602                bool     last = (i == chunks - 1);
;;;603    
;;;604                dci_chunk_span(i, &words, &offset);
;;;605    
;;;606                dci_lli_ring[d].SAR      = (uint32_t)&DCI->DR;
;;;607                dci_lli_ring[d].DAR      = (uint32_t)dci.dma.buf[k] + offset;
;;;608                dci_lli_ring[d].CTL_HIGH = words;
;;;609    
;;;610                if (!last)
;;;611                {
;;;612                    dci_lli_ring[d].LLP     = (uint32_t)&dci_lli_ring[d + 1];
;;;613                    dci_lli_ring[d].CTL_LOW = ctl_lli;
;;;614                }
;;;615                else if (dci.ring_closed)
;;;616                {
;;;617                    uint8_t next = (uint8_t)(((k + 1) % dci.dma.buf_count) * chunks);
;;;618    
;;;619                    dci_lli_ring[d].LLP     = (uint32_t)&dci_lli_ring[next];
;;;620                    dci_lli_ring[d].CTL_LOW = ctl_lli;
;;;621                }
;;;622                else
;;;623                {
;;;624                    dci_lli_ring[d].LLP     = 0;
;;;625                    dci_lli_ring[d].CTL_LOW = ctl_term;
;;;626                }
