        0x00009d00:    e02c        ,.      B        0x9d5c ; dci_demo_cfg_resolve + 168
        0x00009d02:    7c01        .|      LDRB     r1,[r0,#0x10]
        0x00009d04:    2201        ."      MOVS     r2,#1
        0x00009d06:    2601        .&      MOVS     r6,#1
        0x00009d08:    2905        .)      CMP      r1,#5
        0x00009d0a:    d803        ..      BHI      0x9d14 ; dci_demo_cfg_resolve + 96
        0x00009d0c:    4b16        .K      LDR      r3,[pc,#88] ; [0x9d68] = 0xc35c
        0x00009d0e:    eb0303c1    ....    ADD      r3,r3,r1,LSL #3
