;;;803        /* Restart from group 0. ready_head needs no fixing: it re-derives itself from
;;;804         * the next delivery whenever the queue is empty, and while the queue is not
;;;805         * empty its rotation order is still valid. */
;;;806        if (dci.dma.on_busy == DCI_ON_BUSY_GATE && (dci.buf_lock_mask & BIT(0)) != 0)
;;;807        {
;;;808            dci.cur_group = 0;
;;;809            dci.state     = DCI_STATE_SUSPENDED;
;;;810            dci.stats.suspend_count++;
;;;811            return;
;;;812        }
;;;813        dci_arm(0);
;;;814        dci.state = DCI_STATE_BUSY;
;;;815    }
;;;816    
;;;817    /*============================================================================*
;;;818     *                     Frame Completion (DESIGN.md 7.2)
;;;819     *============================================================================*/
;;;820    /*
;;;821     * Shared by the three LLP = 0 topologies: both SNAPSHOT variants and CONTINUOUS
;;;822     * JPEG. All three stop the DMA dead at the end of the frame, which makes
;;;823     * CURR_DAR trustworthy, so IT_FRAME alone settles the frame - no rendezvous.
;;;824     */
;;;825    static void dci_finish_stopped(bool over_quota, uint32_t ris)
;;;826    {
;;;827        uint8_t   k   = dci.cur_group;
;;;828        DCI_ERROR err = DCI_SUCCESS;
;;;829        uint32_t  bytes;
;;;830    
;;;831        /* CONTINUOUS does not self-clear CAPTURE, so close the gate first and do not
;;;832         * gamble on finishing the reload inside the vertical blanking. Worst case is
;;;833         * one cleanly skipped frame instead of an overrun (DESIGN.md 9.4 step 1). */
;;;834        if (dci.mode == DCI_MODE_CONTINUOUS || over_quota)
;;;835        {
;;;836            (void)dci_capture_off(DCI_WAIT_CAPTURE_ISR_ITER);
;;;837        }
;;;838    
;;;839        (void)dci_wait_fifo_empty();
;;;840    
;;;841        if (over_quota || dci.xfer_seen)
;;;842        {
;;;843            /* The block filled, so exactly its quota reached memory. */
;;;844            bytes = dci.g.var_len ? dci.dma.buf_bytes : dci.g.frame_bytes;
;;;845            if (over_quota)
;;;846            {
;;;847                err = dci.g.var_len ? DCI_ERROR_BUF_OVERFLOW : DCI_ERROR_FRAME_LONG;
;;;848            }
;;;849        }
;;;850        else
;;;851        {
;;;852            bytes = rtl_dci_dma_curr_dar(dci.dma.dma_channel_num) -
;;;853                    (uint32_t)dci.dma.buf[k];
;;;854            if (!dci.g.var_len && bytes < dci.g.frame_bytes)
;;;855            {
;;;856                /* spec 2.6 guarantees IT_FRAME even for a short frame, so this is
;;;857                 * observable rather than silent corruption. It usually means the
;;;858                 * declared sensor geometry is larger than the real output. */
;;;859                err = DCI_ERROR_FRAME_SHORT;
;;;860            }
;;;861        }
;;;862    
;;;863        dci_dma_stop();
;;;864    
;;;865        /* Delivered even when truncated: the buffer holds a clean prefix, and only
;;;866         * the delivery path locks it. Reporting the error without delivering would
;;;867         * leave the buffer ownerless and the next Start() would overwrite it under
;;;868         * the consumer (DESIGN.md 9.2). */
;;;869        dci_deliver(k, bytes, err != DCI_SUCCESS);
;;;870    
;;;871        if (dci.mode == DCI_MODE_SNAPSHOT)
;;;872        {
;;;873            /* Rotate so a following Start() fills the other buffer while the consumer
;;;874             * still works on this one (DESIGN.md 6.4). Also on the error paths: a
;;;875             * truncated frame is still held by the consumer, so a retry belongs in
;;;876             * the other buffer. */
;;;877            dci.cur_group = (uint8_t)((k + 1) % dci.dma.buf_count);
;;;878        }
;;;879    
;;;880        if (err != DCI_SUCCESS)
;;;881        {
;;;882            if (err == DCI_ERROR_BUF_OVERFLOW)
;;;883            {
;;;884                dci.stats.buf_overflow++;
;;;885            }
;;;886            dci.state = DCI_STATE_ERROR;
;;;887            dci_report(err, ris);
;;;888            return;
;;;889        }
;;;890    
;;;891        if (dci.mode == DCI_MODE_SNAPSHOT)
;;;892        {
;;;893            dci.state = DCI_STATE_IDLE;
;;;894            return;
;;;895        }
;;;896    
;;;897        dci_rearm_or_gate();
;;;898    }
;;;899    
;;;900    /*
;;;901     * CONTINUOUS fixed length: the closed ring gives no Transfer event, so the frame
;;;902     * is settled by a rendezvous between IT_FRAME and the group-last block. Whichever
;;;903     * arrives first only sets its bit; the same bit set twice in a row means the
;;;904     * other half never came, which catches both a short and a long frame and cannot
;;;905     * misfire on the first frame (DESIGN.md 7.2).
;;;906     */
;;;907    static void dci_rendezvous(uint8_t bit, uint32_t ris)
;;;908    {
;;;909        uint8_t  k, next;
;;;910        uint32_t s = rtl_dci_lock();
;;;911    
;;;912        if ((dci.evt & bit) != 0)
;;;913        {
;;;914            dci.evt = 0;
;;;915            rtl_dci_unlock(s);
;;;916            dci.state = DCI_STATE_ERROR;
;;;917            dci_resync();
;;;918            dci_report(DCI_ERROR_DESYNC, ris);
;;;919            return;
;;;920        }
;;;921        dci.evt |= bit;
;;;922    
;;;923        if (dci.evt != (DCI_EVT_FRAME | DCI_EVT_BLOCK))
;;;924        {
;;;925            rtl_dci_unlock(s);
;;;926            return;
;;;927        }
;;;928        dci.evt = 0;
;;;929    
;;;930        k    = dci.cur_group;
;;;931        next = (uint8_t)((k + 1) % dci.dma.buf_count);
;;;932        dci.cur_group = next;
;;;933        rtl_dci_unlock(s);
;;;934    
;;;935        /* The group-last block completing is what proves BLOCK_TS words reached
;;;936         * memory; the closed ring means CURR_DAR has already moved on, so the length
;;;937         * is the declared frame size (DESIGN.md 7.2 note). */
;;;938        dci_deliver(k, dci.g.frame_bytes, false);
;;;939        dci_gate_check(next);
;;;940    }
