;;;441         * transposed x/y or w/h shows up as a shifted window rather than a failure. */
;;;442        c->crop_w = (uint16_t)(s->width  / 2);
;;;443        c->crop_h = (uint16_t)(s->height / 2);
;;;444        c->crop_x = (uint16_t)(s->width  / 4);
;;;445        c->crop_y = (uint16_t)(s->height / 4);
;;;446    #elif (DCI_DEMO_OV_CROP == DCI_DEMO_CROP_ORIGIN)
;;;447        /* The x0 = y0 = 0 boundary. Worth its own setting because an off-by-one in
