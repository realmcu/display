;;;325        /* spec 2.7: JPEG rules out crop and embedded sync. spec 2.4: embedded codes
;;;326         * are 8-bit only. Register table: BSM is valid only when EDM[1:0] = 00. */
;;;327        if (init->jpeg && (init->crop || init->sync == DCI_SYNC_EMBEDDED))
;;;328        {
;;;329            return DCI_ERROR_MODE_CONFLICT;
