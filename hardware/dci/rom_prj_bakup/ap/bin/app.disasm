;;;55     /**
;;;56      * @brief Deinitialize the I2Cx peripheral registers to their default reset values.
;;;57      *
;;;58      * @param[in] I2Cx  Select the I2C peripheral, refer to @ref I2C_DECLARATION.
;;;59      */
;;;60     void I2C_DeInit(I2C_TypeDef *I2Cx)
;;;61     {
;;;62         /* Check the parameters */
;;;63         assert_param(IS_I2C_ALL_PERIPH(I2Cx));
;;;64     
;;;65         /*Disable I2C IP*/
;;;66     #ifdef I2C0
;;;67         if (I2Cx == I2C0)
;;;68         {
;;;69             RCC_ClockCmd(I2C0_CLOCK, DISABLE);
;;;70             return;
;;;71         }
;;;72     #endif
;;;73     #ifdef I2C1
;;;74         if (I2Cx == I2C1)
;;;75         {
;;;76             RCC_ClockCmd(I2C1_CLOCK, DISABLE);
;;;77             return;
;;;78         }
;;;79     #endif
;;;80     #ifdef I2C2
;;;81         if (I2Cx == I2C2)
;;;82         {
;;;83             RCC_ClockCmd(I2C2_CLOCK, DISABLE);
;;;84             return;
;;;85         }
;;;86     #endif
;;;87     #ifdef I2C3
;;;88         if (I2Cx == I2C3)
;;;89         {
;;;90             RCC_ClockCmd(I2C3_CLOCK, DISABLE);
;;;91             return;
;;;92         }
;;;93     #endif
;;;94     }
