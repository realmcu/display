;;;657    
;;;658    /*============================================================================*
;;;659     *                     Delivery and Back-pressure (DESIGN.md 8, 11)
;;;660     *============================================================================*/
;;;661    /*
;;;662     * Hands buffer k to the consumer and takes ownership away from the driver. The
;;;663     * lock happens here, at delivery, not when the consumer collects: a completed but
;;;664     * uncollected buffer left unlocked would be overwritten once the ring came round
