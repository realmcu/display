;;;7      /*
;;;8       * DCI demo: entry point, compile-time case selection and shared setup.
;;;9       *
;;;10      * The switch over DCI_DEMO_CASE is resolved by the preprocessor, so only the selected
;;;11      * case is compiled and linked. The alternative - a table of function pointers - would
;;;12      * pull every case into the image and, more importantly, would make the framebuffer
;;;13      * pool sized for the worst case rather than the chosen one. At a 1 MB budget that
;;;14      * difference decides whether the largest signal rows are runnable at all.
;;;15      *
;;;16      * The setup sequence (pool, init, crop, interrupt install, geometry cross-check) is
;;;17      * shared because it is identical for every capture case, and duplicating it per case is
;;;18      * how the copies drift apart.
;;;19      */
;;;20     
;;;21     #include <string.h>
;;;22     #include "dci_demo.h"
;;;23     #include "dci_demo_buf.h"
;;;24     #include "dci_demo_case.h"
;;;25     
;;;26     /*============================================================================*
;;;27      *                         Selected case
;;;28      *============================================================================*/
;;;29     /*
;;;30      * One name per case, resolved here so the rest of the file has a single symbol to call
;;;31      * and a single string to print.
;;;32      *
;;;33      *   DEMO_NEEDS_CONFIG   the case is handed a resolved signal row. Off only for REG_TEST,
;;;34      *                       which is about the peripheral rather than the signal.
;;;35      *   DEMO_NEEDS_SIGNAL   a live camera must be driving the pins. Printed in the banner so
;;;36      *                       a missing sensor is stated up front rather than surfacing as a
;;;37      *                       timeout thirty seconds later.
;;;38      *   DEMO_SKIP_TEARDOWN  the case owns a buffer after it returns, so the usual Abort()
;;;39      *                       must not run - Abort() invalidates every delivered frame by
;;;40      *                       contract (DESIGN.md 11.5).
;;;41      *
;;;42      * Nothing pins the buffer count any more: what used to need a dedicated case is now a
;;;43      * macro combination, and dci_demo_config.h rejects the combinations that cannot work.
;;;44      */
;;;45     #if   (DCI_DEMO_CASE == DCI_DEMO_CASE_REG_TEST)
;;;46     #define DEMO_NAME               "reg-test"
;;;47     #define DEMO_ENTRY              dci_demo_case_reg_test
;;;48     #define DEMO_NEEDS_CONFIG       0
;;;49     #define DEMO_NEEDS_SIGNAL       0
;;;50     
;;;51     #elif (DCI_DEMO_CASE == DCI_DEMO_CASE_SNAPSHOT)
;;;52     #define DEMO_NAME               "snapshot"
;;;53     #define DEMO_ENTRY              dci_demo_case_snapshot
;;;54     #define DEMO_NEEDS_CONFIG       1
;;;55     /* NO_CAPTURE stops after the configuration is applied and dumped, so no pixels are
;;;56      * needed and the banner should not claim otherwise. */
;;;57     #define DEMO_NEEDS_SIGNAL       (DCI_DEMO_NO_CAPTURE == 0)
;;;58     /* A snapshot frame stays valid after the case returns - CAPTURE self-clears at frame end,
;;;59      * so the data is static and the printed address is dumpable. Tearing down with Abort()
;;;60      * would invalidate exactly what the user is about to dump. */
;;;61     #define DEMO_SKIP_TEARDOWN      (DCI_DEMO_NO_CAPTURE == 0)
;;;62     
;;;63     #elif (DCI_DEMO_CASE == DCI_DEMO_CASE_CONTINUOUS)
;;;64     #define DEMO_NAME               "continuous"
;;;65     #define DEMO_ENTRY              dci_demo_case_continuous
;;;66     #define DEMO_NEEDS_CONFIG       1
;;;67     #define DEMO_NEEDS_SIGNAL       1
;;;68     /* Only when a frame is being held for a dump; a plain run releases everything and can be
;;;69      * torn down normally. */
;;;70     #define DEMO_SKIP_TEARDOWN      (DCI_DEMO_CAPTURE_FRAME != 0)
;;;71     
;;;72     #else
;;;73     #error "DCI_DEMO_CASE selects no known case - see dci_demo_id.h"
;;;74     #endif
