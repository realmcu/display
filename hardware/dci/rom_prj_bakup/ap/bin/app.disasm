;;;672        if ((dci.buf_lock_mask & BIT(k)) != 0)
;;;673        {
;;;674            /* Only reachable under OVERWRITE: delivered before, never collected. The
;;;675             * consumer sees it as a gap in seq. */
;;;676            dci.stats.frames_dropped++;
;;;677        }
;;;678        dci.buf_lock_mask |= (uint8_t)BIT(k);
;;;679    
;;;680        dci.stats.seq++;
;;;681        dci.stats.frames_done++;
;;;682        dci.last_bytes = bytes;
