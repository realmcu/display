;;;1910            * reserved bit that is not really reserved, or bits bleeding into each
;;;1911            * other. Restricted to rw_mask so that self-setting status bits elsewhere
;;;1912            * in the word cannot cause a false alarm. */
;;;1913           it->stuck_1 |= (rb & d->rw_mask & ~w);
;;;1914       }
;;;1915   
;;;1916       for (i = 0; i < sizeof(pat) / sizeof(pat[0]); i++)
