;;;650    /**
;;;651     * @brief Read data in master mode through the I2Cx peripheral.
;;;652     *
;;;653     * @param[in] I2Cx   Select the I2C peripheral, refer to @ref I2C_DECLARATION.
;;;654     * @param[out] pBuf  Data buffer to receive data.
;;;655     * @param[in] len    Read data length.
;;;656     *
;;;657     * @return The status of I2Cx, refer to @ref I2C_STATUS.
;;;658     * @retval I2C_SUCCESS              I2C transfer success.
;;;659     * @retval I2C_ARB_LOST             Master or slave transmitter has lost arbitration.
;;;660     * @retval I2C_ABRT_MASTER_DIS      Master operation initiated with the master mode disabled.
;;;661     * @retval I2C_ABRT_TXDATA_NOACK    Transmitted data byte was not acknowledged by the slave.
;;;662     * @retval I2C_ABRT_10ADDR2_NOACK   Second byte of the 10-bit address was not acknowledged by any slave.
