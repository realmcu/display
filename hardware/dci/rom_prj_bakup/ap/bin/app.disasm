;;;2034       DCI->CWSIZE = DCI_CWSIZE_RW_MASK;
;;;2035       cw.d32      = DCI->CWSIZE;
;;;2036       r->capcnt_low_forced = ((cw.b.capcnt & 0x3U) == 0);
