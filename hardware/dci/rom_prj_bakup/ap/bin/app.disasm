;;;252     *            - IR_INT_TX_FINISH: TX finish interrupt.
;;;253     *            - IR_INT_RF_FULL: RX FIFO full interrupt.
;;;254     *            - IR_INT_RF_LEVEL: RX FIFO threshold interrupt.
;;;255     *            - IR_INT_RX_CNT_OF: RX counter overflow interrupt.
;;;256     *            - IR_INT_RF_OF: RX FIFO overflow interrupt.
;;;257     *            - IR_INT_RX_CNT_THR: RX counter threshold interrupt.
;;;258     *            - IR_INT_RF_ERROR: RX FIFO error read interrupt. Trigger when RX FIFO empty and read RX FIFO.
;;;259     *            - IR_INT_RISING_EDGE: IR RX rising edge interrupt.
;;;260     *            - IR_INT_FALLING_EDGE: IR RX falling edge interrupt.
;;;261     * @param[in] NewState New state of the specified IR interrupt.
