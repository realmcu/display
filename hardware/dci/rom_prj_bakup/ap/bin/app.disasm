;;;192        if (err != DCI_SUCCESS)
;;;193        {
;;;194            DEMO_LOG("  Capture_Init failed: %d", err);
;;;195            if (err == DCI_ERROR_BUF_TOO_SMALL)
;;;196            {
;;;197                DEMO_LOG("  -> allocated %u B for a declared %u x %u pclk frame; Init "
;;;198                         "measures the UNCROPPED size", (unsigned)dci_demo_buf_bytes(),
;;;199                         c->pclk_per_line, c->lines_in);
;;;200            }
;;;201            return DEMO_FAIL_INIT;
;;;202        }
;;;203    
;;;204        /* Crop must follow Init: Capture_Init() does not take a window. The pclk values are
