;;;120    static void dci_dma_isr(void);
;;;121    
;;;122    /*============================================================================*
;;;123     *                           Polling Helpers
;;;124     *============================================================================*/
;;;125    /*
;;;126     * Clearing CAPTURE only takes effect at the end of the frame in flight, so the
;;;127     * bit has to be read back to know the frame boundary was reached. Same as ST's
;;;128     * HAL_DCMI_Suspend / HAL_DCMI_Stop.
;;;129     */
