;;;175    {
;;;176        switch (bsm)
;;;177        {
;;;178        case DCI_BSM_EVERY_2ND:
;;;179            *num = 1;
;;;180            *den = 2;
;;;181            break;
;;;182        case DCI_BSM_1_OF_4:
;;;183            *num = 1;
;;;184            *den = 4;
;;;185            break;
;;;186        case DCI_BSM_2_OF_4:
;;;187            *num = 2;
;;;188            *den = 4;
;;;189            break;
;;;190        default:
;;;191            *num = 1;
;;;192            *den = 1;
;;;193            break;
;;;194        }
;;;195    }
