        0x000084d2:    2814        .(      CMP      r0,#0x14
        0x000084d4:    d002        ..      BEQ      0x84dc ; dci_demo_env_init + 36
        0x000084d6:    5141        AQ      STR      r1,[r0,r5]
        0x000084d8:    3004        .0      ADDS     r0,#4
        0x000084da:    e7fa        ..      B        0x84d2 ; dci_demo_env_init + 26
        0x000084dc:    f04f0900    O...    MOV      r9,#0
