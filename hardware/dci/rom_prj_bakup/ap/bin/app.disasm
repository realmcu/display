;;;18     
;;;19     /*============================================================================*
;;;20      *                           Busy-wait Timeouts
;;;21      *============================================================================*/
;;;22     /* Calibrated loop-count safety nets, not precise deadlines - same convention as
;;;23      * IDU_BUSY_WAIT in rtl_idu.c. Overridable per chip. */
;;;24     #ifndef DCI_WAIT_FIFO_ITER
;;;25     #define DCI_WAIT_FIFO_ITER      10000UL     /* channel FIFO drain: tens of bus cycles */
;;;26     #endif
;;;27     
;;;28     #ifndef DCI_WAIT_CAPTURE_ITER
;;;29     #define DCI_WAIT_CAPTURE_ITER   2000000UL   /* thread context: may span a whole frame */
;;;30     #endif
;;;31     
;;;32     /* ISR context: clearing CAPTURE at a frame boundary takes effect within the
;;;33      * vertical blanking, so a short bound is enough. An ISR must never busy-wait for
;;;34      * a frame period; if this expires CAPTURE is still cleared and the hardware stops
;;;35      * at the end of the frame it is in, which is all the gate needs (DESIGN.md 8.2). */
;;;36     #ifndef DCI_WAIT_CAPTURE_ISR_ITER
;;;37     #define DCI_WAIT_CAPTURE_ISR_ITER   10000UL
;;;38     #endif
;;;39     
;;;40     #ifndef DCI_WAIT_ITER_PER_MS
;;;41     #define DCI_WAIT_ITER_PER_MS    20000UL     /* WaitFrame spin budget per ms */
;;;42     #endif
;;;43     
