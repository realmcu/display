;;;3568   /**
;;;3569     \ingroup  CMSIS_core_register
;;;3570     \defgroup CMSIS_DIB       Debug Identification Block
;;;3571     \brief    Type definitions for the Debug Identification Block Registers
;;;3572     @{
;;;3573    */
;;;3574   
;;;3575   /**
;;;3576     \brief  Structure type to access the Debug Identification Block Registers (DIB).
;;;3577    */
;;;3578   typedef struct
;;;3579   {
;;;3580       __OM  uint32_t
;;;3581       DLAR;                   /*!< Offset: 0x000 ( /W)  SCS Software Lock Access Register */
;;;3582       __IM  uint32_t
;;;3583       DLSR;                   /*!< Offset: 0x004 (R/ )  SCS Software Lock Status Register */
;;;3584       __IM  uint32_t
;;;3585       DAUTHSTATUS;            /*!< Offset: 0x008 (R/ )  Debug Authentication Status Register */
;;;3586       __IM  uint32_t DDEVARCH;               /*!< Offset: 0x00C (R/ )  SCS Device Architecture Register */
;;;3587       __IM  uint32_t DDEVTYPE;               /*!< Offset: 0x010 (R/ )  SCS Device Type Register */
;;;3588   } DIB_Type;
;;;3589   
;;;3590   /* DLAR, SCS Software Lock Access Register Definitions */
;;;3591   #define DIB_DLAR_KEY_Pos                    0U                                            /*!< DIB DLAR: KEY Position */
;;;3592   #define DIB_DLAR_KEY_Msk                   (0xFFFFFFFFUL /*<< DIB_DLAR_KEY_Pos */)        /*!< DIB DLAR: KEY Mask */
;;;3593   
;;;3594   /* DLSR, SCS Software Lock Status Register Definitions */
;;;3595   #define DIB_DLSR_nTT_Pos                    2U                                            /*!< DIB DLSR: Not thirty-two bit Position */
;;;3596   #define DIB_DLSR_nTT_Msk                   (0x1UL << DIB_DLSR_nTT_Pos )                   /*!< DIB DLSR: Not thirty-two bit Mask */
;;;3597   
;;;3598   #define DIB_DLSR_SLK_Pos                    1U                                            /*!< DIB DLSR: Software Lock status Position */
;;;3599   #define DIB_DLSR_SLK_Msk                   (0x1UL << DIB_DLSR_SLK_Pos )                   /*!< DIB DLSR: Software Lock status Mask */
;;;3600   
;;;3601   #define DIB_DLSR_SLI_Pos                    0U                                            /*!< DIB DLSR: Software Lock implemented Position */
;;;3602   #define DIB_DLSR_SLI_Msk                   (0x1UL /*<< DIB_DLSR_SLI_Pos*/)                /*!< DIB DLSR: Software Lock implemented Mask */
;;;3603   
;;;3604   /* DAUTHSTATUS, Debug Authentication Status Register Definitions */
;;;3605   #define DIB_DAUTHSTATUS_SUNID_Pos          22U                                            /*!< DIB DAUTHSTATUS: Secure Unprivileged Non-invasive Debug Allowed Position */
;;;3606   #define DIB_DAUTHSTATUS_SUNID_Msk          (0x3UL << DIB_DAUTHSTATUS_SUNID_Pos )          /*!< DIB DAUTHSTATUS: Secure Unprivileged Non-invasive Debug Allowed Mask */
;;;3607   
;;;3608   #define DIB_DAUTHSTATUS_SUID_Pos           20U                                            /*!< DIB DAUTHSTATUS: Secure Unprivileged Invasive Debug Allowed Position */
;;;3609   #define DIB_DAUTHSTATUS_SUID_Msk           (0x3UL << DIB_DAUTHSTATUS_SUID_Pos )           /*!< DIB DAUTHSTATUS: Secure Unprivileged Invasive Debug Allowed Mask */
;;;3610   
;;;3611   #define DIB_DAUTHSTATUS_NSUNID_Pos         18U                                            /*!< DIB DAUTHSTATUS: Non-secure Unprivileged Non-invasive Debug Allo Position */
;;;3612   #define DIB_DAUTHSTATUS_NSUNID_Msk         (0x3UL << DIB_DAUTHSTATUS_NSUNID_Pos )         /*!< DIB DAUTHSTATUS: Non-secure Unprivileged Non-invasive Debug Allo Mask */
;;;3613   
;;;3614   #define DIB_DAUTHSTATUS_NSUID_Pos          16U                                            /*!< DIB DAUTHSTATUS: Non-secure Unprivileged Invasive Debug Allowed Position */
;;;3615   #define DIB_DAUTHSTATUS_NSUID_Msk          (0x3UL << DIB_DAUTHSTATUS_NSUID_Pos )          /*!< DIB DAUTHSTATUS: Non-secure Unprivileged Invasive Debug Allowed Mask */
;;;3616   
;;;3617   #define DIB_DAUTHSTATUS_SNID_Pos            6U                                            /*!< DIB DAUTHSTATUS: Secure Non-invasive Debug Position */
;;;3618   #define DIB_DAUTHSTATUS_SNID_Msk           (0x3UL << DIB_DAUTHSTATUS_SNID_Pos )           /*!< DIB DAUTHSTATUS: Secure Non-invasive Debug Mask */
;;;3619   
;;;3620   #define DIB_DAUTHSTATUS_SID_Pos             4U                                            /*!< DIB DAUTHSTATUS: Secure Invasive Debug Position */
;;;3621   #define DIB_DAUTHSTATUS_SID_Msk            (0x3UL << DIB_DAUTHSTATUS_SID_Pos )            /*!< DIB DAUTHSTATUS: Secure Invasive Debug Mask */
;;;3622   
;;;3623   #define DIB_DAUTHSTATUS_NSNID_Pos           2U                                            /*!< DIB DAUTHSTATUS: Non-secure Non-invasive Debug Position */
;;;3624   #define DIB_DAUTHSTATUS_NSNID_Msk          (0x3UL << DIB_DAUTHSTATUS_NSNID_Pos )          /*!< DIB DAUTHSTATUS: Non-secure Non-invasive Debug Mask */
;;;3625   
;;;3626   #define DIB_DAUTHSTATUS_NSID_Pos            0U                                            /*!< DIB DAUTHSTATUS: Non-secure Invasive Debug Position */
;;;3627   #define DIB_DAUTHSTATUS_NSID_Msk           (0x3UL /*<< DIB_DAUTHSTATUS_NSID_Pos*/)        /*!< DIB DAUTHSTATUS: Non-secure Invasive Debug Mask */
;;;3628   
;;;3629   /* DDEVARCH, SCS Device Architecture Register Definitions */
;;;3630   #define DIB_DDEVARCH_ARCHITECT_Pos         21U                                            /*!< DIB DDEVARCH: Architect Position */
;;;3631   #define DIB_DDEVARCH_ARCHITECT_Msk         (0x7FFUL << DIB_DDEVARCH_ARCHITECT_Pos )       /*!< DIB DDEVARCH: Architect Mask */
;;;3632   
;;;3633   #define DIB_DDEVARCH_PRESENT_Pos           20U                                            /*!< DIB DDEVARCH: DEVARCH Present Position */
;;;3634   #define DIB_DDEVARCH_PRESENT_Msk           (0x1FUL << DIB_DDEVARCH_PRESENT_Pos )          /*!< DIB DDEVARCH: DEVARCH Present Mask */
;;;3635   
;;;3636   #define DIB_DDEVARCH_REVISION_Pos          16U                                            /*!< DIB DDEVARCH: Revision Position */
;;;3637   #define DIB_DDEVARCH_REVISION_Msk          (0xFUL << DIB_DDEVARCH_REVISION_Pos )          /*!< DIB DDEVARCH: Revision Mask */
;;;3638   
;;;3639   #define DIB_DDEVARCH_ARCHVER_Pos           12U                                            /*!< DIB DDEVARCH: Architecture Version Position */
;;;3640   #define DIB_DDEVARCH_ARCHVER_Msk           (0xFUL << DIB_DDEVARCH_ARCHVER_Pos )           /*!< DIB DDEVARCH: Architecture Version Mask */
;;;3641   
;;;3642   #define DIB_DDEVARCH_ARCHPART_Pos           0U                                            /*!< DIB DDEVARCH: Architecture Part Position */
;;;3643   #define DIB_DDEVARCH_ARCHPART_Msk          (0xFFFUL /*<< DIB_DDEVARCH_ARCHPART_Pos*/)     /*!< DIB DDEVARCH: Architecture Part Mask */
;;;3644   
;;;3645   /* DDEVTYPE, SCS Device Type Register Definitions */
;;;3646   #define DIB_DDEVTYPE_SUB_Pos                4U                                            /*!< DIB DDEVTYPE: Sub-type Position */
;;;3647   #define DIB_DDEVTYPE_SUB_Msk               (0xFUL << DIB_DDEVTYPE_SUB_Pos )               /*!< DIB DDEVTYPE: Sub-type Mask */
;;;3648   
;;;3649   #define DIB_DDEVTYPE_MAJOR_Pos              0U                                            /*!< DIB DDEVTYPE: Major type Position */
;;;3650   #define DIB_DDEVTYPE_MAJOR_Msk             (0xFUL /*<< DIB_DDEVTYPE_MAJOR_Pos*/)          /*!< DIB DDEVTYPE: Major type Mask */
;;;3651   
;;;3652   
;;;3653   /*@} end of group CMSIS_DIB */
;;;3654   
;;;3655   
;;;3656   /**
;;;3657     \ingroup    CMSIS_core_register
;;;3658     \defgroup   CMSIS_core_bitfield     Core register bit field macros
;;;3659     \brief      Macros for use with bit field definitions (xxx_Pos, xxx_Msk).
;;;3660     @{
;;;3661    */
;;;3662   
;;;3663   /**
;;;3664     \brief   Mask and shift a bit field value for use in a register bit range.
;;;3665     \param[in] field  Name of the register bit field.
;;;3666     \param[in] value  Value of the bit field. This parameter is interpreted as an uint32_t type.
;;;3667     \return           Masked and shifted value.
;;;3668   */
;;;3669   #define _VAL2FLD(field, value)    (((uint32_t)(value) << field ## _Pos) & field ## _Msk)
;;;3670   
;;;3671   /**
;;;3672     \brief     Mask and shift a register value to extract a bit filed value.
;;;3673     \param[in] field  Name of the register bit field.
;;;3674     \param[in] value  Value of register. This parameter is interpreted as an uint32_t type.
;;;3675     \return           Masked and shifted bit field value.
;;;3676   */
;;;3677   #define _FLD2VAL(field, value)    (((uint32_t)(value) & field ## _Msk) >> field ## _Pos)
;;;3678   
;;;3679   /*@} end of group CMSIS_core_bitfield */
;;;3680   
;;;3681   
;;;3682   /**
;;;3683     \ingroup    CMSIS_core_register
;;;3684     \defgroup   CMSIS_core_base     Core Definitions
;;;3685     \brief      Definitions for base addresses, unions, and structures.
;;;3686     @{
;;;3687    */
;;;3688   
;;;3689   /* Memory mapping of Core Hardware */
;;;3690   #define SCS_BASE            (0xE000E000UL)                             /*!< System Control Space Base Address */
;;;3691   #define ITM_BASE            (0xE0000000UL)                             /*!< ITM Base Address */
;;;3692   #define DWT_BASE            (0xE0001000UL)                             /*!< DWT Base Address */
;;;3693   #define MEMSYSCTL_BASE      (0xE001E000UL)                             /*!< Memory System Control Base Address */
;;;3694   #define ERRBNK_BASE         (0xE001E100UL)                             /*!< Error Banking Base Address */
;;;3695   #define PWRMODCTL_BASE      (0xE001E300UL)                             /*!< Power Mode Control Base Address */
;;;3696   #define EWIC_BASE           (0xE001E400UL)                             /*!< External Wakeup Interrupt Controller Base Address */
;;;3697   #define PRCCFGINF_BASE      (0xE001E700UL)                             /*!< Processor Configuration Information Base Address */
;;;3698   #define STL_BASE            (0xE001E800UL)                             /*!< Software Test Library Base Address */
;;;3699   #ifdef CONFIG_SOC_SERIES_RTL87X3J
;;;3700   /* The base address of rtl87x3j coresight is 0x4404800, TPIU offset is 0x3000 */
;;;3701   #define TPI_BASE            (0x4404B000UL)                             /*!< TPI Base Address */
;;;3702   #else
;;;3703   #define TPI_BASE            (0xE0040000UL)                             /*!< TPI Base Address */
;;;3704   #endif
;;;3705   #define CoreDebug_BASE      (0xE000EDF0UL)                             /*!< \deprecated Core Debug Base Address */
;;;3706   #define DCB_BASE            (0xE000EDF0UL)                             /*!< DCB Base Address */
;;;3707   #define DIB_BASE            (0xE000EFB0UL)                             /*!< DIB Base Address */
;;;3708   #define SysTick_BASE        (SCS_BASE +  0x0010UL)                     /*!< SysTick Base Address */
;;;3709   #define NVIC_BASE           (SCS_BASE +  0x0100UL)                     /*!< NVIC Base Address */
;;;3710   #define SCB_BASE            (SCS_BASE +  0x0D00UL)                     /*!< System Control Block Base Address */
;;;3711   
;;;3712   #define ICB                 ((ICB_Type       *)     SCS_BASE         ) /*!< System control Register not in SCB */
;;;3713   #define SCB                 ((SCB_Type       *)     SCB_BASE         ) /*!< SCB configuration struct */
;;;3714   #define SysTick             ((SysTick_Type   *)     SysTick_BASE     ) /*!< SysTick configuration struct */
;;;3715   #define NVIC                ((NVIC_Type      *)     NVIC_BASE        ) /*!< NVIC configuration struct */
;;;3716   #define ITM                 ((ITM_Type       *)     ITM_BASE         ) /*!< ITM configuration struct */
;;;3717   #define DWT                 ((DWT_Type       *)     DWT_BASE         ) /*!< DWT configuration struct */
;;;3718   #define TPI                 ((TPI_Type       *)     TPI_BASE         ) /*!< TPI configuration struct */
;;;3719   #define MEMSYSCTL           ((MemSysCtl_Type *)     MEMSYSCTL_BASE   ) /*!< Memory System Control configuration struct */
;;;3720   #define ERRBNK              ((ErrBnk_Type    *)     ERRBNK_BASE      ) /*!< Error Banking configuration struct */
;;;3721   #define PWRMODCTL           ((PwrModCtl_Type *)     PWRMODCTL_BASE   ) /*!< Power Mode Control configuration struct */
;;;3722   #define EWIC                ((EWIC_Type      *)     EWIC_BASE        ) /*!< EWIC configuration struct */
;;;3723   #define PRCCFGINF           ((PrcCfgInf_Type *)     PRCCFGINF_BASE   ) /*!< Processor Configuration Information configuration struct */
;;;3724   #define STL                 ((STL_Type       *)     STL_BASE         ) /*!< Software Test Library configuration struct */
;;;3725   #define CoreDebug           ((CoreDebug_Type *)     CoreDebug_BASE   ) /*!< \deprecated Core Debug configuration struct */
;;;3726   #define DCB                 ((DCB_Type       *)     DCB_BASE         ) /*!< DCB configuration struct */
;;;3727   #define DIB                 ((DIB_Type       *)     DIB_BASE         ) /*!< DIB configuration struct */
;;;3728   
;;;3729   #if defined (__MPU_PRESENT) && (__MPU_PRESENT == 1U)
;;;3730   #define MPU_BASE          (SCS_BASE +  0x0D90UL)                     /*!< Memory Protection Unit */
;;;3731   #define MPU               ((MPU_Type       *)     MPU_BASE         ) /*!< Memory Protection Unit */
;;;3732   #endif
;;;3733   
;;;3734   #if defined (__PMU_PRESENT) && (__PMU_PRESENT == 1U)
;;;3735   #define PMU_BASE          (0xE0003000UL)                             /*!< PMU Base Address */
;;;3736   #define PMU               ((PMU_Type       *)     PMU_BASE         ) /*!< PMU configuration struct */
;;;3737   #endif
;;;3738   
;;;3739   #if defined (__ARM_FEATURE_CMSE) && (__ARM_FEATURE_CMSE == 3U)
;;;3740   #define SAU_BASE          (SCS_BASE +  0x0DD0UL)                     /*!< Security Attribution Unit */
;;;3741   #define SAU               ((SAU_Type       *)     SAU_BASE         ) /*!< Security Attribution Unit */
;;;3742   #endif
;;;3743   
;;;3744   #define FPU_BASE            (SCS_BASE +  0x0F30UL)                     /*!< Floating Point Unit */
;;;3745   #define FPU                 ((FPU_Type       *)     FPU_BASE         ) /*!< Floating Point Unit */
;;;3746   
;;;3747   #if defined (__ARM_FEATURE_CMSE) && (__ARM_FEATURE_CMSE == 3U)
;;;3748   #define SCS_BASE_NS         (0xE002E000UL)                             /*!< System Control Space Base Address (non-secure address space) */
;;;3749   #define CoreDebug_BASE_NS   (0xE002EDF0UL)                             /*!< \deprecated Core Debug Base Address           (non-secure address space) */
;;;3750   #define DCB_BASE_NS         (0xE002EDF0UL)                             /*!< DCB Base Address                  (non-secure address space) */
;;;3751   #define DIB_BASE_NS         (0xE002EFB0UL)                             /*!< DIB Base Address                  (non-secure address space) */
;;;3752   #define SysTick_BASE_NS     (SCS_BASE_NS +  0x0010UL)                  /*!< SysTick Base Address              (non-secure address space) */
;;;3753   #define NVIC_BASE_NS        (SCS_BASE_NS +  0x0100UL)                  /*!< NVIC Base Address                 (non-secure address space) */
;;;3754   #define SCB_BASE_NS         (SCS_BASE_NS +  0x0D00UL)                  /*!< System Control Block Base Address (non-secure address space) */
;;;3755   
;;;3756   #define ICB_NS              ((ICB_Type       *)     SCS_BASE_NS      ) /*!< System control Register not in SCB(non-secure address space) */
;;;3757   #define SCB_NS              ((SCB_Type       *)     SCB_BASE_NS      ) /*!< SCB configuration struct          (non-secure address space) */
;;;3758   #define SysTick_NS          ((SysTick_Type   *)     SysTick_BASE_NS  ) /*!< SysTick configuration struct      (non-secure address space) */
;;;3759   #define NVIC_NS             ((NVIC_Type      *)     NVIC_BASE_NS     ) /*!< NVIC configuration struct         (non-secure address space) */
;;;3760   #define CoreDebug_NS        ((CoreDebug_Type *)     CoreDebug_BASE_NS) /*!< \deprecated Core Debug configuration struct   (non-secure address space) */
;;;3761   #define DCB_NS              ((DCB_Type       *)     DCB_BASE_NS      ) /*!< DCB configuration struct          (non-secure address space) */
;;;3762   #define DIB_NS              ((DIB_Type       *)     DIB_BASE_NS      ) /*!< DIB configuration struct          (non-secure address space) */
;;;3763   
;;;3764   #if defined (__MPU_PRESENT) && (__MPU_PRESENT == 1U)
;;;3765   #define MPU_BASE_NS       (SCS_BASE_NS +  0x0D90UL)                  /*!< Memory Protection Unit            (non-secure address space) */
;;;3766   #define MPU_NS            ((MPU_Type       *)     MPU_BASE_NS      ) /*!< Memory Protection Unit            (non-secure address space) */
;;;3767   #endif
;;;3768   
;;;3769   #define FPU_BASE_NS         (SCS_BASE_NS +  0x0F30UL)                  /*!< Floating Point Unit               (non-secure address space) */
;;;3770   #define FPU_NS              ((FPU_Type       *)     FPU_BASE_NS      ) /*!< Floating Point Unit               (non-secure address space) */
;;;3771   
