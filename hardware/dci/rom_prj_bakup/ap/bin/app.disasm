;;;2167   
;;;2168   /*
;;;2169    * DR is never read: it is the FIFO outlet and every read pops a word, so a dump
;;;2170    * would corrupt the capture in progress. Collecting and printing are split
;;;2171    * because the interesting moment is inside the ISR, where printing at pixel rates
;;;2172    * is not an option.
