;;;266            spi_0x00.b.scpol = SPI_InitStruct->SPI_CPOL;
;;;267            spi_0x00.b.dfs = SPI_InitStruct->SPI_DataSize;
;;;268    #if (SPI_SUPPORT_SWAP == 1)
;;;269            spi_0x00.b.tx_byte_swap = SPI_InitStruct->SPI_SwapTxByteEn;
;;;270            spi_0x00.b.tx_bit_swap = SPI_InitStruct->SPI_SwapTxBitEn;
;;;271            spi_0x00.b.rx_byte_swap = SPI_InitStruct->SPI_SwapRxByteEn;
;;;272            spi_0x00.b.rx_bit_swap = SPI_InitStruct->SPI_SwapRxBitEn;
;;;273    #endif
;;;274    
;;;275            /* Enable slave output */
