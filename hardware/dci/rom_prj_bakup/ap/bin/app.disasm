;;;285    #define   __I     volatile             /*!< Defines 'read only' permissions */
;;;286    #else
;;;287    #define   __I     volatile const       /*!< Defines 'read only' permissions */
;;;288    #endif
;;;289    #define     __O     volatile             /*!< Defines 'write only' permissions */
;;;290    #define     __IO    volatile             /*!< Defines 'read / write' permissions */
;;;291    
;;;292    /* following defines should be used for structure members */
;;;293    #define     __IM     volatile const      /*! Defines 'read only' structure member permissions */
;;;294    #define     __OM     volatile            /*! Defines 'write only' structure member permissions */
;;;295    #define     __IOM    volatile            /*! Defines 'read / write' structure member permissions */
