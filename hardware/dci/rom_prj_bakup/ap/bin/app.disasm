;;;125    /*
;;;126     * Clearing CAPTURE only takes effect at the end of the frame in flight, so the
;;;127     * bit has to be read back to know the frame boundary was reached. Same as ST's
;;;128     * HAL_DCMI_Suspend / HAL_DCMI_Stop.
;;;129     */
;;;130    static DCI_ERROR dci_capture_off(uint32_t max_iter)
;;;131    {
;;;132        uint32_t cnt = 0;
;;;133    
;;;134        DCI_CaptureCmd(DISABLE);
;;;135        while (DCI_GetCaptureStatus() != RESET)
;;;136        {
;;;137            if (++cnt > max_iter)
;;;138            {
;;;139                return DCI_ERROR_TIMEOUT;
;;;140            }
;;;141        }
;;;142        return DCI_SUCCESS;
;;;143    }
;;;144    
;;;145    /*
;;;146     * IT_FRAME only says the pixel stream ended; the last words may still sit in the
;;;147     * DMAC channel FIFO. CURR_DAR is short until this drains (DESIGN.md 9.3).
