;;;405        }
;;;406        if (dma->dma_priority > 15)
;;;407        {
;;;408            return DCI_ERROR_INVALID_PARAM;
;;;409        }
;;;410    
;;;411        err = dci_calc_geometry(init, dma, crop, g);
;;;412        if (err != DCI_SUCCESS)
;;;413        {
;;;414            return err;
;;;415        }
;;;416    
;;;417        /* Core invariant: a frame lands entirely inside one buffer, contiguously
;;;418         * (DESIGN.md 6.7). JPEG has no declared length, so there buf_bytes is a
;;;419         * capacity cap and an overrun is reported per frame instead. */
