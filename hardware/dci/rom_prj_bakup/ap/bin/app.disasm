;;;3917   /**
;;;3918     \brief   Set Priority Grouping
;;;3919     \details Sets the priority grouping field using the required unlock sequence.
;;;3920              The parameter PriorityGroup is assigned to the field SCB->AIRCR [10:8] PRIGROUP field.
;;;3921              Only values from 0..7 are used.
;;;3922              In case of a conflict between priority grouping and available
;;;3923              priority bits (__NVIC_PRIO_BITS), the smallest possible priority group is set.
;;;3924     \param [in]      PriorityGroup  Priority grouping field.
;;;3925    */
;;;3926   __STATIC_INLINE void __NVIC_SetPriorityGrouping(uint32_t PriorityGroup)
;;;3927   {
;;;3928       uint32_t reg_value;
;;;3929       uint32_t PriorityGroupTmp = (PriorityGroup & (uint32_t)
;;;3930                                    0x07UL);             /* only values 0..7 are used          */
;;;3931   
;;;3932       reg_value  =
;;;3933           SCB->AIRCR;                                                   /* read old register configuration    */
;;;3934       reg_value &= ~((uint32_t)(SCB_AIRCR_VECTKEY_Msk |
;;;3935                                 SCB_AIRCR_PRIGROUP_Msk)); /* clear bits to change               */
;;;3936       reg_value  = (reg_value                                   |
;;;3937                     ((uint32_t)0x5FAUL << SCB_AIRCR_VECTKEY_Pos) |
;;;3938                     (PriorityGroupTmp <<
;;;3939                      SCB_AIRCR_PRIGROUP_Pos));                /* Insert write key and priority group */
;;;3940       SCB->AIRCR =  reg_value;
;;;3941   }
;;;3942   
;;;3943   
;;;3944   /**
;;;3945     \brief   Get Priority Grouping
;;;3946     \details Reads the priority grouping field from the NVIC Interrupt Controller.
;;;3947     \return                Priority grouping field (SCB->AIRCR [10:8] PRIGROUP field).
;;;3948    */
;;;3949   __STATIC_INLINE uint32_t __NVIC_GetPriorityGrouping(void)
;;;3950   {
;;;3951       return ((uint32_t)((SCB->AIRCR & SCB_AIRCR_PRIGROUP_Msk) >> SCB_AIRCR_PRIGROUP_Pos));
;;;3952   }
