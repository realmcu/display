;;;280    /**
;;;281     * @brief Check if I2C has an abort status.
;;;282     *
;;;283     * @param[in] I2Cx  Select the I2C peripheral, refer to @ref I2C_DECLARATION.
;;;284     *
;;;285     * @return The status of I2Cx, refer to @ref I2C_STATUS.
;;;286     * @retval I2C_SUCCESS              I2C transfer success.
;;;287     * @retval I2C_ARB_LOST             Master or slave transmitter has lost arbitration.
;;;288     * @retval I2C_ABRT_MASTER_DIS      Master operation initiated with the master mode disabled.
;;;289     * @retval I2C_ABRT_TXDATA_NOACK    Transmitted data byte was not acknowledged by the slave.
;;;290     * @retval I2C_ABRT_10ADDR2_NOACK   Second byte of the 10-bit address was not acknowledged by any slave.
;;;291     * @retval I2C_ABRT_10ADDR1_NOACK   First byte of the 10-bit address was not acknowledged by any slave.
;;;292     * @retval I2C_ABRT_7B_ADDR_NOACK   7-bit address was not acknowledged by any slave.
;;;293     * @retval I2C_ERR_TIMEOUT          I2C transfer timeout error.
;;;294     */
;;;295    I2C_Status I2C_CheckAbortStatus(I2C_TypeDef *I2Cx)
;;;296    {
;;;297        uint32_t abort_status = 0;
;;;298    
;;;299        /* Check the parameters */
;;;300        assert_param(IS_I2C_ALL_PERIPH(I2Cx));
;;;301    
;;;302        /* Get abort status */
;;;303        abort_status = I2Cx->IC_TX_ABRT_SOURCE;
;;;304    
;;;305        if (abort_status & MS_ALL_ABORT)
;;;306        {
;;;307            /* Clear abort status */
;;;308            (void)I2Cx->IC_CLR_TX_ABRT;
;;;309    
;;;310            /* Check abort type */
;;;311            if (abort_status & ABRT_TXDATA_NOACK)
;;;312            {
;;;313                return I2C_ABRT_TXDATA_NOACK;
;;;314            }
;;;315    
;;;316            if (abort_status & ABRT_7B_ADDR_NOACK)
;;;317            {
;;;318                return I2C_ABRT_7B_ADDR_NOACK;
;;;319            }
;;;320    
;;;321            if (abort_status & ARB_LOST)
;;;322            {
;;;323                return I2C_ARB_LOST;
;;;324            }
;;;325    
;;;326            if (abort_status & ABRT_MASTER_DIS)
;;;327            {
;;;328                return I2C_ABRT_MASTER_DIS;
;;;329            }
;;;330    
;;;331            if (abort_status & ABRT_10ADDR1_NOACK)
;;;332            {
;;;333                return I2C_ABRT_10ADDR1_NOACK;
;;;334            }
;;;335    
;;;336            if (abort_status & ABRT_10ADDR2_NOACK)
;;;337            {
;;;338                return I2C_ABRT_10ADDR2_NOACK;
;;;339            }
;;;340        }
;;;341    
;;;342        return I2C_SUCCESS;
;;;343    }
