;;;277            SPIx->SPI_M_S_CTRL0 = spi_0x00.d32;
;;;278        }
;;;279    #endif
;;;280        /* Set Tx empty level */
;;;281        SPI_TXFTLR_TypeDef spi_0x18 = {.d32 = SPIx->SPI_TXFTLR};
;;;282        spi_0x18.b.tft = SPI_InitStruct->SPI_TxThresholdLevel;
;;;283        SPIx->SPI_TXFTLR = spi_0x18.d32;
;;;284    
;;;285        /*set Rx full level*/
;;;286        SPI_RXFTLR_TypeDef spi_0x1c = {.d32 = SPIx->SPI_RXFTLR};
;;;287        spi_0x1c.b.rft = SPI_InitStruct->SPI_RxThresholdLevel;
;;;288    
;;;289        /* Config SPI dma mode */
;;;290        SPI_DMACR_TypeDef spi_0x4c = {.d32 = SPIx->SPI_DMACR};
;;;291        spi_0x4c.b.rdmae = SPI_InitStruct->SPI_RxDMAEn;
;;;292        spi_0x4c.b.tdmae = SPI_InitStruct->SPI_TxDMAEn;
;;;293        SPIx->SPI_DMACR = spi_0x4c.d32;
;;;294    
;;;295        /* Config SPI waterlevel */
;;;296        SPI_DMATDLR_TypeDef spi_0x50 = {.d32 = SPIx->SPI_DMATDLR};
;;;297        SPI_DMARDLR_TypeDef spi_0x54 = {.d32 = SPIx->SPI_DMARDLR};
;;;298        spi_0x50.b.dmatdl = SPI_InitStruct->SPI_TxWaterlevel;
;;;299        spi_0x54.b.dmardl = SPI_InitStruct->SPI_RxWaterlevel;
;;;300        SPIx->SPI_DMATDLR = spi_0x50.d32;
;;;301    
;;;302        if (SPI_InitStruct->SPI_RxDMAEn)
;;;303        {
;;;304            /* DMA mode should config DMARDLR later if open AHB */
;;;305            SPIx->SPI_RXFTLR = spi_0x1c.d32;
;;;306            SPIx->SPI_DMARDLR = spi_0x54.d32;
;;;307        }
;;;308        else
;;;309        {
;;;310            /* CPU mode should config RXFTLR later if open AHB */
;;;311            SPIx->SPI_DMARDLR = spi_0x54.d32;
;;;312            SPIx->SPI_RXFTLR = spi_0x1c.d32;
;;;313        }
;;;314    
;;;315        /* Mask SPI interrupt in REG_DW_SSI_IMR */
;;;316        SPIx->SPI_M_S_IMR = 0;
;;;317    }
