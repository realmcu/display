;;;1177            * one-shot request, and "Start did nothing" reads like a hang. */
;;;1178           return DCI_ERROR_BUSY;
;;;1179       }
;;;1180   
;;;1181       err = dci_capture_off(DCI_WAIT_CAPTURE_ITER);
;;;1182       if (err != DCI_SUCCESS)
;;;1183       {
;;;1184           return err;
;;;1185       }
;;;1186       dci_dma_stop();
