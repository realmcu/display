;;;81     {
;;;82         DCI_InitTypeDef      init;
;;;83         DCI_DMA_config       dma;
;;;84         dci_crop_t           crop;
;;;85         dci_geom_t           g;
;;;86     
;;;87         bool                 dma_owned;     /* channel taken from the HAL allocator */
;;;88     
;;;89         DCI_CAPTURE_MODE_T   mode;
;;;90         bool                 mode_fixed;    /* mode is settled by the first Start() */
;;;91         bool                 ring_closed;   /* CONTINUOUS fixed length: LLP never 0 */
;;;92         bool                 armed;         /* channel loaded and enabled for cur_group */
;;;93         bool                 xfer_seen;     /* block filled before IT_FRAME */
;;;94     
;;;95         volatile DCI_CAPTURE_STATE_T state;
;;;96         volatile uint8_t     evt;           /* DCI_EVT_* rendezvous, CONTINUOUS fixed len */
;;;97         uint8_t              cur_group;     /* buffer the DMA is filling */
;;;98         uint8_t              chunk_idx;     /* blocks completed inside the group */
;;;99         uint8_t              buf_lock_mask; /* buffers held by the consumer */
;;;100        uint8_t              ready_head;    /* next buffer handed to the consumer */
;;;101        uint8_t              ready_count;
