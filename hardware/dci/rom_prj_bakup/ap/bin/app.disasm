;;;2039   
;;;2040   DCI_ERROR DCI_RegTest(DCI_regtest_t *report)
;;;2041   {
;;;2042       /* Scratch report for callers that only want the verdict. Initialised at the
;;;2043        * declaration even though the memset below covers it: taking the address of an
;;;2044        * uninitialised object is legal but reads as a defect to static analysis, and
;;;2045        * this runs once at bring-up so the redundant zeroing costs nothing. */
