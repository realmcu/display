;;;7      /*
;;;8       * DCI demo: framebuffer pool.
;;;9       *
;;;10      * A fixed arena carved into 1 or 2 buffers at run time, rather than a static array
;;;11      * per signal row: the demo has to serve rows from 37 KB to 938 KB and only one runs at
;;;12      * a time, so one arena sized to the budget is both smaller and simpler than a union
;;;13      * of worst cases.
;;;14      *
;;;15      * Every buffer is fenced with guard words. That is the cheapest way to catch a
;;;16      * descriptor whose DAR or BLOCK_TS was computed wrong, and a wrong block split shows
;;;17      * up as an out-of-bounds write before it shows up as a wrong image.
;;;18      */
;;;19     
;;;20     #include <string.h>
;;;21     #include "dci_demo.h"
;;;22     #include "dci_demo_buf.h"
;;;23     
;;;24     /*============================================================================*
;;;25      *                         Arena
;;;26      *============================================================================*/
;;;27     #define DEMO_GUARD_WORDS        4
;;;28     #define DEMO_POOL_WORDS         ((DCI_DEMO_POOL_KB * 1024UL) / 4)
;;;29     
;;;30     /*
;;;31      * uint32_t so the arena is word aligned, which is the driver's only hard requirement
;;;32      * on a framebuffer (DESIGN.md 10.4).
;;;33      *
;;;34      * DCI_DEMO_SECTION lets the integrator move this out of the default RW section - on
;;;35      * a part where 256 KB will not fit there, point it at SRAM or PSRAM.
;;;36      */
;;;37     #ifndef DCI_DEMO_SECTION
;;;38     #define DCI_DEMO_SECTION
;;;39     #endif
;;;40     
;;;41     DCI_DEMO_SECTION static uint32_t demo_pool[DEMO_POOL_WORDS];
;;;42     
;;;43     static struct
;;;44     {
;;;45         uint32_t *buf[DCI_MAX_BUF];
;;;46         uint32_t  bytes;            /* usable bytes per buffer */
;;;47         uint8_t   count;
;;;48         bool      valid;
;;;49     } demo_bufs;
;;;50     
;;;51     /*============================================================================*
;;;52      *                         Allocation
;;;53      *============================================================================*/
;;;54     /*
;;;55      * Layout per buffer: [guard][data][guard], with the trailing guard of one buffer
;;;56      * doubling as the leading guard of the next, so a run past the end of buffer 0 is
;;;57      * caught even though buffer 1 begins right after.
;;;58      */
;;;59     bool dci_demo_buf_alloc(uint32_t bytes, uint8_t count)
;;;60     {
;;;61         uint32_t data_words = (bytes + 3) / 4;
;;;62         uint32_t stride;
;;;63         uint32_t w;             /* pool index: must be 32-bit, the pool is > 64 K words */
;;;64         uint8_t  i;
;;;65     
;;;66         demo_bufs.valid = false;
;;;67     
;;;68         if (count == 0 || count > DCI_MAX_BUF || bytes == 0)
;;;69         {
;;;70             return false;
;;;71         }
;;;72     
;;;73         stride = data_words + DEMO_GUARD_WORDS;
;;;74         if ((stride * count + DEMO_GUARD_WORDS) > DEMO_POOL_WORDS)
;;;75         {
;;;76             DEMO_LOG("  pool too small: need %u B for %u x %u B, have %u B",
;;;77                      (unsigned)((stride * count + DEMO_GUARD_WORDS) * 4),
;;;78                      count, (unsigned)bytes, (unsigned)(DCI_DEMO_POOL_KB * 1024UL));
;;;79             return false;
;;;80         }
;;;81     
;;;82         /* Guard everything first, then hand out the data windows. */
;;;83         for (w = 0; w < DEMO_POOL_WORDS; w++)
;;;84         {
;;;85             demo_pool[w] = DCI_DEMO_GUARD;
;;;86         }
;;;87     
;;;88         for (i = 0; i < count; i++)
;;;89         {
;;;90             demo_bufs.buf[i] = &demo_pool[i * stride + DEMO_GUARD_WORDS];
;;;91         }
;;;92         demo_bufs.bytes = data_words * 4;
;;;93         demo_bufs.count = count;
;;;94         demo_bufs.valid = true;
;;;95     
;;;96         DEMO_LOG("  pool: %u buffer(s) x %u B at %p, %u B guard fence",
;;;97                  count, demo_bufs.bytes, (void *)demo_bufs.buf[0], DEMO_GUARD_WORDS * 4);
;;;98         return true;
;;;99     }
;;;100    
;;;101    uint32_t *dci_demo_buf_get(uint8_t index)
;;;102    {
;;;103        return (demo_bufs.valid && index < demo_bufs.count) ? demo_bufs.buf[index] : NULL;
;;;104    }
;;;105    
;;;106    uint32_t dci_demo_buf_bytes(void)
;;;107    {
;;;108        return demo_bufs.valid ? demo_bufs.bytes : 0;
;;;109    }
;;;110    
;;;111    uint8_t dci_demo_buf_count(void)
;;;112    {
;;;113        return demo_bufs.valid ? demo_bufs.count : 0;
;;;114    }
;;;115    
;;;116    /*
;;;117     * Poison rather than zero: a buffer that still reads DCI_DEMO_POISON proves nothing
;;;118     * arrived, whereas a buffer of zeros is ambiguous - the sensor may legitimately have
;;;119     * sent black.
;;;120     */
;;;121    void dci_demo_buf_poison(void)
;;;122    {
;;;123        uint8_t  i;
;;;124        uint32_t w;
