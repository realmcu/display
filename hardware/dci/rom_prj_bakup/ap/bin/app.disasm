;;;309    static DCI_ERROR dci_validate(const DCI_InitTypeDef *init, const DCI_DMA_config *dma,
;;;310                                  const dci_crop_t *crop, dci_geom_t *g)
;;;311    {
;;;312        DCI_ERROR err;
