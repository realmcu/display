;;;522    {
;;;523        uint32_t en = DCI_INT_FRAME | DCI_INT_OVR | DCI_INT_ERR;
;;;524    
;;;525        if (dci.dma.vsync_event != NULL)
;;;526        {
;;;527            en |= DCI_INT_VSYNC;
;;;528        }
;;;529        if (dci.dma.line_event != NULL)
;;;530        {
;;;531            en |= DCI_INT_LINE;
;;;532        }
;;;533        DCI->IER = en;
;;;534    }
