;;;1853   
;;;1854   /*
;;;1855    * Walking-1 plus all-1 plus 0x5555.../0xAAAA... over the writable bits. Walking-1
;;;1856    * localises a single stuck bit; the alternating patterns catch shorts between
;;;1857    * adjacent bits, which a walking pattern alone can miss.
;;;1858    *
;;;1859    * `varied` is set when the register returned at least two different values, which
;;;1860    * is what tells a live block from a gated one - see dci_regtest_alive().
;;;1861    */
;;;1862   static void dci_regtest_one(const dci_reg_desc_t *d, DCI_regtest_item_t *it,
;;;1863                               bool *varied)
;;;1864   {
;;;1865       volatile uint32_t *reg = dci_reg_at(d->offset);
;;;1866       const uint32_t     pat[] = {0xFFFFFFFFUL, 0x55555555UL, 0xAAAAAAAAUL};
;;;1867       uint32_t           first_rb = 0;
;;;1868       bool               have_first = false;
