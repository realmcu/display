;;;223    /**
;;;224     * @brief Fill each I2C_InitStruct member with its default value.
;;;225     *
;;;226     * @param[in] I2C_InitStruct  Pointer to a I2C_InitTypeDef structure which will be initialized.
;;;227     */
;;;228    void I2C_StructInit(I2C_InitTypeDef *I2C_InitStruct)
;;;229    {
;;;230        /* I2C source clock is 40MHz, depending on clock divider */
;;;231        I2C_InitStruct->I2C_Clock             = 40000000;
;;;232        /* I2C SCK freqency is 400KHz */
;;;233        I2C_InitStruct->I2C_ClockSpeed        = 400000;
;;;234        /* Master mode */
;;;235        I2C_InitStruct->I2C_DeviceMode        = I2C_DEVICE_MODE_MASTER;
;;;236        /* 7-bit address mode */
;;;237        I2C_InitStruct->I2C_AddressMode       = I2C_ADDRESS_MODE_7BIT;
;;;238        /* Set slave address */
;;;239        I2C_InitStruct->I2C_SlaveAddress      = 0;
;;;240        /* Enable acknowledge in slave mode */
;;;241        I2C_InitStruct->I2C_Ack               = ENABLE;
;;;242        /* Tx fifo depth: 24 * 8bits */
;;;243        I2C_InitStruct->I2C_TxThresholdLevel  = 0;
;;;244        /* Rx fifo depth: 24 * 8bits */
;;;245        I2C_InitStruct->I2C_RxThresholdLevel  = 0;
;;;246        /* Disable dma */
;;;247        I2C_InitStruct->I2C_TxDMAEn           = DISABLE;
;;;248        I2C_InitStruct->I2C_RxDMAEn           = DISABLE;
;;;249        /* I2C Tx waterlevel, should be less than fifo threshold.
;;;250           The best value is I2C FIFO Depth - DMA Msize */
;;;251        I2C_InitStruct->I2C_TxWaterlevel      = 23;
;;;252        /* I2C Rx waterlevel, should be less than fifo threshold.
;;;253           The best value is DMA Msize */
;;;254        I2C_InitStruct->I2C_RxWaterlevel      = 1;
;;;255        /* Specify I2C scl rising time with 2.2K ohm pull up resistor, the unit is ns*/
;;;256        I2C_InitStruct->I2C_RisingTimeNs     = 50;
;;;257    
;;;258    }
