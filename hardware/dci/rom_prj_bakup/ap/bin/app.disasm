;;;442    
;;;443    /*
;;;444     * Writes every configuration field of CR with ENABLE and CAPTURE left at 0: the
;;;445     * register table requires configuration to be programmed before ENABLE is set.
;;;446     * CR.CM belongs to the capture session and is written by DCI_Capture_Start().
;;;447     */
;;;448    void DCI_Init(const DCI_InitTypeDef *init)
;;;449    {
