;;;772            dci.stats.suspend_count++;
;;;773            rtl_dci_unlock(s);
;;;774            return;             /* CAPTURE was already cleared before delivery */
;;;775        }
;;;776        rtl_dci_unlock(s);
;;;777    
;;;778        dci_arm(next);
;;;779    }
