;;;1797   /*============================================================================*
;;;1798    *                     Register Read/Write Self Test
;;;1799    *============================================================================*/
;;;1800   /*
;;;1801    * Bring-up aid: proves the register block is reachable and its bits behave, with
;;;1802    * no camera and no DMA involved. The failure it exists to catch is a clock that is
;;;1803    * still gated or a wrong base address, both of which otherwise show up much later
;;;1804    * as "capture produces nothing" and cost a lot of time to trace back.
;;;1805    *
;;;1806    * DR is excluded throughout: reading it pops the FIFO (DESIGN.md 13.1).
;;;1807    */
;;;1808   
;;;1809   /* Writable-bit masks, derived from the register table. Bits outside these are
;;;1810    * reserved or read-only and must read back 0.
;;;1811    *
;;;1812    * CR.capture (bit 0) is deliberately excluded: the register table marks it R/WAC,
;;;1813    * i.e. the hardware clears it on its own (in snapshot mode it self-clears at the
;;;1814    * end of a frame). A bit that may legitimately refuse to latch cannot be pattern
;;;1815    * tested - it would report a false stuck-0 on the very first bring-up step, which
;;;1816    * is worse than not covering it. Every capture test exercises it thoroughly. */
;;;1817   #define DCI_CR_RW_MASK      0x001F4FFEUL    /* [20:16] [14] [11:1], skip capture and
;;;1818                                                  rsvd 15 / 13:12 */
;;;1819   #define DCI_IER_RW_MASK     0x0000001FUL
;;;1820   #define DCI_ESCR_RW_MASK    0xFFFFFFFFUL
;;;1821   #define DCI_ESUR_RW_MASK    0xFFFFFFFFUL
;;;1822   #define DCI_CWSTRT_RW_MASK  0x1FFF3FFFUL    /* vst[28:16], hoffcnt[13:0] */
;;;1823   #define DCI_CWSIZE_RW_MASK  0x3FFF3FFFUL    /* vline[29:16], capcnt[13:0] */
;;;1824   
;;;1825   typedef struct
;;;1826   {
;;;1827       const char *name;
;;;1828       uint16_t    offset;
;;;1829       uint32_t    rw_mask;
;;;1830   } dci_reg_desc_t;
