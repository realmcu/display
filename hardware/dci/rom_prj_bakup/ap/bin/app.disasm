;;;946     *            - SPI_FLAG_BUSY: SPI busy flag. Set if it is actively transferring data. Reset if it is idle or disabled.
;;;947     *            - SPI_FLAG_WRAP_CS_EN: Wrap mode CS enable flag.
;;;948     *            - SPI_FLAG_WRAP_TFNF: Wrap mode transmit FIFO not full flag.
