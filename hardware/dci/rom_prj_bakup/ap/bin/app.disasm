;;;77                      (unsigned)((stride * count + DEMO_GUARD_WORDS) * 4),
;;;78                      count, (unsigned)bytes, (unsigned)(DCI_DEMO_POOL_KB * 1024UL));
;;;79             return false;
;;;80         }
;;;81     
;;;82         /* Guard everything first, then hand out the data windows. */
;;;83         for (w = 0; w < DEMO_POOL_WORDS; w++)
;;;84         {
;;;85             demo_pool[w] = DCI_DEMO_GUARD;
;;;86         }
