;;;160    /**
;;;161     * @brief Fills each IR_InitStruct member with its default value.
;;;162     *
;;;163     * @param[in] IR_InitStruct Pointer to an IR_InitTypeDef structure which will be initialized.
;;;164     */
;;;165    void IR_StructInit(IR_InitTypeDef *IR_InitStruct)
;;;166    {
;;;167        /* IR source clock is 40MHz */
;;;168        IR_InitStruct->IR_Clock             = IR_CLOCK_40M;
;;;169        /* IR carrier freqency is 38KHz */
;;;170        IR_InitStruct->IR_Freq              = 38000;
;;;171        IR_InitStruct->IR_DutyCycle         = 3;
;;;172        /* IR transmitting mode */
;;;173        IR_InitStruct->IR_Mode              = IR_MODE_TX;
;;;174        /* Tx pin output low when tx is idle */
;;;175        IR_InitStruct->IR_TxIdleLevel       = IR_IDLE_OUTPUT_LOW;
;;;176        /* Do not inverse tx data */
;;;177        IR_InitStruct->IR_TxInverse         = IR_TX_DATA_NORMAL;
;;;178        /* Configure RX FIFO threshold level to trigger IR_INT_RF_LEVEL interrupt */
;;;179        /* Tx fifo depth: 32 bytes */
;;;180        IR_InitStruct->IR_TxFIFOThrLevel    = 0;
;;;181        /* Rx auto start */
;;;182        IR_InitStruct->IR_RxStartMode       = IR_RX_AUTO_MODE;
;;;183        /* Rx fifo depth: 32 bytes */
;;;184        IR_InitStruct->IR_RxFIFOThrLevel    = 0;
;;;185        /* Discard the oldest received dta if RX FIFO is full */
;;;186        IR_InitStruct->IR_RxFIFOFullCtrl    = IR_RX_FIFO_FULL_DISCARD_NEWEST;
;;;187        /* Falling edge will trigger rx */
;;;188        IR_InitStruct->IR_RxTriggerMode     = IR_RX_FALL_EDGE;
;;;189        /* If high to low or low to high transition time <= 50ns,Filter out it. */
;;;190        IR_InitStruct->IR_RxFilterTime      = IR_RX_FILTER_TIME_50NS;
;;;191        /* Configure trigger type */
;;;192        IR_InitStruct->IR_RxCntThrType      = IR_RX_COUNT_LOW_LEVEL;
;;;193        /* Configure RX counter threshold.You can use it to decide to stop receiving IR data
;;;194           This value can be 0 to 0x7fffffff */
;;;195        IR_InitStruct->IR_RxCntThr          = 0x23a;
;;;196        /* Disable tx dma */
;;;197        IR_InitStruct->IR_TxDMAEn           = DISABLE;
;;;198        /* IR Tx waterlevel, should be less than fifo threshold.
;;;199           The best value is IR FIFO Depth - DMA Msize */
;;;200        IR_InitStruct->IR_TxWaterLevel      = 31;
;;;201        /* Disable rx dma */
;;;202        IR_InitStruct->IR_RxDMAEn           = DISABLE;
;;;203        /* IR Rx waterlevel, should be less than fifo threshold.
;;;204           The best value is DMA Msize */
;;;205        IR_InitStruct->IR_RxWaterLevel      = 1;
