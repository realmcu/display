;;;580    /*
;;;581     * One group of chunks_per_frame descriptors per buffer. CONTINUOUS links the
;;;582     * groups head to tail into a closed ring so the hardware switches buffers on its
;;;583     * own; SNAPSHOT leaves each group ending at LLP = 0 so the channel stops dead
;;;584     * and can be reloaded from a known state on the next Start().
;;;585     */
