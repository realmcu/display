;;;303    /*
;;;304     * Prints the build's configuration before running. That banner is the record of what
;;;305     * was actually flashed, which matters precisely because the selection is compile
;;;306     * time: log output from a previous build is otherwise indistinguishable.
;;;307     *
;;;308     * The full configuration record comes from dci_demo_cfg_print() rather than from a
;;;309     * second set of DEMO_LOG lines here - one printer, so what is printed cannot drift from
;;;310     * what is programmed.
;;;311     */
;;;312    static void dci_demo_banner(const dci_demo_cfg_t *c)
;;;313    {
;;;314        DEMO_LOG("");
;;;315        DEMO_LOG("================ DCI demo ================");
;;;316        DEMO_LOG(" case   : %d  %s%s", DCI_DEMO_CASE, DEMO_NAME,
;;;317                 DEMO_NEEDS_SIGNAL ? "   [needs a live camera]" : "   [no camera needed]");
;;;318        DEMO_LOG(" buffers: %d", DEMO_FORCE_BUF_COUNT);
;;;319        DEMO_LOG(" fill   : %s", (dci_demo_on_busy_cfg() == DCI_ON_BUSY_OVERWRITE)
;;;320                 ? "OVERWRITE - keeps writing into a held buffer, may tear"
;;;321                 : "GATE - stops rather than overwrite a held buffer");
;;;322        DEMO_LOG(" irq    : FRAME/OVR/ERR on (always), VSYNC %s, LINE %s, per-frame log %s",
;;;323                 DCI_DEMO_IRQ_VSYNC ? "on" : "off",
;;;324                 DCI_DEMO_IRQ_LINE  ? "on" : "off",
;;;325                 DCI_DEMO_IRQ_LOG   ? "on" : "off");
;;;326        /*
;;;327         * The settings that used to be separate cases. Printed unconditionally, including the
;;;328         * defaults, because the whole point of the banner is that a log from another build
;;;329         * looks identical otherwise - and these four now decide what the run actually does.
;;;330         */
;;;331    #if DEMO_CASE_IS_SNAPSHOT
;;;332        DEMO_LOG(" shots  : %d%s", DCI_DEMO_SHOTS,
;;;333                 (DCI_DEMO_SHOTS > 1) ? "  (rotation check: shot 1 held while 2 is taken)"
;;;334                 : "");
;;;335        DEMO_LOG(" capture: %s", (DCI_DEMO_NO_CAPTURE != 0)
;;;336                 ? "NO - configure and dump registers only"
;;;337                 : "yes - frame held on delivery, address printed for JLink");
;;;338    #elif DEMO_CASE_IS_CONTINUOUS
;;;339        DEMO_LOG(" frames : %d", DCI_DEMO_FRAMES);
;;;340    #if (DCI_DEMO_CAPTURE_FRAME != 0)
;;;341        DEMO_LOG(" hold   : frame %d, kept for a JLink dump", DCI_DEMO_CAPTURE_FRAME);
;;;342    #else
;;;343        DEMO_LOG(" hold   : no - every frame released, nothing static to dump");
;;;344    #endif
;;;345    #endif
;;;346        DEMO_LOG("==========================================");
;;;347    
;;;348        if (c != NULL)
;;;349        {
;;;350            DEMO_LOG("");
;;;351            dci_demo_cfg_print(c, DEMO_FORCE_BUF_COUNT);
;;;352        }
;;;353    }
;;;354    
;;;355    /*============================================================================*
;;;356     *                         Test environment
;;;357     *============================================================================*/
;;;358    /*
;;;359     * Board bring-up writes that are NOT part of the DCI driver, which is why they live
;;;360     * here and not in rtl_dci_int.c: the driver configures DCI, while this opens up the
;;;361     * environment DCI needs to exist in on this bring-up platform.
;;;362     *
;;;363     * Transcribed from the JLink sequence used to bring the part up by hand:
;;;364     *
;;;365     *     w4 0x40701080, 0xFFFFFFFF
;;;366     *     w4 0x40701084, 0xFFFFFFFF
;;;367     *     w4 0x40701088, 0xFFFFFFFF
;;;368     *     w4 0x4070108C, 0xFFFFFFFF
;;;369     *     w4 0x40701090, 0xFFFFFFFF
;;;370     *
;;;371     * Five consecutive 32-bit words, all ones. Kept as the literal addresses the JLink
;;;372     * script uses rather than being dressed up as named registers: no register table for
;;;373     * this block has been seen, so inventing names would assert more than is known. When
;;;374     * that table turns up, name them and say what the bits do.
;;;375     *
;;;376     * Idempotent and side-effect free as far as DCI is concerned, so it is safe to call
;;;377     * from every case, including the ones that never touch a pixel.
;;;378     */
;;;379    /*
;;;380     * Overridable so the host-side build can point it at plain RAM. On target it is the
;;;381     * literal address; nothing else should ever redefine it.
;;;382     */
;;;383    #ifndef DEMO_ENV_REG_FIRST
;;;384    #define DEMO_ENV_REG_FIRST      0x40701080UL
;;;385    #endif
;;;386    #define DEMO_ENV_REG_COUNT      5U
;;;387    
;;;388    void dci_demo_env_init(void)
;;;389    {
        0x000084b8:    e92d4ff8    -..O    PUSH     {r3-r11,lr}
        0x000084bc:    4d21        !M      LDR      r5,[pc,#132] ; [0x8544] = 0x40701080
        0x000084be:    a022        ".      ADR      r0,{pc}+0x8a ; 0x8548
        0x000084c0:    2305        .#      MOVS     r3,#5
        0x000084c2:    f1050210    ....    ADD      r2,r5,#0x10
        0x000084c6:    4629        )F      MOV      r1,r5
        0x000084c8:    f7fcfc50    ..P.    BL       log_direct ; 0x4d6c
        0x000084cc:    2000        .       MOVS     r0,#0
;;; ../../../../../display/hardware/dci/test\dci_demo.c
