;;;44     /*============================================================================*
;;;45      *                           Private Macros
;;;46      *============================================================================*/
;;;47     #define DCI_EVT_FRAME           BIT0        /* IT_FRAME arrived */
;;;48     #define DCI_EVT_BLOCK           BIT1        /* group-last block arrived */
;;;49     
;;;50     #define DCI_DIV_UP(a, b)        (((a) + (b) - 1) / (b))
;;;51     
;;;52     /*============================================================================*
;;;53      *                           Private Types
;;;54      *============================================================================*/
;;;55     /** Crop window in hardware units: pixel clocks horizontally, lines vertically. */
