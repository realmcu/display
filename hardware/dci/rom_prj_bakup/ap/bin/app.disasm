;;;924        {
;;;925            rtl_dci_unlock(s);
;;;926            return;
;;;927        }
;;;928        dci.evt = 0;
;;;929    
;;;930        k    = dci.cur_group;
;;;931        next = (uint8_t)((k + 1) % dci.dma.buf_count);
;;;932        dci.cur_group = next;
;;;933        rtl_dci_unlock(s);
