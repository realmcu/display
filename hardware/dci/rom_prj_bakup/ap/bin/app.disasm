;;;1745   /*
;;;1746    * The sensor does not move, so unlike a geometry change on the sensor side there
;;;1747    * is no settling period: the first frame after the restart is already valid.
;;;1748    */
;;;1749   DCI_ERROR DCI_ConfigCrop(uint16_t x0, uint16_t y0, uint16_t w, uint16_t h)
;;;1750   {
;;;1751       dci_crop_t c;
;;;1752   
;;;1753       if (dci.state == DCI_STATE_RESET)
;;;1754       {
