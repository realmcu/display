;;;44     {
;;;45         uint32_t *buf[DCI_MAX_BUF];
;;;46         uint32_t  bytes;            /* usable bytes per buffer */
;;;47         uint8_t   count;
;;;48         bool      valid;
;;;49     } demo_bufs;
;;;50     
;;;51     /*============================================================================*
;;;52      *                         Allocation
;;;53      *============================================================================*/
;;;54     /*
;;;55      * Layout per buffer: [guard][data][guard], with the trailing guard of one buffer
;;;56      * doubling as the leading guard of the next, so a run past the end of buffer 0 is
;;;57      * caught even though buffer 1 begins right after.
;;;58      */
