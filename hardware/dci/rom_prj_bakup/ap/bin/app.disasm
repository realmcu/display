;;;1671           }
;;;1672       }
;;;1673       if (dci.buf_lock_mask != 0)
;;;1674       {
;;;1675           return DCI_ERROR_BUSY;
;;;1676       }
;;;1677   
;;;1678       was_running = (dci.state == DCI_STATE_BUSY || dci.state == DCI_STATE_SUSPENDED);
;;;1679   
;;;1680       err = dci_capture_off(DCI_WAIT_CAPTURE_ITER);
;;;1681       if (err != DCI_SUCCESS)
;;;1682       {
