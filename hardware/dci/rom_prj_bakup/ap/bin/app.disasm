;;;57     {
;;;58         uint16_t x0;        /* CWSTRT.HOFFCNT */
;;;59         uint16_t y0;        /* CWSTRT.VST */
;;;60         uint16_t w;         /* pclk to capture, CWSIZE.CAPCNT = w - 1 */
;;;61         uint16_t h;         /* lines to capture, CWSIZE.VLINE = h - 1 */
;;;62     } dci_crop_t;
;;;63     
;;;64     /** Everything derived from init + crop + buf_bytes. Recomputed on every reconfig. */
;;;65     typedef struct
;;;66     {
;;;67         uint32_t frame_bytes;       /* 0 for JPEG: the length is only known per frame */
;;;68         uint32_t frame_words;
;;;69         uint32_t line_bytes;
;;;70         uint32_t line_words;        /* valid only when line_aligned */
;;;71         uint32_t chunk_words;       /* full chunk; the last one may be shorter */
;;;72         uint16_t lines_out;
;;;73         uint16_t lines_per_chunk;   /* 0 when not line aligned */
;;;74         uint8_t  chunks_per_frame;
;;;75         uint8_t  desc_count;
