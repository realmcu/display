;    }

;}

LOAD_ITCM0 LOAD_ROM_ADDRESS LOAD_ROM_SIZE
{   

    app.bin LOAD_ROM_ADDRESS
    {
        * (.vectors_table,+First)
;        * (RESET)
        * (InRoot$$Sections)
	}	
	
;    OS  +0
;    {
;        startup_rtl8762c.o
;        system_rtl8762c.o
;        rtl8762c_platform.o
;        croutine.o
;        event_groups.o
;        list.o
;        queue.o
;        tasks.o
;        timers.o
;        port.o
;    }
    
    RAM_RO +0 ALIGN 4
    {
        .ANY (+RO)   
    }

	RAM_VECTOR_TABLE RW_SECTION_ADR ALIGN 128
	{
		* (.bss.ram_vector_table)
	}
	
	RW_SECTION +0
	{
		* (+RW)
        * (+ZI)
	}
	ScatterAssert((ImageLength(RAM_VECTOR_TABLE) + ImageLength(RW_SECTION)) < RW_SECTION_SIZE)

    ; DCI test framebuffer pool. Its own execution region on purpose: left inside
    ; RW_SECTION the ScatterAssert above rejects it, since one 160x120 RGB565 frame is
    ; 38432 B against a 10 KB budget. Sits between RW_SECTION and the heap, which starts
    ; after it because DATA_HEAP_ADDR is derived from DCI_POOL_ADDR + DCI_POOL_SIZE.
    DCI_POOL DCI_POOL_ADDR DCI_POOL_SIZE
    {
        * (.dci_pool)
    }

    SHARE_PLATFORM_RAM_DATA SHARE_PLATFORM_RAM_DATA_ADDR SHARE_PLATFORM_RAM_DATA_SIZE
    {
        * (.share_platform_ram.data)
    }

    ARM_LIB_HEAP Heap_Addr EMPTY Heap_Size
    {    ; Heap region growing up
    }

    ARM_LIB_STACK Stack_Addr + Stack_Size EMPTY -Stack_Size 
    { ; Stack region growing down
    }

	RAM_TEXT CODE_RAM_TEXT_ADDR CODE_RAM_TEXT_SIZE
    {
        * (.ram_text)
    }
	
}

