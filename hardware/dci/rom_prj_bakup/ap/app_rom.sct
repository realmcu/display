#define RW_SECTION_SIZE   DATA_RAM_VECTOR_TABLE_SIZE
#define RW_SECTION_ADR    DATA_RAM_VECTOR_TABLE_ADDR

#define LOAD_ROM_ADDRESS                  BOOT_ROM_ADDRESS
#define LOAD_ROM_SIZE                     BOOT_ROM_SIZE

#define SHARE_PLATFORM_RAM_DATA_ADDR    SHARED_SRAM_BASE
#define SHARE_PLATFORM_RAM_DATA_SIZE    (32 * 1024)

#define Stack_Size                   CODE_RAM_MAIN_STACK_SIZE

#define Stack_Addr                   CODE_RAM_MAIN_STACK_START_ADDR

#define Heap_Size                    DATA_HEAP_SIZE

#define Heap_Addr                    DATA_HEAP_ADDR

