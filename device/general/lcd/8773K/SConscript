

from building import *

cwd = GetCurrentDir()

# add the general drivers.
src = Split("""
""")

if GetDepend(['CONFIG_REALTEK_LCD_SH8601Z_410_502_QSPI']):
    src += ['lcd_sh8601z_410_502_qspi.c']
if GetDepend(['CONFIG_REALTEK_LCD_SH8601Z_454454_QSPI']):
    src += ['SH8601Z_368448_qspi.c']
if GetDepend(['CONFIG_REALTEK_LCD_SH8601A_454454_QSPI']):
    src += ['SH8601A_454454_qspi.c']
if GetDepend(['CONFIG_REALTEK_LCD_SH8601A_454454_MIPI_CMD']):
    src += ['SH8601A_454454_mipi_cmd.c']
if GetDepend(['CONFIG_REALTEK_LCD_SH8601A_454454_MIPI_VIDEO']):
    src += ['SH8601A_454454_mipi_video.c']

CPPPATH = [cwd]

group = DefineGroup('lcd_low_driver', src, depend = [''], CPPPATH = CPPPATH)
# print(src)
# print(group)

Return('group')